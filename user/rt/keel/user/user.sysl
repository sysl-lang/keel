module keel.user

// A user program's runtime on keel.
//
// The kernel enters a program at `_start`, at EL0, with SP_EL0 pointing at its arguments (keel.abi has
// the layout: argc, then argv) and every other register zero. `_start` calls the program with C's pair
// — sysl's `main`, which fills the module storage and then either runs the entry file's statements or,
// for a `main(args: []string)`, turns the pair into the slice and calls it — and ends the process with
// whatever `main` answered.

import abi.keel.abi.{ANY_CHILD, EACCES, EINVAL, ENOENT, EPERM, Errno, ExitStatus, NO_FD, STDOUT, SYS_BRK, SYS_CLOSE, SYS_EXIT, SYS_FSTAT,
    SYS_GETDENTS, SYS_GETPID, SYS_GETPPID, SYS_LSEEK, SYS_MKDIR, SYS_OPEN, SYS_READ, SYS_RENAME, SYS_RMDIR, SYS_SPAWN,
    SYS_STAT, SYS_SYNC, SYS_UNLINK, SYS_WAIT, SYS_WRITE, Stat, SYS_SOCKET, SYS_BIND, SYS_RECVFROM, SYS_SENDTO,
    SYS_SOCKCLOSE, SockAddr, SYS_PIPE, SYS_DUP2, SYS_DUP,
    SpawnAttr, SYS_FORK, EINTR, ESRCH, ProcInfo, SPAWN_FOREGROUND, SPAWN_SETPGROUP, SigAction,
    SYS_GETPGID, SYS_KILL, SYS_NANOSLEEP, SYS_PROCS, SYS_SETPGID, SYS_SIGACTION, SYS_SIGPROCMASK, SYS_TCGETPGRP,
    SYS_TCSETPGRP, WNOHANG}
import sysl.buf.{Buf, buf}
import sysl.slices.{as_mut_ptr, as_ptr}

@section(".text.start")
asm
    [aarch64]
        ".globl _start"
        "_start:"
        "ldr x0, [sp]"
        "add x1, sp, #8"
        "bl keel_user_start"
        "brk #0"
    [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// The program, as the compiler builds it: C's `main`. The manifest's entry is `_start`, so `main` is
// an ordinary symbol this runtime calls.
extern "main" program_main(argc: int, argv: **u8) -> int

// Where `_start` goes with the arguments: the environment's vector follows argv's zero, so `environ`
// is set to it; then the program runs, and what it answered ends the process.
@export("keel_user_start")
start(argc: int, argv: **u8) -> never
    environ = ptr_cast(usize(argv) + (usize(argc) + 1) * 8)
    exit(program_main(argc, argv))

// The environment, as C keeps it: a zero-ended vector of `NAME=value` strings — the one the kernel laid
// on the stack. `sysl.env` reads it through keel.fsys's hooks, which ask `env_entry` here. It is a word
// of `.data` rather than module storage because `keel_user_start` sets it before `main` runs, and
// `main` is what fills module storage.
@section(".data")
asm
    [aarch64]
        ".globl environ"
        ".p2align 3"
        "environ:"
        ".quad 0"
    [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

extern environ: **u8

// Entry `i` of this process's environment, `NAME=value` as bytes, or None past the last.
env_entry(i: usize) -> Option[[]const u8]
    for k in 0..<i + 1
        if environ[k] == null then return None
    val e = environ[i]
    var n: usize = 0
    while e[n] != 0
        n += 1
    Some(e[0..<n])

// This process's environment entries, `NAME=value` each, as bytes (keel.fsys builds a child's from it).
environment() -> Buf[[]const u8]
    var out: Buf[[]const u8] = buf()
    var i: usize = 0
    loop
        env_entry(i) match
            Some(e) -> out.push(e)
            None -> return out
        i += 1

// The system calls, one `svc` each. The kernel preserves every register but x0.

write(fd: u64, buf: *u8, len: u64) -> i64
    val nr = SYS_WRITE
    var r: i64 = 0
    asm
        [aarch64]
            "svc #0"
            in nr : "x8"
            in fd : "x0"
            in buf : "x1"
            in len : "x2"
            out r : "x0"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    r

getpid() -> u64
    val nr = SYS_GETPID
    var r: u64 = 0
    asm
        [aarch64]
            "svc #0"
            in nr : "x8"
            out r : "x0"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    r

brk(addr: u64) -> u64
    val nr = SYS_BRK
    var r: u64 = 0
    asm
        [aarch64]
            "svc #0"
            in nr : "x8"
            in addr : "x0"
            out r : "x0"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    r

sys_exit(code: u64) -> never
    val nr = SYS_EXIT
    asm
        [aarch64]
            "svc #0"
            in nr : "x8"
            in code : "x0"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    loop
        asm
            [aarch64] "brk #1"
            [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// --- Files ---------------------------------------------------------------------------------------
//
// Every call below answers a `Result`: the kernel's negative answer is the error's number.

// A system call of up to four arguments.
private call(nr: u64, a0: u64, a1: u64, a2: u64, a3: u64) -> i64
    var r: i64 = 0
    asm
        [aarch64]
            "svc #0"
            in nr : "x8"
            in a0 : "x0"
            in a1 : "x1"
            in a2 : "x2"
            in a3 : "x3"
            out r : "x0"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    r

private answer(r: i64) -> Result[u64, Errno] = if r < 0 then Err(Errno(-r)) else Ok(u64(r))

private done(r: i64) -> Result[unit, Errno] = if r < 0 then Err(Errno(-r)) else Ok(())

private addr(b: []const u8) -> u64 = u64(usize(as_ptr(b)))

private len(b: []const u8) -> u64 = u64(b.len)

open(path: string, flags: u64) -> Result[u64, Errno] = answer(call(SYS_OPEN, addr(path.bytes), len(path.bytes), flags, 0))

read(fd: u64, into: []u8) -> Result[u64, Errno] = answer(call(SYS_READ, fd, u64(usize(as_mut_ptr(into))), u64(into.len), 0))

// `write` to a file: how many bytes went, or why none did.
write_file(fd: u64, bytes: []const u8) -> Result[u64, Errno] = answer(call(SYS_WRITE, fd, addr(bytes), len(bytes), 0))

close(fd: u64) -> Result[unit, Errno] = done(call(SYS_CLOSE, fd, 0, 0, 0))

lseek(fd: u64, offset: i64, whence: u64) -> Result[u64, Errno] = answer(call(SYS_LSEEK, fd, u64(offset), whence, 0))

fstat(fd: u64) -> Result[Stat, Errno]
    var s = Stat(0, 0, 0, 0, 0, 0, 0)
    done(call(SYS_FSTAT, fd, u64(usize(&s)), 0, 0))?
    Ok(s)

stat(path: string) -> Result[Stat, Errno]
    var s = Stat(0, 0, 0, 0, 0, 0, 0)
    done(call(SYS_STAT, addr(path.bytes), len(path.bytes), u64(usize(&s)), 0))?
    Ok(s)

mkdir(path: string) -> Result[unit, Errno] = done(call(SYS_MKDIR, addr(path.bytes), len(path.bytes), 0, 0))

// As many whole directory entries (keel.abi's `Dirent`) as fit in `into`; 0 bytes at the end.
getdents(fd: u64, into: []u8) -> Result[u64, Errno] =
    answer(call(SYS_GETDENTS, fd, u64(usize(as_mut_ptr(into))), u64(into.len), 0))

unlink(path: string) -> Result[unit, Errno] = done(call(SYS_UNLINK, addr(path.bytes), len(path.bytes), 0, 0))

rmdir(path: string) -> Result[unit, Errno] = done(call(SYS_RMDIR, addr(path.bytes), len(path.bytes), 0, 0))

rename(from: string, to: string) -> Result[unit, Errno] =
    done(call(SYS_RENAME, addr(from.bytes), len(from.bytes), addr(to.bytes), len(to.bytes)))

sync() -> Result[unit, Errno] = done(call(SYS_SYNC, 0, 0, 0, 0))

// --- Processes -----------------------------------------------------------------------------------

// A system call of five arguments: `spawn` is the one that needs the fifth.
private call5(nr: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> i64
    var r: i64 = 0
    asm
        [aarch64]
            "svc #0"
            in nr : "x8"
            in a0 : "x0"
            in a1 : "x1"
            in a2 : "x2"
            in a3 : "x3"
            in a4 : "x4"
            out r : "x0"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    r

// Start the executable at `path` as a child, with `args` as its argv (its name first, by convention),
// in this process's current directory. `stdin`, `stdout` and `stderr` are descriptors of this process
// to stand as the child's 0, 1 and 2, NO_FD for this process's own. `env` is the child's whole
// environment (`NAME=value` entries), or None for this process's. Answers the child's pid.
//
// `group` puts the child in a process group other than this process's: NEW_GROUP for one of its own
// (numbered by its pid), or an existing group's number; SAME_GROUP leaves it in this one. With
// `foreground` the child's group becomes the console's foreground group before it runs.
spawn(path: string, args: []const string, stdin: u64 = NO_FD, stdout: u64 = NO_FD, stderr: u64 = NO_FD,
        env: Option[[]const string] = None, group: u64 = SAME_GROUP, foreground: bool = false) -> Result[u64, Errno]
    var packed: Buf[u8] = buf()
    for a in args
        packed.extend(a.bytes)
        packed.push(0)
    val bytes = packed.view()
    var block: Buf[u8] = buf()
    var flags: u64 = if foreground then SPAWN_FOREGROUND else 0
    if group != SAME_GROUP then flags |= SPAWN_SETPGROUP
    var attr = SpawnAttr([stdin, stdout, stderr], 0, 0, 0, flags, if group == NEW_GROUP then 0 else group)
    env match
        Some(entries) ->
            for e in entries
                block.extend(e.bytes)
                block.push(0)
            attr.env = addr(block.view())
            attr.env_len = u64(block.len())
            attr.env_given = 1
        None -> ()
    answer(call5(SYS_SPAWN, addr(path.bytes), len(path.bytes), addr(bytes), len(bytes), u64(usize(&attr))))

// A pipe: its read end's descriptor, then its write end's.
pipe() -> Result[(u64, u64), Errno]
    var fds: [2]u32 = [0, 0]
    done(call(SYS_PIPE, u64(usize(&fds[0])), 0, 0, 0))?
    Ok((u64(fds[0]), u64(fds[1])))

// Make descriptor `new` stand for what `old` does, closing what `new` held first.
dup2(old: u64, new: u64) -> Result[u64, Errno] = answer(call(SYS_DUP2, old, new, 0, 0))

// A second descriptor, the lowest free one, standing for what `old` does.
dup(old: u64) -> Result[u64, Errno] = answer(call(SYS_DUP, old, 0, 0, 0))

// The process group `spawn` puts a child in: this process's own, or a new one.
const SAME_GROUP: u64 = 0
const NEW_GROUP: u64 = 0xffff_ffff_ffff_ffff

// Wait for a child to end — `pid`, or any one for ANY_CHILD — and answer which, and how.
wait(pid: i64 = ANY_CHILD) -> Result[(u64, ExitStatus), Errno]
    var s = ExitStatus(0, 0)
    val child = answer(call(SYS_WAIT, u64(pid), u64(usize(&s)), 0, 0))?
    Ok((child, s))

// The same without waiting: None while the child (or every child, for ANY_CHILD) is still running.
poll(pid: i64 = ANY_CHILD) -> Result[Option[(u64, ExitStatus)], Errno]
    var s = ExitStatus(0, 0)
    val child = answer(call(SYS_WAIT, u64(pid), u64(usize(&s)), WNOHANG, 0))?
    if child == 0 then return Ok(None)
    Ok(Some((child, s)))

getppid() -> u64 = u64(call(SYS_GETPPID, 0, 0, 0, 0))

// Copy this process: answers the child's pid in the parent and 0 in the child, which carries on from
// the same call with a copy-on-write copy of the parent's memory, its descriptors, directory and
// environment. The standard library has `exec` but deliberately no `fork`, which belongs to a runtime
// that owns every thread and every count there is — this one.
fork() -> Result[u64, Errno] = answer(call(SYS_FORK, 0, 0, 0, 0))

// A system call of six arguments: `execve` and `sigaction` need the sixth.
private call6(nr: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64
    var r: i64 = 0
    asm
        [aarch64]
            "svc #0"
            in nr : "x8"
            in a0 : "x0"
            in a1 : "x1"
            in a2 : "x2"
            in a3 : "x3"
            in a4 : "x4"
            in a5 : "x5"
            out r : "x0"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    r

// An error number in words, for the messages a program prints about keel's own calls.
describe(e: Errno) -> string = e match
    EPERM -> "operation not permitted"
    ESRCH -> "no such process"
    EINTR -> "interrupted"
    EACCES -> "permission denied"
    ENOENT -> "no such file or directory"
    EINVAL -> "invalid argument"
    else s"error ${i64(e)}"

// --- Signals and process groups --------------------------------------------------------------------
//
// keel.abi's signal calls. `sysl.signal` (signals as counted flags) and `sysl.process`'s groups and
// foreground reach them through keel.fsys's hooks; a program that wants a handler of its own, a mask or
// `setpgid` calls these directly.
//
// The restorer every handler returns to: it makes `sigreturn`, which puts back the registers the
// signal interrupted (keel.abi's `SigFrame`). Linux's `sa_restorer`, kept in the runtime rather than
// the kernel, so the kernel never writes code into a process.
asm
    [aarch64]
        ".globl keel_sigreturn_trampoline"
        "keel_sigreturn_trampoline:"
        "mov x8, #43"
        "svc #0"
        "brk #2"
    [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

extern keel_sigreturn_trampoline: u8

// Set `sig`'s action — SIG_DFL, SIG_IGN, or the address of a handler `(sig: u64)`, which runs with
// `mask` blocked as well as `sig` — and answer the action it replaces. `flags` is SA_RESTART or 0.
sigaction(sig: u64, handler: u64, mask: u64 = 0, flags: u64 = 0) -> Result[SigAction, Errno]
    var old = SigAction(0, 0, 0, 0)
    val restorer = u64(usize(&keel_sigreturn_trampoline))
    done(call6(SYS_SIGACTION, sig, handler, mask, restorer, u64(usize(&old)), flags))?
    Ok(old)

// Put back an action `sigaction` answered, exactly as it was.
restore_action(sig: u64, a: SigAction) -> Result[unit, Errno] =
    done(call6(SYS_SIGACTION, sig, a.handler, a.mask, a.restorer, 0, a.flags))

// Change the blocked set (`how`: SIG_BLOCK, SIG_UNBLOCK, SIG_SETMASK) and answer what it was.
sigprocmask(how: u64, set: u64) -> Result[u64, Errno]
    var old: u64 = 0
    done(call(SYS_SIGPROCMASK, how, set, u64(usize(&old)), 0))?
    Ok(old)

// Send `sig` to process `pid`, to the caller's group for 0, to group `g` for -g.
kill(pid: i64, sig: u64) -> Result[unit, Errno] = done(call(SYS_KILL, u64(pid), sig, 0, 0))

setpgid(pid: u64, pgid: u64) -> Result[unit, Errno] = done(call(SYS_SETPGID, pid, pgid, 0, 0))

getpgid(pid: u64 = 0) -> Result[u64, Errno] = answer(call(SYS_GETPGID, pid, 0, 0, 0))

// The console's foreground process group, which Ctrl-C signals; `fd` must be the console.
tcsetpgrp(fd: u64, pgid: u64) -> Result[unit, Errno] = done(call(SYS_TCSETPGRP, fd, pgid, 0, 0))

tcgetpgrp(fd: u64) -> Result[u64, Errno] = answer(call(SYS_TCGETPGRP, fd, 0, 0, 0))

// Sleep `nanos` nanoseconds (the kernel's tick is 10 ms). Err(EINTR) and what was left if a signal
// ended it first.
nanosleep(nanos: u64) -> Result[unit, (Errno, u64)]
    var left: u64 = 0
    val r = call(SYS_NANOSLEEP, nanos, u64(usize(&left)), 0, 0)
    if r < 0 then return Err((Errno(-r), left))
    Ok(())

// Every process in the kernel's table.
procs() -> Result[Buf[ProcInfo], Errno]
    var room: [64]ProcInfo = [ProcInfo(0, 0, 0, 0, 0, [0; 16]); 64]
    val n = answer(call(SYS_PROCS, u64(usize(&room[0])), 64, 0, 0))?
    var out: Buf[ProcInfo] = buf()
    for i in 0..<usize(n)
        out.push(room[i])
    Ok(out)

// --- UDP sockets -----------------------------------------------------------------------------------
//
// keel.abi's socket calls, as they are: a socket is a number, an address a `SockAddr`. A program
// written with `sysl.net` reaches them through keel.fsys's hooks instead.

socket() -> Result[u64, Errno] = answer(call(SYS_SOCKET, 0, 0, 0, 0))

bind(sd: u64, port: u16) -> Result[unit, Errno] = done(call(SYS_BIND, sd, u64(port), 0, 0))

// The oldest datagram for `sd`, cut to fit `into`: its length and its sender. Waits up to `timeout_ms`
// (0: for ever), then ETIMEDOUT.
recvfrom(sd: u64, into: []u8, timeout_ms: u64) -> Result[(u64, SockAddr), Errno]
    var from = SockAddr(0, 0, 0)
    val n = answer(call5(SYS_RECVFROM, sd, u64(usize(as_mut_ptr(into))), u64(into.len), u64(usize(&from)),
        timeout_ms))?
    Ok((n, from))

sendto(sd: u64, bytes: []const u8, to: SockAddr) -> Result[u64, Errno] =
    answer(call(SYS_SENDTO, sd, addr(bytes), len(bytes), u64(usize(&to))))

sockclose(sd: u64) -> Result[unit, Errno] = done(call(SYS_SOCKCLOSE, sd, 0, 0, 0))

// A system call of up to four arguments, its answer exactly as the kernel gave it: the result, or a
// negative error number. For a caller that turns the number into something of its own (keel.fsys
// turns it into an `IoError`'s code).
syscall(nr: u64, a0: u64, a1: u64, a2: u64, a3: u64) -> i64 = call(nr, a0, a1, a2, a3)

// The same for a call of five arguments (spawn).
syscall5(nr: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> i64 = call5(nr, a0, a1, a2, a3, a4)

// The same for a call of six arguments (execve, which keel.fsys's `exec` hook makes).
syscall6(nr: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64 = call6(nr, a0, a1, a2, a3, a4, a5)

// Write a string to standard output, all of it unless the kernel refuses.
put(s: string) -> i64 = write_bytes(STDOUT, s.bytes)

// `write` over a byte view.
write_bytes(fd: u64, bytes: []const u8) -> i64 = write(fd, as_ptr(bytes), u64(bytes.len))

// The standard library's `print` writes through C's `putchar`. A system call per byte would be slow,
// so bytes collect in a line and go to the kernel at a newline or when the line is full.
private const LINE: usize = 256
private var line: [LINE]u8
private var used: usize = 0

@export("putchar")
putchar(c: int) -> int
    line[used] = u8(c & 0xff)
    used += 1
    if c == 10 || used == LINE then flush()
    c

// Hand whatever `print` has collected to the kernel.
flush()
    if used == 0 then return
    val _ = write(STDOUT, &line[0], u64(used))
    used = 0

// The standard library's `exit`, which `panic` and a failed `unwrap` end in, and where `_start` ends.
@export("exit")
exit(code: int) -> never
    flush()
    sys_exit(u64(code))

// The heap: blocks carved from the region `brk` grows, each with a 16-byte header holding its size,
// and a free list searched first fit. Freed blocks are reused, never returned to the kernel.
private struct Header
    size: usize                 // the whole block, header included
    next: *Header               // the next free block, while this one is free

private const HEADER: usize = 16
@assert(sizeof(Header) == 16, "a block header is 16 bytes, so the bytes after it stay 16-aligned")

private var free_list: *Header = null
private var heap_end: u64 = 0

@export("keel_user_alloc")
alloc(n: usize) -> *u8
    val need = (n + HEADER + 15) & ~usize(15)
    var prev: *Header = null
    var h = free_list
    while h != null
        if h.size >= need
            if prev == null then free_list = h.next else prev.next = h.next
            return ptr_cast(usize(h) + HEADER)
        prev = h
        h = h.next
    if heap_end == 0 then heap_end = brk(0)
    val start = heap_end
    val want = start + u64(need)
    if brk(want) != want then return null
    heap_end = want
    val b: *Header = ptr_cast(usize(start))
    b.size = need
    b.next = null
    ptr_cast(usize(start) + HEADER)

@export("keel_user_free")
free(p: *u8)
    if p == null then return
    val h: *Header = ptr_cast(usize(p) - HEADER)
    h.next = free_list
    free_list = h
