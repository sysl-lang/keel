// rm [-r] <path>...: each file removed; with `-r`, each path and everything under it, through
// `sysl.fs.remove_dir_all`. Exits 1 if any could not be.
//
// `rmdir` removes an empty directory.

import rt.keel.user
import sysl.fs

main(args: []string)
    val tree = args.len > 1 && args[1] == "-r"
    val first: usize = if tree then 2 else 1
    if args.len <= first
        print("usage: rm [-r] <path>...")
        exit(2)
    var failed = false
    for file in args[first..]
        val done = if tree then fs.remove_dir_all(file) else fs.remove_file(file)
        done match
            Ok(_) -> ()
            Err(e) ->
                print(s"rm: $file: $e")
                failed = true
    if failed then exit(1)
