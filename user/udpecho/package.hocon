// `udpecho`: a UDP echo server, written with `sysl.net`.

package {
  name    = "udpecho"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"

    // keel is not POSIX to the compiler: a sysl.posix module is refused at compile time, not at the link.
    capabilities {
      posix = false
    }
  }
}
