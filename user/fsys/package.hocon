// What the standard library asks of the system under it — the hooks of `sysl.fs.sys`, `sysl.io.sys`,
// `sysl.process.sys`, `sysl.signal.sys`, `sysl.net.sys` and `sysl.env.sys` — answered over keel's system calls. A
// program that uses any of those modules depends on this.

package {
  name    = "fsys"
  version = "0.0.1"
}

dependencies {
  abi { workspace = true }
  rt { workspace = true }
}
