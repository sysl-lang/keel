module keel.fsys

// The standard library on keel: the twenty-six hooks `sysl.fs.sys` declares, the three of
// `sysl.io.sys` and eleven of `sysl.process.sys` here, `sysl.signal.sys`'s in signal.sysl,
// `sysl.net.sys`'s in net.sysl and `sysl.env.sys`'s in env.sysl — each `@export`ed under the name the standard library calls and
// answered with keel's system calls (keel.abi).
//
// Every hook answers as a system call does — zero or more for success, the code of the `IoError` the
// call failed with negated for an error — and `status` is the one place a kernel's error number becomes
// such a code. A path arrives from sysl.fs as a pointer and a length and goes to keel's calls, which are
// Linux's, NUL-terminated: copied into a bounded buffer first (`c_path`), ENAMETOOLONG past it. A
// descriptor crosses as it is. What keel has no call for (links, a temporary directory) answers
// `sysl.sys.UNSUPPORTED`, which `sysl.fs` reports as "not supported on this target".

import abi.keel.abi.{AT_FDCWD, AT_REMOVEDIR, DIRENT64_NAME, EACCES, EBADF, EEXIST, EINTR, EISDIR, EMFILE, ENAMETOOLONG,
    ENOENT, ENOSPC, ENOSYS, ENOTDIR, ENOTEMPTY, EPERM, Errno, ExitStatus, NO_FD, O_APPEND, O_CREAT, O_DIRECTORY,
    O_RDONLY, O_RDWR, O_TRUNC, O_WRONLY, PATH_ROOM, SPAWN_FOREGROUND, SPAWN_SETPGROUP, SYS_CHDIR, SYS_CLOSE,
    SYS_EXECVE, SYS_FACCESSAT, SYS_FCHMODAT, SYS_FCHOWNAT, SYS_FSTAT, SYS_FTRUNCATE, SYS_GETCWD, SYS_GETDENTS64,
    SYS_GETGID, SYS_GETPGID, SYS_GETUID, SYS_IOCTL, SYS_KILL, SYS_LSEEK, SYS_MKDIRAT, SYS_NEWFSTATAT, SYS_OPENAT,
    SYS_PIPE2, SYS_READ, SYS_RENAMEAT, SYS_SETGID, SYS_SETPGID, SYS_SETSID, SYS_SETUID, SYS_SPAWN, SYS_TRUNCATE,
    SYS_UNLINKAT, SYS_WAIT4, SYS_WRITE, SpawnAttr, Stat, TIOCGPGRP, TIOCSPGRP, WNOHANG, empty_stat}
import rt.keel.user.{environment, flush, syscall, syscall5, syscall6}
import sysl.buf.{Buf, buf}
import sysl.fs.IoError
import sysl.fs.sys as fsys
import sysl.process.sys as psys
import sysl.slices.as_ptr
import sysl.sys.UNSUPPORTED

// --- Errors ----------------------------------------------------------------------------------------

// A system call's answer as a hook's status: 0 for a result, or the `IoError` code of the error,
// negated. keel's numbers are Linux's, which `IoError`'s named cases were recognised from, but the table
// is written out rather than passed through — `IoError`'s own reading of a number is the target's, and
// ENOTEMPTY is 66 on a BSD — so a number the cases do not name goes over as `Other`, and ENOSYS, a call
// this kernel does not have, is "unsupported", which is what it means to a program.
private[fsys] status(r: i64) -> int
    if r >= 0 then return 0
    Errno.try(-r) match
        Some(e) -> code_of(e)
        None -> -IoError.Other(int(-r)).code()

private code_of(e: Errno) -> int = e match
    ENOENT -> -IoError.NotFound.code()
    EEXIST -> -IoError.AlreadyExists.code()
    ENOTDIR -> -IoError.NotADirectory.code()
    EISDIR -> -IoError.IsADirectory.code()
    ENOTEMPTY -> -IoError.DirectoryNotEmpty.code()
    EMFILE -> -IoError.TooManyOpenFiles.code()
    ENOSPC -> -IoError.NoSpaceLeft.code()
    EBADF -> -IoError.NotOpen.code()
    EACCES -> -IoError.PermissionDenied.code()
    EPERM -> -IoError.NotPermitted.code()
    EINTR -> -IoError.Interrupted.code()
    ENOSYS -> UNSUPPORTED
    else -IoError.Other(int(i64(e))).code()

// --- Descriptors -----------------------------------------------------------------------------------

private addr(p: *u8) -> u64 = u64(usize(p))

// A path as keel's calls take it: the bytes and a NUL, in a buffer of PATH_ROOM.
private struct CPath
    bytes: [PATH_ROOM]u8

    at(*self) -> u64 = u64(usize(&self.bytes[0]))
end CPath

// `len` bytes at `path` with a NUL after them; None when they do not fit (TOO_LONG is the hook's answer).
private c_path(path: *u8, len: usize) -> Option[CPath]
    if u64(len) >= PATH_ROOM then return None
    var c = CPath([0; PATH_ROOM])
    for i in 0..<len
        c.bytes[i] = path[i]
    Some(c)

private too_long() -> int = status(-i64(ENAMETOOLONG))

private const CWD: u64 = u64(AT_FDCWD)

// `sysl.fs`'s `open_*` bits as keel's (Linux's) `O_*` flags.
private open_flags(flags: u32) -> u64
    val read = (flags & fsys.open_read) != 0
    val write = (flags & fsys.open_write) != 0
    var o = if read && write then O_RDWR elif write then O_WRONLY else O_RDONLY
    if (flags & fsys.open_create) != 0 then o = o | O_CREAT
    if (flags & fsys.open_truncate) != 0 then o = o | O_TRUNC
    if (flags & fsys.open_append) != 0 then o = o | O_APPEND
    o

@export("sysl_fs_open")
open(path: *u8, len: usize, flags: u32, mode: u32, fd: *int) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    val r = syscall(SYS_OPENAT, CWD, c.at(), open_flags(flags), u64(mode))
    if r >= 0 then *fd = int(r)
    status(r)

@export("sysl_fs_read")
read(fd: int, into: *u8, room: usize, got: *usize) -> int
    val r = syscall(SYS_READ, u64(fd), addr(into), u64(room), 0)
    if r >= 0 then *got = usize(r)
    status(r)

@export("sysl_fs_write")
write(fd: int, from: *u8, len: usize, put: *usize) -> int
    val r = syscall(SYS_WRITE, u64(fd), addr(from), u64(len), 0)
    if r >= 0 then *put = usize(r)
    status(r)

@export("sysl_fs_close")
close(fd: int) -> int = status(syscall(SYS_CLOSE, u64(fd), 0, 0, 0))

// `seek_*` are POSIX's 0, 1 and 2, and so are keel's SEEK_*.
@export("sysl_fs_seek")
seek(fd: int, offset: long, whence: int, at: *long) -> int
    val r = syscall(SYS_LSEEK, u64(fd), u64(offset), u64(whence), 0)
    if r >= 0 then *at = long(r)
    status(r)

@export("sysl_fs_fstat")
fstat(fd: int, out: *fsys.Stat) -> int
    var s = empty_stat()
    val r = syscall(SYS_FSTAT, u64(fd), u64(usize(&s)), 0, 0)
    if r >= 0 then *out = converted(s)
    status(r)

@export("sysl_fs_ftruncate")
ftruncate(fd: int, length: long) -> int = status(syscall(SYS_FTRUNCATE, u64(fd), u64(length), 0, 0))

// Linux's `struct stat` as `sysl.fs`'s thirteen numbers: the mode is POSIX's, type bits and all, and so
// are the owner and group (`Meta.owner`, `Meta.group`); keel keeps no devices or times, so those stay
// zero.
private converted(s: Stat) -> fsys.Stat
    fsys.Stat(long(s.size), long(s.mode), long(s.nlink), long(s.uid), long(s.gid), long(s.ino), 0, 0, 0, 0, 0, 0, 0)

// --- Paths -----------------------------------------------------------------------------------------

// keel has no symbolic links, so `follow` changes nothing.
@export("sysl_fs_stat")
stat(path: *u8, len: usize, follow: int, out: *fsys.Stat) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    var s = empty_stat()
    val r = syscall(SYS_NEWFSTATAT, CWD, c.at(), u64(usize(&s)), 0)
    if r >= 0 then *out = converted(s)
    status(r)

@export("sysl_fs_truncate")
truncate(path: *u8, len: usize, length: long) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_TRUNCATE, c.at(), u64(length), 0, 0))

@export("sysl_fs_mkdir")
mkdir(path: *u8, len: usize, mode: u32) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_MKDIRAT, CWD, c.at(), u64(mode), 0))

@export("sysl_fs_rmdir")
rmdir(path: *u8, len: usize) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_UNLINKAT, CWD, c.at(), AT_REMOVEDIR, 0))

@export("sysl_fs_unlink")
unlink(path: *u8, len: usize) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_UNLINKAT, CWD, c.at(), 0, 0))

@export("sysl_fs_rename")
rename(from: *u8, from_len: usize, to: *u8, to_len: usize) -> int
    var a = c_path(from, from_len) match
        Some(c) -> c
        None -> return too_long()
    var b = c_path(to, to_len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_RENAMEAT, CWD, a.at(), CWD, b.at()))

@export("sysl_fs_access")
access(path: *u8, len: usize, how: int) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_FACCESSAT, CWD, c.at(), u64(how), 0))

// `set_permissions`: keel's fchmodat takes the set-user-ID and rwx bits, which is all a keel mode has;
// setgid and sticky are refused as EINVAL, which reaches the program as an `Other(22)`.
@export("sysl_fs_chmod")
chmod(path: *u8, len: usize, mode: u32) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_FCHMODAT, CWD, c.at(), u64(mode), 0))

// `set_owner`: keel's fchownat, root only; an id past 16 bits is EINVAL.
@export("sysl_fs_chown")
chown(path: *u8, len: usize, owner: u32, group: u32) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall5(SYS_FCHOWNAT, CWD, c.at(), u64(owner), u64(group), 0))

// --- Directories -----------------------------------------------------------------------------------

// An open directory: its descriptor, and the whole `linux_dirent64` records the last `getdents64`
// handed back, taken one at a time. A stream is a slot of a fixed table, and the `usize` sysl.fs holds
// is the slot's number plus one, so zero is never a stream.
private struct Stream
    fd: u64                     // 0 for a free slot: descriptor 0 is the console, never a directory
    held: usize                 // bytes of records in `records`
    at: usize                   // the next record's offset
    records: [RECORDS]u8

private const STREAMS: usize = 8
private const RECORDS: usize = 512              // at least ten records of at most 48 bytes
private const RECLEN_AT: usize = 16             // a record's length, a little-endian u16
private const NAME_AT: usize = usize(DIRENT64_NAME)   // its name, which ends in a NUL

private var streams: [STREAMS]Stream

@export("sysl_fs_opendir")
opendir(path: *u8, len: usize, dir: *usize) -> int
    var slot: usize = 0
    while slot < STREAMS && streams[slot].fd != 0
        slot += 1
    if slot == STREAMS then return -IoError.TooManyOpenFiles.code()
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    val fd = syscall(SYS_OPENAT, CWD, c.at(), O_RDONLY | O_DIRECTORY, 0)
    if fd < 0 then return status(fd)
    streams[slot].fd = u64(fd)
    streams[slot].held = 0
    streams[slot].at = 0
    *dir = slot + 1
    0

@export("sysl_fs_readdir")
readdir(dir: usize, into: *u8, room: usize, got: *usize) -> int
    if dir == 0 || dir > STREAMS || streams[dir - 1].fd == 0 then return -IoError.NotOpen.code()
    val s = &streams[dir - 1]
    if s.at >= s.held
        val r = syscall(SYS_GETDENTS64, s.fd, u64(usize(&s.records[0])), u64(RECORDS), 0)
        if r < 0 then return status(r)
        s.held = usize(r)
        s.at = 0
        if r == 0
            *got = 0
            return 0
    var n: usize = 0
    while s.records[s.at + NAME_AT + n] != 0
        n += 1
    val take = if n < room then n else room
    for i in 0..<take
        into[i] = s.records[s.at + NAME_AT + i]
    s.at += usize(s.records[s.at + RECLEN_AT]) | (usize(s.records[s.at + RECLEN_AT + 1]) << 8)
    *got = take
    0

@export("sysl_fs_closedir")
closedir(dir: usize) -> int
    if dir == 0 || dir > STREAMS || streams[dir - 1].fd == 0 then return -IoError.NotOpen.code()
    val fd = streams[dir - 1].fd
    streams[dir - 1].fd = 0
    status(syscall(SYS_CLOSE, fd, 0, 0, 0))

@export("sysl_fs_getcwd")
getcwd(into: *u8, room: usize, got: *usize) -> int
    var whole: [PATH_ROOM]u8 = [0; PATH_ROOM]
    val r = syscall(SYS_GETCWD, u64(usize(&whole[0])), PATH_ROOM, 0, 0)
    if r < 0 then return status(r)
    val n = usize(r) - 1
    if n > room then return status(-i64(Errno.ERANGE))
    for i in 0..<n
        into[i] = whole[i]
    *got = n
    0

@export("sysl_fs_chdir")
chdir(path: *u8, len: usize) -> int
    var c = c_path(path, len) match
        Some(c) -> c
        None -> return too_long()
    status(syscall(SYS_CHDIR, c.at(), 0, 0, 0))

@export("sysl_fs_temp_dir")
temp_dir(prefix: *u8, len: usize, into: *u8, room: usize, got: *usize) -> int = UNSUPPORTED

// --- Links: keel has none ----------------------------------------------------------------------------

@export("sysl_fs_symlink")
symlink(target: *u8, target_len: usize, link: *u8, link_len: usize) -> int = UNSUPPORTED

@export("sysl_fs_link")
link(existing: *u8, existing_len: usize, fresh: *u8, fresh_len: usize) -> int = UNSUPPORTED

@export("sysl_fs_readlink")
readlink(path: *u8, len: usize, into: *u8, room: usize, got: *usize) -> int = UNSUPPORTED

@export("sysl_fs_realpath")
realpath(path: *u8, len: usize, into: *u8, room: usize, got: *usize) -> int = UNSUPPORTED

// --- sysl.io: the three descriptor hooks `sysl.io.sys` declares ----------------------------------------
//
// These answer a count rather than 0; a failure is `status`'s answer, as for every hook.

private[fsys] moved(r: i64) -> isize = if r >= 0 then isize(r) else isize(status(r))

// Reading the console waits for a whole line, so whatever `print` has collected — a prompt — goes out
// first, as C's line-buffered standard output does before standard input is read.
@export("sysl_io_read")
io_read(fd: int, into: *u8, room: usize) -> isize
    if fd == 0 then flush()
    moved(syscall(SYS_READ, u64(fd), addr(into), u64(room), 0))

@export("sysl_io_write")
io_write(fd: int, from: *u8, len: usize) -> isize
    if fd == 1 then flush()
    moved(syscall(SYS_WRITE, u64(fd), addr(from), u64(len), 0))

// keel's write is unbuffered; the only buffer is the runtime's line `print` fills.
@export("sysl_io_flush")
io_flush(fd: int) -> int
    if fd == 1 then flush()
    0

// --- sysl.process: the hooks of `sysl.process.sys` -------------------------------------------------
//
// keel's own spawn (1024), and Linux's wait4, getuid, getgid, setuid, setgid, pipe2, execve, kill,
// getpgid and the console's ioctls. The child's three standard streams and its environment go
// to keel's spawn as they are asked for; wait's POSIX status becomes an exit code or a signal. What it
// cannot be told — a starting directory (the child takes the caller's) — answers `UNSUPPORTED` rather
// than being dropped; so do a bounded wait and a temporary file.

//
// `pgid` is keel's SPAWN_SETPGROUP: `group_new` (0) asks for a group numbered by the child's pid, more
// than 0 joins that group, and `group_inherit` leaves the child in this one; `foreground` adds
// SPAWN_FOREGROUND, which makes the child's group the console's before it runs. keel's spawn starts
// every child with every signal at its default and nothing blocked, so a job begins with INT, QUIT,
// TSTP, TTIN, TTOU and CHLD reset whatever this program ignores.
@export("sysl_proc_spawn")
proc_spawn(path: *u8, path_len: usize, argv: *psys.Text, argc: usize, envp: *psys.Text, envc: usize,
           inherit_env: int, dir: *u8, dir_len: usize, stdin_fd: int, stdout_fd: int, stderr_fd: int,
           started: *i64, pgid: i64, foreground: int) -> i64
    *started = 0
    if dir_len != 0 then return i64(UNSUPPORTED)
    if pgid < psys.group_inherit then return i64(-IoError.Other(22).code())
    val packed = packed_args(argv, argc)
    val env = packed_env(envp, envc, inherit_env)
    var flags: u64 = 0
    if pgid != psys.group_inherit
        flags = SPAWN_SETPGROUP
        if foreground != 0 then flags |= SPAWN_FOREGROUND
    val group = if pgid > 0 then u64(pgid) else 0
    var attr = SpawnAttr([fd_of(stdin_fd), fd_of(stdout_fd), fd_of(stderr_fd)], u64(usize(as_ptr(env.view()))),
                         u64(env.len()), 1, flags, group)
    var r = -i64(ENOENT)
    for c in searched(path, path_len, env.view()).view()
        r = syscall5(SYS_SPAWN, u64(usize(as_ptr(c.view()))), u64(c.len()), u64(usize(as_ptr(packed.view()))),
                     u64(packed.len()), u64(usize(&attr)))
        if r != -i64(ENOENT) then break
    if r >= 0 then r else i64(status(r))

// Where a program is looked for, in order: `path` itself when it names a directory (it has a `/`), and
// otherwise each directory of the `PATH` the child will have — `env` is its environment, packed — with
// `path` after it; with no `PATH`, keel's one directory of programs, /bin. An empty directory in `PATH`
// is the current one, as POSIX reads it.
private searched(path: *u8, path_len: usize, env: []const u8) -> Buf[Buf[u8]]
    var out: Buf[Buf[u8]] = buf()
    var named: Buf[u8] = buf()
    var has_slash = false
    for i in 0..<path_len
        if path[i] == u8('/') then has_slash = true
        named.push(path[i])
    if has_slash || path_len == 0
        out.push(named)
        return out
    val dirs = path_of_env(env)
    var start: usize = 0
    for i in 0..dirs.len
        if i == dirs.len || dirs[i] == u8(':')
            var c: Buf[u8] = buf()
            if i == start then c.push(u8('.')) else c.extend(dirs[start..<i])
            c.push(u8('/'))
            c.extend(named.view())
            out.push(c)
            start = i + 1
    out

// The value of `PATH` among the NUL-ended `NAME=value` entries of `env`, or "/bin" when there is none.
private path_of_env(env: []const u8) -> []const u8
    var at: usize = 0
    while at < env.len
        var end = at
        while end < env.len && env[end] != 0
            end += 1
        val entry = env[at..<end]
        if entry.len >= 5 && entry[0..<5] == "PATH=".bytes then return entry[5..]
        at = end + 1
    "/bin".bytes

// A hook's descriptor as keel's spawn takes it: -1, "this program's own", is NO_FD.
private fd_of(fd: int) -> u64 = if fd < 0 then NO_FD else u64(fd)

// keel's spawn takes the argument vector as each argument followed by a NUL.
private packed_args(argv: *psys.Text, argc: usize) -> Buf[u8]
    var packed: Buf[u8] = buf()
    for i in 0..<argc
        append_text(&packed, argv[i])
        packed.push(0)
    packed

// ...and the environment the same way: this program's own entries first when it is inherited, less any
// `envp` names again.
private packed_env(envp: *psys.Text, envc: usize, inherit_env: int) -> Buf[u8]
    var env: Buf[u8] = buf()
    if inherit_env != 0
        for e in environment()
            if !named_in(e, envp, envc)
                env.extend(e)
                env.push(0)
    for i in 0..<envc
        append_text(&env, envp[i])
        env.push(0)
    env

// Linux's execve, which keeps the pid, the descriptors and the directory and answers only when it
// fails, having checked everything before giving the image up. `print`'s line goes out first: the
// buffer holding it goes with the image.
@export("sysl_proc_exec")
proc_exec(path: *u8, path_len: usize, argv: *psys.Text, argc: usize, envp: *psys.Text, envc: usize,
          inherit_env: int) -> int
    val packed = packed_args(argv, argc)
    val env = packed_env(envp, envc, inherit_env)
    val arg_ptrs = pointers_to(packed.view())
    val env_ptrs = pointers_to(env.view())
    flush()
    var r = -i64(ENOENT)
    for c in searched(path, path_len, env.view()).view()
        var named = c
        named.push(0)
        r = syscall(SYS_EXECVE, u64(usize(as_ptr(named.view()))), u64(usize(as_ptr(arg_ptrs.view()))),
                    u64(usize(as_ptr(env_ptrs.view()))), 0)
        if r != -i64(ENOENT) then break
    if r < 0 then status(r) else -IoError.Other(5).code()

// A pointer to each NUL-ended string of `packed`, then a null one: an `argv` or `envp` as execve takes
// it. The pointers are into `packed`, which must outlive them.
private pointers_to(packed: []const u8) -> Buf[u64]
    var out: Buf[u64] = buf()
    var at: usize = 0
    while at < packed.len
        out.push(u64(usize(as_ptr(packed)) + at))
        while packed[at] != 0
            at += 1
        at += 1
    out.push(0)
    out

// keel keeps one user and one group per process, so the real ids are the ones the process acts as.
@export("sysl_proc_get_id")
proc_get_id(which: int) -> i64
    val nr = which match
        psys.id_user | psys.id_real_user -> SYS_GETUID
        psys.id_group | psys.id_real_group -> SYS_GETGID
        else return i64(-IoError.Other(22).code())
    val r = syscall(nr, 0, 0, 0, 0)
    if r < 0 then i64(status(r)) else r

// setuid (32) and setgid (33): EPERM unless the process is root.
@export("sysl_proc_set_id")
proc_set_id(which: int, id: u32) -> int
    val nr = which match
        psys.id_user -> SYS_SETUID
        psys.id_group -> SYS_SETGID
        else return -IoError.Other(22).code()
    status(syscall(nr, u64(id), 0, 0, 0))

private append_text(b: *Buf[u8], t: psys.Text)
    for j in 0..<t.len
        b.push(t.ptr[j])

// Whether entry `e` (`NAME=value`) names a variable one of the `envc` entries at `envp` sets again.
private named_in(e: []const u8, envp: *psys.Text, envc: usize) -> bool
    var n: usize = 0
    while n < e.len && e[n] != u8('=')
        n += 1
    for i in 0..<envc
        val t = envp[i]
        if t.len > n && t.ptr[n] == u8('=')
            var same = true
            for j in 0..<n
                if t.ptr[j] != e[j]
                    same = false
                    break
            if same then return true
    false

@export("sysl_proc_wait")
proc_wait(pid: i64, started: i64, timeout_ms: i64, how: *int, value: *int) -> int
    if timeout_ms > 0 then return UNSUPPORTED
    var s = ExitStatus(0)
    val r = syscall(SYS_WAIT4, u64(pid), u64(usize(&s)), 0, 0)
    if r < 0 then return status(r)
    if s.exited()
        *how = psys.ended_exited
        *value = int(s.code())
    else
        *how = psys.ended_signalled
        *value = int(s.signal())
    0

// wait4 with WNOHANG: 0 while the child runs, 1 once it has ended and been reaped.
@export("sysl_proc_poll")
proc_poll(pid: i64, how: *int, value: *int) -> int
    var s = ExitStatus(0)
    val r = syscall(SYS_WAIT4, u64(pid), u64(usize(&s)), WNOHANG, 0)
    if r < 0 then return status(r)
    if r == 0 then return 0
    if s.exited()
        *how = psys.ended_exited
        *value = int(s.code())
    else
        *how = psys.ended_signalled
        *value = int(s.signal())
    1

// setpgid(0, pgid): this process into group `pgid`, or a new group of its own for 0.
@export("sysl_proc_setpgid")
proc_setpgid(pgid: i64) -> int
    if pgid < 0 then return -IoError.Other(22).code()
    status(syscall(SYS_SETPGID, 0, u64(pgid), 0, 0))

// setsid: a new session led by this process, answering its id.
@export("sysl_proc_setsid")
proc_setsid() -> i64
    val r = syscall(SYS_SETSID, 0, 0, 0, 0)
    if r < 0 then i64(status(r)) else r

// kill(2), with POSIX's numbering.
@export("sysl_proc_kill")
proc_kill(pid: i64, signal: int) -> int
    if signal < 0 then return -IoError.Other(22).code()
    val r = syscall(SYS_KILL, u64(pid), u64(signal), 0, 0)
    if r < 0 then status(r) else 0

@export("sysl_proc_temp_path")
proc_temp_path(into: *u8, room: usize) -> isize = isize(UNSUPPORTED)

// pipe2. Neither end reaches a child it was not placed in: keel's spawn hands a child only the three
// streams it names.
@export("sysl_proc_pipe")
proc_pipe(read_end: *int, write_end: *int) -> int
    var fds: [2]u32 = [0, 0]
    val r = syscall(SYS_PIPE2, u64(usize(&fds[0])), 0, 0, 0)
    if r < 0 then return status(r)
    *read_end = int(fds[0])
    *write_end = int(fds[1])
    0

// getpgid(0): the group this process is in.
@export("sysl_proc_getpgrp")
proc_getpgrp() -> i64
    val r = syscall(SYS_GETPGID, 0, 0, 0, 0)
    if r < 0 then i64(status(r)) else r

// keel has one terminal, the console, and every process's controlling terminal is it; its calls only
// ask that the descriptor they are handed be the console. So the first of 0, 1 and 2 that is answers
// for the program, whatever the others were pointed at — and with none of them on it, the program has
// no terminal to ask about: ENXIO.
private const ENXIO: int = 6

// TIOCGPGRP on `fd`: the foreground group, or the negative errno.
private foreground_of(fd: u64) -> i64
    var g: u32 = 0
    val r = syscall(SYS_IOCTL, fd, TIOCGPGRP, u64(usize(&g)), 0)
    if r < 0 then r else i64(g)

private console_fd() -> Option[u64]
    for fd in 0..<3
        if foreground_of(u64(fd)) >= 0 then return Some(u64(fd))
    None

@export("sysl_proc_tcgetpgrp")
proc_tcgetpgrp() -> i64
    val fd = console_fd() match
        Some(f) -> f
        None -> return i64(-IoError.Other(ENXIO).code())
    val r = foreground_of(fd)
    if r < 0 then i64(status(r)) else r

// keel has no stopped state, so a background group's tcsetpgrp earns no SIGTTOU to hold back.
@export("sysl_proc_tcsetpgrp")
proc_tcsetpgrp(pgid: i64) -> int
    if pgid <= 0 then return -IoError.Other(22).code()
    val fd = console_fd() match
        Some(f) -> f
        None -> return -IoError.Other(ENXIO).code()
    var g = u32(pgid)
    status(syscall(SYS_IOCTL, fd, TIOCSPGRP, u64(usize(&g)), 0))
