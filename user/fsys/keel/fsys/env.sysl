module keel.fsys

// `sysl.env` on keel: the three hooks of `sysl.env.sys`, over the environment the kernel laid on the
// stack after argv (the runtime's `env_entry`). keel has no call that changes it, and neither does
// `sysl.env`, so the vector is only ever read.

import rt.keel.user.env_entry

// Copy what fits of `bytes` into `room` bytes at `into`, and its whole length into `got`.
private handed(bytes: []const u8, into: *u8, room: usize, got: *usize)
    val n = if bytes.len < room then bytes.len else room
    for k in 0..<n
        into[k] = bytes[k]
    *got = bytes.len

@export("sysl_env_get")
env_get(name: *u8, name_len: usize, into: *u8, room: usize, got: *usize) -> int
    var i: usize = 0
    loop
        val e = env_entry(i) match
            Some(found) -> found
            None -> return 0
        if e.len > name_len && e[name_len] == u8('=') && same(e, name, name_len)
            handed(e[name_len + 1..], into, room, got)
            return 1
        i += 1

private same(e: []const u8, name: *u8, n: usize) -> bool
    for k in 0..<n
        if e[k] != name[k] then return false
    true

@export("sysl_env_count")
env_count() -> isize
    var i: usize = 0
    while env_entry(i).is_some()
        i += 1
    isize(i)

@export("sysl_env_entry")
env_entry_hook(i: usize, into: *u8, room: usize, got: *usize) -> int = env_entry(i) match
    Some(e) ->
        handed(e, into, room, got)
        1
    None -> 0
