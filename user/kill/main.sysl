// kill [-SIG] pid...: send each process the signal — SIGTERM unless one is named, by number (`-9`) or by
// name (`-KILL`, `-SIGKILL`). A negative pid names a process group. A user may signal only their own
// processes; root may signal any. Exits 1 if any could not be signalled.

import abi.keel.abi.SIGTERM
import rt.keel.user
import sysl.signal
import sysl.text.from_utf8

// A signal's number from its name or number, without the `-`; 0 for one this does not know.
signal_of(word: string) -> u64
    var b = word.bytes
    if b.len > 3 && b[0] == u8('S') && b[1] == u8('I') && b[2] == u8('G') then b = b[3..]
    var n: u64 = 0
    var digits = b.len > 0
    for c in b
        if c < u8('0') || c > u8('9') then digits = false else n = n * 10 + u64(c - u8('0'))
    if digits then return if n > 0 && n < 32 then n else 0
    from_utf8(b).unwrap_or("") match
        "HUP" -> 1
        "INT" -> 2
        "QUIT" -> 3
        "KILL" -> 9
        "USR1" -> 10
        "USR2" -> 12
        "PIPE" -> 13
        "ALRM" -> 14
        "TERM" -> 15
        "CHLD" -> 17
        else 0

// A pid, possibly negative; None if `word` is not one.
pid_of(word: string) -> Option[i64]
    val b = word.bytes
    var at: usize = 0
    var sign: i64 = 1
    if b.len > 0 && b[0] == u8('-')
        sign = -1
        at = 1
    if at == b.len then return None
    var n: i64 = 0
    for i in at..<b.len
        if b[i] < u8('0') || b[i] > u8('9') then return None
        n = n * 10 + i64(b[i] - u8('0'))
    Some(sign * n)

main(args: []string)
    var sig = SIGTERM
    var first: usize = 1
    if args.len > 2 && args[1].bytes.len > 1 && args[1].bytes[0] == u8('-')
        sig = signal_of(from_utf8(args[1].bytes[1..]).unwrap_or(""))
        if sig == 0
            print(s"kill: ${args[1]}: no such signal")
            exit(1)
        first = 2
    if first >= args.len
        print("kill: usage: kill [-SIG] pid...")
        exit(1)
    var failed = 0
    for word in args[first..]
        pid_of(word) match
            Some(pid) ->
                signal.send(pid, int(sig)) match
                    Ok(_) -> ()
                    Err(e) ->
                        print(s"kill: $word: $e")
                        failed = 1
            None ->
                print(s"kill: $word: not a pid")
                failed = 1
    exit(failed)
