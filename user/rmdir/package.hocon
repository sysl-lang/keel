// `rmdir`: empty directories removed, written with the standard library's `sysl.fs`.

package {
  name    = "rmdir"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
