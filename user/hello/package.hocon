// The first user program: prints through `write`, grows its heap, and exits 0.

package {
  name    = "hello"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
}

// keel does not save the FP/SIMD registers yet, and leaves the unit trapping at EL0 too.
codegen {
  general_regs_only = true
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"

    // keel is not POSIX to the compiler: a sysl.posix module is refused at compile time, not at the link.
    capabilities {
      posix = false
    }
  }
}
