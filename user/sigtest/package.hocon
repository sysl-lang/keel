// `sigtest`: signals — handlers, the mask, EINTR, SIGPIPE, SIGCHLD, Ctrl-C — checked from EL0 (milestone 15b).

package {
  name    = "sigtest"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"

    // keel is not POSIX to the compiler: a sysl.posix module is refused at compile time, not at the link.
    capabilities {
      posix = false
    }
  }
}
