// `ls`: a directory's names, written with the standard library's `sysl.fs`.

package {
  name    = "ls"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
  passwd { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
