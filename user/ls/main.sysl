// ls [<dir>]: the names in a directory (the current one by default), sorted, one to a line. Exits 1
// if the directory could not be listed.

import rt.keel.user
import sysl.fs
import sysl.slices.sort

main(args: []string)
    val dir = if args.len > 1 then args[1] else "."
    fs.entries(dir) match
        Ok(names) ->
            var all = names.view()
            sort(all)
            for name in all
                print(name)
        Err(e) ->
            print(s"ls: $dir: $e")
            exit(1)
