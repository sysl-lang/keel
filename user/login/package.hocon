// `login`: asks who is at the console, checks the password against /etc/passwd, and runs that user's
// shell as them.

package {
  name    = "login"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
  passwd { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
