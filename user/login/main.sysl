// login: who is at the console. It asks for a name and a password, checks them against /etc/passwd
// (keel.passwd has the hash), and then becomes that user — its group, then its uid, which only root
// may change, so login has to be started by root (init) — goes to the user's home directory and runs
// the user's shell as a child, waiting for it. When the shell exits, so does login, and init starts
// another, the way getty does.
//
// A wrong name or password says `login incorrect` and asks again. The end of the input at the name
// prompt (Ctrl-D on an empty line) exits with passwd.CONSOLE_CLOSED, which tells init the console is
// gone. The password is read with the terminal's echo off (`sysl.tty.hidden`, which keel.fsys answers
// with TCGETS/TCSETS), and the newline the hidden line ended with is printed afterwards, as getpass does.

import passwd.keel.passwd
import passwd.keel.passwd.User
import rt.keel.user
import sysl.fs
import sysl.fs.IoError
import sysl.io.{lines, stdin}
import sysl.process
import sysl.tty

session(u: User) -> never
    process.set_group(u.gid) match
        Ok(_) -> ()
        Err(e) -> refuse(e)
    process.set_user(u.uid) match
        Ok(_) -> ()
        Err(e) -> refuse(e)
    fs.set_current_dir(u.home) match
        Ok(_) -> ()
        Err(e) ->
            print(s"login: ${u.home}: $e; starting in /")
            val _ = fs.set_current_dir("/")
    // The session's environment says whose it is.
    val env = [s"HOME=${u.home}", s"USER=${u.name}"]
    val shell = user.spawn(u.shell, ["sh"], env = Some(env[..])) match
        Ok(pid) -> pid
        Err(e) ->
            print(s"login: cannot start ${u.shell}: ${user.describe(e)}")
            exit(1)
    loop
        user.wait() match
            Ok((pid, _)) -> if pid == shell then exit(0)
            Err(_) -> exit(0)

refuse(e: IoError) -> never
    print(s"login: cannot change user: $e")
    exit(1)

var input = stdin()
var reader = lines(&input)
loop
    prints("login: ")
    val name = reader.getline() match
        Some(n) -> n
        None ->
            print("")
            exit(passwd.CONSOLE_CLOSED)
    if name == "" then continue
    prints("password: ")
    val quiet = tty.hidden()
    val line = reader.getline()
    if quiet
        tty.cooked()
        print("")
    val password = line match
        Some(p) -> p
        None -> exit(passwd.CONSOLE_CLOSED)
    passwd.user_named(passwd.read_users(), name) match
        Some(u) -> if passwd.opens(u, password) then session(u)
        None -> ()
    print("login incorrect")
