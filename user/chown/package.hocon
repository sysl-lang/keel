// `chown <user>[:<group>] <path>...`: owner and group, by name or number; root only.

package {
  name    = "chown"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
  passwd { workspace = true }
}

// keel does not save the FP/SIMD registers yet, and leaves the unit trapping at EL0 too.
codegen {
  general_regs_only = true
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
