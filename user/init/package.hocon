// `init`: pid 1. Runs `login` again and again, the way getty does, and reaps the processes whose
// parents ended first.

package {
  name    = "init"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
  passwd { workspace = true }
}

// keel does not save the FP/SIMD registers yet, and leaves the unit trapping at EL0 too.
codegen {
  general_regs_only = true
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
