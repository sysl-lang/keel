// `chmod <octal mode> <path>...`: permission bits, through `sysl.fs.set_permissions`.

package {
  name    = "chmod"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
