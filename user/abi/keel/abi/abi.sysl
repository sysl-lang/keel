module keel.abi

// keel's system calls. A user program makes one with `svc #0`: the call's number in x8, its arguments
// in x0 to x5, and the answer comes back in x0 — the result, or a negative error number. Every other
// register is preserved. The numbers are keel's own; the error numbers are Linux's, so a C library's
// tables would read them unchanged.

const SYS_EXIT: u64 = 1         // exit(code) -> never
const SYS_WRITE: u64 = 2        // write(fd, buf, len) -> bytes written
const SYS_GETPID: u64 = 3       // getpid() -> pid
const SYS_BRK: u64 = 4          // brk(addr) -> the break: moved to addr if it could be, else unchanged

// Where the two console descriptors are. There are no files yet; both go to the UART.
const STDOUT: u64 = 1
const STDERR: u64 = 2

const EBADF: i64 = 9            // not an open descriptor
const ENOMEM: i64 = 12
const EFAULT: i64 = 14          // a pointer argument is not memory the caller may use that way
const EINVAL: i64 = 22
const ENOSYS: i64 = 38          // no such system call
