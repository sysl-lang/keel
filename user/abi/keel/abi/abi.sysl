module keel.abi

// keel's system calls. A user program makes one with `svc #0`: the call's number in x8, its arguments
// in x0 to x5, and the answer comes back in x0 — the result, or a negative error number. Every other
// register is preserved. The numbers are keel's own; the error numbers and the `open` flags are
// Linux's, so a C library's tables would read them unchanged.
//
// A path is a pointer and a length, not a NUL-terminated string: a sysl `string` is a pointer and a
// length, and nothing lays a zero after its bytes.

const SYS_EXIT: u64 = 1         // exit(code) -> never
const SYS_WRITE: u64 = 2        // write(fd, buf, len) -> bytes written
const SYS_GETPID: u64 = 3       // getpid() -> pid
const SYS_BRK: u64 = 4          // brk(addr) -> the break: moved to addr if it could be, else unchanged
const SYS_OPEN: u64 = 5         // open(path, path_len, flags) -> fd
const SYS_READ: u64 = 6         // read(fd, buf, len) -> bytes read; 0 at the end of the file
const SYS_CLOSE: u64 = 7        // close(fd) -> 0
const SYS_LSEEK: u64 = 8        // lseek(fd, offset, whence) -> the new offset
const SYS_FSTAT: u64 = 9        // fstat(fd, *Stat) -> 0
const SYS_STAT: u64 = 10        // stat(path, path_len, *Stat) -> 0
const SYS_MKDIR: u64 = 11       // mkdir(path, path_len) -> 0
const SYS_GETDENTS: u64 = 12    // getdents(fd, buf, len) -> bytes of whole `Dirent` records; 0 at the end
const SYS_UNLINK: u64 = 13      // unlink(path, path_len) -> 0: a file
const SYS_RMDIR: u64 = 14       // rmdir(path, path_len) -> 0: an empty directory
const SYS_RENAME: u64 = 15      // rename(from, from_len, to, to_len) -> 0
const SYS_SYNC: u64 = 16        // sync() -> 0: every changed block is on the disk when it returns
const SYS_GETCWD: u64 = 17      // getcwd(buf, len) -> bytes of the current directory's path; ERANGE if it does not fit
const SYS_CHDIR: u64 = 18       // chdir(path, path_len) -> 0
const SYS_TRUNCATE: u64 = 19    // truncate(path, path_len, length) -> 0: cut to `length`, or grown with zeros
const SYS_FTRUNCATE: u64 = 20   // ftruncate(fd, length) -> 0: the same, through a descriptor open for writing
const SYS_ACCESS: u64 = 21      // access(path, path_len, how) -> 0 if the path is there (keel has no permissions)

// A path that does not begin with `/` is taken from the process's current directory, which starts at
// `/`. A process starts with its arguments on its stack, as Linux lays them out: SP points at argc (a
// u64), then argc pointers to NUL-terminated strings, then a zero.

// Descriptors 0 to 2 are the console: 1 and 2 write to the UART, 0 reads nothing yet. A file opened
// gets the lowest free descriptor from 3 up.
const STDIN: u64 = 0
const STDOUT: u64 = 1
const STDERR: u64 = 2
const FIRST_FILE_FD: u64 = 3
const MAX_FDS: u64 = 16

// `open`'s flags.
const O_RDONLY: u64 = 0
const O_WRONLY: u64 = 1
const O_RDWR: u64 = 2
const O_ACCMODE: u64 = 3
const O_CREAT: u64 = 0x40
const O_EXCL: u64 = 0x80
const O_TRUNC: u64 = 0x200
const O_APPEND: u64 = 0x400

// `lseek`'s whence.
const SEEK_SET: u64 = 0
const SEEK_CUR: u64 = 1
const SEEK_END: u64 = 2

// `Stat.kind`.
const KIND_FILE: u32 = 1
const KIND_DIR: u32 = 2

// What `fstat` and `stat` fill in.
struct Stat
    ino: u32
    kind: u32                   // KIND_FILE or KIND_DIR
    mode: u32                   // permission bits
    links: u32
    size: u64

@assert(sizeof(Stat) == 24, "a Stat is 24 bytes")

// What `getdents` fills its buffer with: whole records, `.` and `..` included, as the directory holds
// them. The same 32 bytes as the directory entry on the disk (keel.ondisk's `Dirent`).
struct Dirent
    ino: u32
    len: u8                     // bytes of `name` in use
    kind: u8                    // KIND_FILE or KIND_DIR
    reserved: u16
    name: [24]u8

@assert(sizeof(Dirent) == 32, "a Dirent is 32 bytes")

// The error numbers, as the negative of what a call answers.
enum Errno: i64
    ENOENT = 2                  // no such file or directory
    EIO = 5                     // the disk failed
    EBADF = 9                   // not an open descriptor, or not open for this
    ENOMEM = 12
    EFAULT = 14                 // a pointer argument is not memory the caller may use that way
    EBUSY = 16                  // the file is open
    EEXIST = 17
    ENOTDIR = 20
    EISDIR = 21
    EINVAL = 22
    EMFILE = 24                 // every descriptor is in use
    EFBIG = 27                  // past the largest file the filesystem holds
    ENOSPC = 28                 // no free block or inode
    ERANGE = 34                 // a result does not fit the buffer it was asked into
    ENAMETOOLONG = 36
    ENOSYS = 38                 // no such system call
    ENOTEMPTY = 39
