// `stdsig`: the standard library's `sysl.signal` and `sysl.process` groups on keel, through keel.fsys's
// hooks.

package {
  name    = "stdsig"
  version = "0.0.1"
}

dependencies {
  abi { workspace = true }
  rt { workspace = true }
  fsys { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
