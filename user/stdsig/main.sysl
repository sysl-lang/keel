// stdsig: the standard library's signals and process groups, checked from EL0. Each line is printed
// only once its checks have passed; a failure prints `user: FAILED: …` and exits 1.
//
//   watch ok     `sysl.signal.watch(INT)`, then `raise(INT)`: `take` answers true once, then false
//   restart ok   a read of a pipe, interrupted by a watched signal from a child, is made again and
//                answers the byte the child writes after it — SA_RESTART — rather than EINTR
//   ignore ok    dropping the watch put INT's default back; `ignore(INT)` and a `raise` this process
//                survives
//   group ok     `process_group()` is this process's group; a child started with `group: New` and
//                `foreground` leads its own group, holds the console, and starts with INT at its
//                default though this process ignores it; one started with `Join` is in that group;
//                `set_foreground_group` takes the console back
//   session ok   a child moves into a group of its own and back (`set_process_group`); another starts
//                a session (`new_session`) and is then refused a second one, a group of its own and
//                this process's group; this process, leading its group, is refused a session
//   zombie group ok  a child that leads a group and has ended, unreaped, keeps the group: a second
//                child joins it; once the first is reaped, a join is refused
//
// `stdsig leader`, `stdsig member <group>`, `stdsig regroup <group>` and `stdsig session <group>` are
// the children: each checks what it was started with and exits 0 if it was right.

import abi.keel.abi.{SIGINT, SIG_DFL}
import rt.keel.user
import sysl.fs.IoError
import sysl.process
import sysl.process.{Group, Status, Stdio}
import sysl.signal
import sysl.text.parse_int

stop(what: string) -> never
    print(s"user: FAILED: $what")
    user.exit(1)

check(ok: bool, what: string)
    if !ok then stop(what)

// Started as a job's leader: its group is its own pid, the console's foreground is that group, and
// SIGINT is at its default — the action the call below replaces. Its standard input is a pipe, and it
// stays (keeping its group alive for a member to join) until the pipe's writer closes it.
leader() -> int
    val me = int(user.getpid())
    if process.process_group() != me then return 1
    process.foreground_group() match
        Ok(g) -> if g != me then return 2
        Err(_) -> return 3
    user.sigaction(SIGINT, SIG_DFL) match
        Ok(old) -> if old.handler != SIG_DFL then return 4
        Err(_) -> return 5
    var room: [8]u8 = [0; 8]
    loop
        user.read(0, room[..]) match
            Ok(0) -> return 0
            Ok(_) -> ()
            Err(_) -> return 6

// Started to join group `want`.
member(want: string) -> int = parse_int(want) match
    Ok(g) -> if process.process_group() == int(g) then 0 else 1
    Err(_) -> 2

// Started in its parent's group `back`: made the leader of a group of its own, and moved back.
regroup(back: string) -> int
    val g = parse_int(back) match
        Ok(g) -> int(g)
        Err(_) -> return 1
    val me = int(user.getpid())
    if process.process_group() != g then return 2
    if process.set_process_group().is_err() then return 3
    if process.process_group() != me then return 4
    if process.set_process_group(g).is_err() then return 5
    if process.process_group() != g then return 6
    0

// Started in its parent's group `back`, so leading none: made the leader of a new session numbered by
// its pid, and of a group of the same number. Then, leading both, a second session is refused, as are
// a group of its own (a session's leader stays in the group it leads) and its parent's group, which is
// in the other session.
session(back: string) -> int
    val g = parse_int(back) match
        Ok(g) -> int(g)
        Err(_) -> return 1
    val me = int(user.getpid())
    if process.process_group() != g then return 2
    process.new_session() match
        Ok(sid) -> if sid != me then return 3
        Err(_) -> return 4
    if process.process_group() != me then return 5
    process.new_session() match
        Err(IoError.NotPermitted) -> ()
        _ -> return 6
    process.set_process_group() match
        Err(IoError.NotPermitted) -> ()
        _ -> return 7
    process.set_process_group(g) match
        Err(IoError.NotPermitted) -> ()
        _ -> return 8
    if process.process_group() != me then return 9
    0

main(args: []string)
    if args.len == 2 && args[1] == "leader" then user.exit(leader())
    if args.len == 3 && args[1] == "member" then user.exit(member(args[2]))
    if args.len == 3 && args[1] == "regroup" then user.exit(regroup(args[2]))
    if args.len == 3 && args[1] == "session" then user.exit(session(args[2]))
    check(args.len == 1, s"started with ${args.len} arguments it does not know")

    watching()
    val back = user.sigaction(SIGINT, SIG_DFL).unwrap()
    check(back.handler == SIG_DFL, "the last watch of INT, dropped, did not put its default back")
    check(signal.ignore(signal.INT).is_ok(), "ignore(INT)")
    check(signal.raise(signal.INT).is_ok(), "raise(INT) while ignored")
    print("stdsig: ignore ok")

    val mine = process.process_group()
    check(mine == int(user.getpgid().unwrap()), s"process_group() answered $mine")
    var (hold, release) = process.pipe().unwrap()
    var lead = process.spawn("/bin/stdsig", ["leader"], stdin = Stdio.FromFile(hold), group = Group.New,
                             foreground = true).unwrap()
    check(hold.close().is_ok(), "closing the leader's end of the pipe")
    val g = lead.group()
    check(g != mine, "the new group is this process's")
    val joined = process.run("/bin/stdsig", ["member", s"$g"], group = Group.Join(g)).unwrap()
    check(joined == Status.Exited(0), s"the member of group $g ended $joined")
    check(release.close().is_ok(), "closing the pipe the leader waits on")
    val led = lead.wait().unwrap()
    check(led == Status.Exited(0), s"the leader ended $led")
    check(process.set_foreground_group(mine).is_ok(), "taking the console back")
    check(process.foreground_group().unwrap() == mine, "the console's group is not this process's again")
    check(signal.restore_default(signal.INT).is_ok(), "restore_default(INT)")
    print("stdsig: group ok")

    val moved = process.run("/bin/stdsig", ["regroup", s"$mine"], group = Group.Join(mine)).unwrap()
    check(moved == Status.Exited(0), s"the child that changed groups ended $moved")
    val led_session = process.run("/bin/stdsig", ["session", s"$mine"], group = Group.Join(mine)).unwrap()
    check(led_session == Status.Exited(0), s"the child that started a session ended $led_session")
    process.new_session() match
        Err(IoError.NotPermitted) -> ()
        _ -> stop("a group's leader was not refused a session")
    check(process.process_group() == mine, "this process left its group")
    print("stdsig: session ok")

    zombie_group()
    print("stdsig: zombie group ok")
    user.exit(0)

// A child leading a group of its own exits and is not waited for; until it is reaped it is still that
// group's member, so a second child may join the group — a pipeline's later stage started after its
// first stage has ended. Once the first is reaped the group is gone and a join is refused.
zombie_group()
    var first = process.spawn("/bin/true", ["first"], group = Group.New).unwrap()
    val g = first.group()
    var rounds = 0
    while !has_ended(g)
        rounds += 1
        check(rounds < 1000, s"the child $g never ended")
        val _ = user.nanosleep(10_000_000)
    val joined = process.run("/bin/stdsig", ["member", s"$g"], group = Group.Join(g))
    check(joined.is_ok(), s"joining group $g, whose only member has ended unreaped, was refused")
    check(joined.unwrap() == Status.Exited(0), "the child that joined an ended leader's group")
    check(first.wait().unwrap() == Status.Exited(0), "the ended leader")
    process.spawn("/bin/true", ["late"], group = Group.Join(g)) match
        Err(IoError.NotPermitted) -> ()
        _ -> stop(s"group $g was joined after its last member was reaped")

// Whether process `pid` is in the table, ended and not yet reaped.
has_ended(pid: int) -> bool
    for info in user.procs().unwrap().view()
        if int(info.pid) == pid then return info.ended == 1
    false

// The watch of INT lives for this call, and is the last one, so returning puts INT's default back.
watching()
    val w = signal.watch(signal.INT).unwrap()
    check(!w.take(), "a watch began with an arrival")
    check(signal.raise(signal.INT).is_ok(), "raise(INT)")
    check(w.take(), "take() did not see the raised INT")
    check(!w.take(), "take() saw the one INT twice")
    print("stdsig: watch ok")

    val (r, wr) = user.pipe().unwrap()
    val waker = user.fork().unwrap()
    if waker == 0
        val _ = user.nanosleep(50_000_000)
        val _ = signal.send(i64(user.getppid()), signal.INT)
        val _ = user.nanosleep(50_000_000)
        val _ = user.write_file(wr, "x".bytes)
        user.exit(0)
    var room: [8]u8 = [0; 8]
    user.read(r, room[..]) match
        Ok(n) -> check(n == 1 && room[0] == u8('x'), s"the restarted read answered $n bytes")
        Err(e) -> stop(s"the read answered errno ${i64(e)} instead of being made again")
    check(w.take(), "the INT that interrupted the read was not counted")
    check(user.wait(i64(waker)).is_ok(), "waiting for the waker")
    val _ = user.close(r)
    val _ = user.close(wr)
    print("stdsig: restart ok")
