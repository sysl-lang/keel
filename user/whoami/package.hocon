// `whoami`: the name of this process's user.

package {
  name    = "whoami"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
  passwd { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
