// su [user]: a shell as `user` (root if none is named), once that user's password is given; `exit`
// from it comes back to the shell that ran su.
//
// keel has one uid per process and only root may change it, so /bin/su is set-user-ID root on the disk
// (mkfs's owners file): it starts as root whoever runs it, checks the password, and gives root up for
// the target's group and uid before the shell starts. A wrong password exits 1 having changed nothing.
// The password is read with echo off, as login's is.

import passwd.keel.passwd
import rt.keel.user
import sysl.fs.IoError
import sysl.io.{lines, stdin}
import sysl.process

refuse(e: IoError) -> never
    print(s"su: cannot change user: $e")
    exit(1)

main(args: []string)
    val name = if args.len > 1 then args[1] else "root"
    val u = passwd.user_named(passwd.read_users(), name) match
        Some(u) -> u
        None ->
            print(s"su: unknown user $name")
            exit(1)
    prints("password: ")
    var input = stdin()
    var reader = lines(&input)
    val quiet = user.hidden(0)
    val line = reader.getline()
    user.shown(quiet)
    val password = line match
        Some(p) -> p
        None -> exit(1)
    if !passwd.opens(u, password)
        print("su: incorrect password")
        exit(1)
    process.set_group(u.gid) match
        Ok(_) -> ()
        Err(e) -> refuse(e)
    process.set_user(u.uid) match
        Ok(_) -> ()
        Err(e) -> refuse(e)
    val shell = user.spawn(u.shell, ["sh"]) match
        Ok(pid) -> pid
        Err(e) ->
            print(s"su: cannot start ${u.shell}: ${user.describe(e)}")
            exit(1)
    loop
        user.wait() match
            Ok((pid, _)) -> if pid == shell then exit(0)
            Err(_) -> exit(0)
