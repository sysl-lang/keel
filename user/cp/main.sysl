// cp [-r] <from> <to>: one file copied to another path, replacing whatever was there — written with the
// standard library's `sysl.fs`, as any sysl program would be. keel.fsys, a dependency in the manifest,
// is what answers `sysl.fs` underneath. With `-r`, a directory and everything under it, through
// `sysl.fs.copy_dir_all`, which merges into a directory and never overwrites a file.
//
// Exits 0 when the copy is whole, 1 when it failed (the reason on the console, in sysl.fs's words),
// and 2 when it was not given two paths.

import rt.keel.user
import sysl.fs

main(args: []string)
    val tree = args.len > 1 && args[1] == "-r"
    val first: usize = if tree then 2 else 1
    if args.len != first + 2
        print("usage: cp [-r] <from> <to>")
        exit(2)
    val from = args[first]
    val to = args[first + 1]
    val done = if tree then fs.copy_dir_all(from, to) else fs.copy_file(from, to)
    done match
        Ok(_) -> ()
        Err(e) ->
            print(s"cp: $from: $e")
            exit(1)
