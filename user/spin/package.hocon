// A user program that never gives up the processor: only the timer can take it away.

package {
  name    = "spin"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
}

codegen {
  general_regs_only = true
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"

    // keel is not POSIX to the compiler: a sysl.posix module is refused at compile time, not at the link.
    capabilities {
      posix = false
    }
  }
}
