// `sh`: keel's shell, written with the user runtime's `spawn` and `wait` and the standard library's
// `sysl.fs` and `sysl.io`.

package {
  name    = "sh"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
}

// keel does not save the FP/SIMD registers yet, and leaves the unit trapping at EL0 too.
codegen {
  general_regs_only = true
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
