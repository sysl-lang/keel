// `sh`: keel's shell, written with the standard library's `sysl.process`, `sysl.fs` and `sysl.io`,
// answered by keel.fsys's hooks.

package {
  name    = "sh"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
