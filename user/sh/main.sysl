// sh: keel's shell. It reads a line, splits it into words, and runs /bin/<first word> with the words
// as its argv, waiting for it; a word with a `/` in it is a path and is run as it is.
//
//   'quoted words' and "quoted words" are one word each, quotes removed
//   > file      the command's standard output goes to `file`, created or emptied first
//   cd [dir]    the current directory (built in: it is the shell's own); `/` with no argument
//   pwd         the current directory
//   exit [n]    end the shell with code n (0 by default); the end of the input does the same
//
// A command that fails says so on the line after its output: `sh: <name>: exit status <n>`, or that
// it was ended by a fault, or that it is not there (status 127).

import rt.keel.user
import sysl.buf.{Buf, buf}
import sysl.fs
import sysl.fs.IoError
import sysl.io.{lines, stdin}
import sysl.process
import sysl.process.{Status, Stdio}
import sysl.text.from_utf8

// One word, from the bytes collected for it.
word_of(bytes: Buf[u8]) -> string = from_utf8(bytes.view()) match
    Ok(s) -> s
    Err(_) -> ""

// The words of a line; None if a quote is left open.
words(line: string) -> Option[Buf[string]]
    var out: Buf[string] = buf()
    var cur: Buf[u8] = buf()
    var in_word = false
    var quote: u8 = 0
    for b in line.bytes
        if quote != 0
            if b == quote then quote = 0 else cur.push(b)
            continue
        if b == u8(' ') || b == u8('\t')
            if in_word
                out.push(word_of(cur))
                cur = buf()
                in_word = false
            continue
        in_word = true
        if b == u8('\'') || b == u8('"') then quote = b else cur.push(b)
    if quote != 0 then return None
    if in_word then out.push(word_of(cur))
    Some(out)

// Where a command is: a word with a `/` in it as it is, any other in /bin.
path_of(name: string) -> string
    for b in name.bytes
        if b == u8('/') then return name
    s"/bin/$name"

// Run a command's words, with a `>` and its file taken out first, and say how it failed if it did.
// Answers its status: its exit code, 127 if it is not there, 128 and up if a fault ended it.
run(all: Buf[string]) -> i64
    var args: Buf[string] = buf()
    var target = ""
    var i: usize = 0
    while i < all.len()
        val w = all.at(i)
        if w == ">"
            if i + 1 == all.len()
                print("sh: > needs a file")
                return 2
            target = all.at(i + 1)
            i += 2
        else
            args.push(w)
            i += 1
    if args.len() == 0 then return 0
    val name = args.at(0)

    // The `>` file is opened here rather than handed over as a path, so that a file that cannot be made
    // is told apart from a command that is not there.
    var out = Stdio.Inherit
    if target != ""
        fs.create(target) match
            Ok(f) -> out = Stdio.ToFile(f)
            Err(e) ->
                print(s"sh: $target: cannot open it: $e")
                return 1
    val ran = process.run(path_of(name), args.view()[1..], stdout = out)
    out match
        ToFile(f) ->
            var g = f
            val _ = g.close()
        Inherit | ToPath(_) -> ()
    ran match
        Ok(Exited(0)) -> 0
        Ok(Exited(code)) ->
            print(s"sh: $name: exit status $code")
            i64(code)
        Ok(s) ->
            print(s"sh: $name: $s")
            128 + i64(signal_of(s))
        Err(IoError.NotFound) ->
            print(s"sh: $name: not found")
            127
        Err(e) ->
            print(s"sh: $name: cannot run it: $e")
            126

// The signal a status names, for the shell's 128-and-up answer.
signal_of(s: Status) -> int = s match
    Signalled(n) -> n
    else 0

// The built-ins, which act on the shell itself; false if `w` is not one of them.
builtin(w: Buf[string]) -> bool
    val name = w.at(0)
    if name == "exit"
        val code = if w.len() > 1 then parse_code(w.at(1)) else 0
        exit(int(code))
    if name == "cd"
        val dir = if w.len() > 1 then w.at(1) else "/"
        fs.set_current_dir(dir) match
            Ok(_) -> ()
            Err(e) -> print(s"sh: cd: $dir: $e")
        return true
    if name == "pwd"
        fs.current_dir() match
            Ok(d) -> print(d)
            Err(e) -> print(s"sh: pwd: $e")
        return true
    false

// `exit`'s argument: decimal digits, and anything else 2.
parse_code(text: string) -> i64
    var n: i64 = 0
    for b in text.bytes
        if b < u8('0') || b > u8('9') then return 2
        n = n * 10 + i64(b - u8('0'))
    n

var input = stdin()
prints("$ ")
for line in lines(&input)
    words(line) match
        Some(w) ->
            if w.len() > 0 && !builtin(w) then val _ = run(w)
        None -> print("sh: a quote is not closed")
    prints("$ ")
print("")
exit(0)
