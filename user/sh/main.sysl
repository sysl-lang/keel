// sh: keel's shell. It reads a line, splits it into words, and runs /bin/<first word> with the words
// as its argv, waiting for it; a word with a `/` in it is a path and is run as it is.
//
//   'quoted words' and "quoted words" are one word each, quotes removed
//   a | b | c      a pipeline: each command's standard output is the next one's standard input; every
//                  stage is waited for, and the status is the last one's
//   < file         the command's standard input comes from `file`
//   > file         its standard output goes to `file`, created or emptied first
//   >> file        its standard output is added to the end of `file`, which is created if need be
//   NAME=value     a shell variable, when every word on the line is one
//   export NAME[=value]   a variable every command run afterwards finds in its environment
//   $NAME          the variable's value (nothing if it is unset), outside single quotes; $? is the
//                  status of the last command
//   cd [dir]       the current directory (built in: it is the shell's own); `/` with no argument
//   pwd            the current directory
//   exit [n]       end the shell with code n (0 by default); the end of the input does the same
//
// The prompt is `# ` when the shell runs as root and `$ ` otherwise. The shell starts with the
// variables of the environment it was given, every one of them exported.
//
// A command that fails says so on the line after its output: `sh: <name>: exit status <n>`, or
// `sh: <name>: killed by signal <n>` (status 128 + the signal), or that it is not there (status 127).
// For a pipeline it is the last stage that is reported.
//
// **Jobs.** Every command line is a job, run in a process group of its own (its first stage's pid),
// which is the console's foreground group while the shell waits for it — so Ctrl-C, which the console
// turns into SIGINT for the foreground group, reaches the job and not the shell. The shell is in a
// group of its own, takes the console back when the job ends, and ignores SIGINT itself.
//
//   cmd &          run it in the background: the shell prints `[n] <pid>` and does not wait
//   jobs           the background jobs still running: `[n] running <line>`
//   fg [%n]        bring job n (the newest, without one) to the foreground and wait for it
//   kill [-SIG] %n send job n's group a signal (SIGTERM by default); without a `%`, /bin/kill
//
// A background job that has ended is reported before the next prompt: `[n] done <line>`, `[n] exit
// status <n> <line>`, or `[n] killed by signal <n> <line>`. A job the shell has just signalled is given
// up to half a second to end first, so that its report comes at the very next prompt.
//
// Every job runs through `sysl.process`: pipes, `Group.New`/`Join`, and `foreground` for one the shell
// waits for. A background job's stages are kept as they were started and asked with `try_wait`, which
// does not block, before each prompt; `fg` waits for them.

import abi.keel.abi.{SIGINT, SIGTERM}
import rt.keel.user
import sysl.buf.{Buf, buf}
import sysl.env
import sysl.fs
import sysl.fs.{File, IoError}
import sysl.io.{lines, stdin}
import sysl.process
import sysl.process.{Group, Spawned, Status, Stdio, Var}
import sysl.signal
import sysl.text.from_utf8

// A word of the line, or one of the operators `|`, `<`, `>`, `>>`, `&` when `op` (a quoted `|` is a word).
struct Token
    text: string
    op: bool

struct ShellVar
    name: string
    value: string
    exported: bool

// A background job: its number, its process group, every stage that was started, which of them answers
// for the job, and the line that started it.
struct Job
    number: u64
    pgid: int
    stages: Buf[&Spawned]
    last_at: usize              // the stage whose status is the job's; `stages.len()` when it never started
    text: string
    signalled: bool             // the shell has just sent it a signal

// What the shell keeps between lines: its variables, the last command's status, its process group and
// its background jobs.
struct Shell
    vars: Buf[ShellVar]
    status: i64
    pgid: int
    jobs: Buf[Job]

// One command of a pipeline, with its redirections taken out.
struct Stage
    args: Buf[string]
    input: string               // `<`'s file, or ""
    output: string              // `>`'s or `>>`'s file, or ""
    append: bool                // it was `>>`

// One word, from the bytes collected for it.
word_of(bytes: Buf[u8]) -> string = from_utf8(bytes.view()) match
    Ok(s) -> s
    Err(_) -> ""

name_byte(b: u8, first: bool) -> bool =
    (b >= u8('a') && b <= u8('z')) || (b >= u8('A') && b <= u8('Z')) || b == u8('_') ||
        (!first && b >= u8('0') && b <= u8('9'))

// A variable's value; "" when it is unset.
value_of(sh: *Shell, name: string) -> string
    for v in sh.vars.view()
        if v.name == name then return v.value
    ""

// Set a variable, keeping it exported if it was; `export` exports it too.
set_var(sh: *Shell, name: string, value: string, export: bool)
    for i in 0..<sh.vars.len()
        val v = sh.vars.at(i)
        if v.name == name
            sh.vars.set(i, ShellVar(name, value, v.exported || export))
            return
    sh.vars.push(ShellVar(name, value, export))

// The tokens of a line, with `$NAME` and `$?` expanded outside single quotes; None if a quote is left
// open.
tokens(sh: *Shell, line: string) -> Option[Buf[Token]]
    val b = line.bytes
    val out: Buf[Token] = buf()
    var cur: Buf[u8] = buf()
    var in_word = false
    var quote: u8 = 0
    var i: usize = 0
    while i < b.len
        val c = b[i]
        if c == u8('$') && quote != u8('\'')
            in_word = true
            i = expand(sh, b, i + 1, &cur)
            continue
        if quote != 0
            if c == quote then quote = 0 else cur.push(c)
            i += 1
            continue
        if c == u8(' ') || c == u8('\t') || c == u8('|') || c == u8('<') || c == u8('>') || c == u8('&')
            if in_word
                out.push(Token(word_of(cur), false))
                cur = buf()
                in_word = false
            if c == u8('>') && i + 1 < b.len && b[i + 1] == u8('>')
                out.push(Token(">>", true))
                i += 2
                continue
            if c != u8(' ') && c != u8('\t') then out.push(Token(word_of(cur_of(c)), true))
            i += 1
            continue
        in_word = true
        if c == u8('\'') || c == u8('"') then quote = c else cur.push(c)
        i += 1
    if quote != 0 then return None
    if in_word then out.push(Token(word_of(cur), false))
    Some(out)

cur_of(c: u8) -> Buf[u8]
    val one: Buf[u8] = buf()
    one.push(c)
    one

// Expand the variable named from `b[i]` on into `cur`, and answer where the line goes on. A `$`
// followed by neither a name nor `?` is itself.
expand(sh: *Shell, b: []const u8, i: usize, cur: *Buf[u8]) -> usize
    if i < b.len && b[i] == u8('?')
        cur.extend(s"${sh.status}".bytes)
        return i + 1
    var end = i
    while end < b.len && name_byte(b[end], end == i)
        end += 1
    if end == i
        cur.push(u8('$'))
        return i
    cur.extend(value_of(sh, word_of(slice_buf(b[i..<end]))).bytes)
    end

slice_buf(b: []const u8) -> Buf[u8]
    val out: Buf[u8] = buf()
    out.extend(b)
    out

// `NAME=value` as its two halves, when `t` is a word of that shape.
assignment(t: Token) -> Option[(string, string)]
    if t.op then return None
    val b = t.text.bytes
    var n: usize = 0
    while n < b.len && name_byte(b[n], n == 0)
        n += 1
    if n == 0 || n == b.len || b[n] != u8('=') then return None
    Some((word_of(slice_buf(b[0..<n])), word_of(slice_buf(b[n + 1..]))))

// The line's commands, split at `|`, with each one's redirections taken out; None (and a message) if a
// redirection has no file or a stage is empty.
stages(toks: Buf[Token]) -> Option[Buf[Stage]]
    val out: Buf[Stage] = buf()
    var st = Stage(buf(), "", "", false)
    var i: usize = 0
    while i < toks.len()
        val t = toks.at(i)
        if !t.op
            st.args.push(t.text)
            i += 1
            continue
        if t.text == "|"
            if st.args.len() == 0
                print("sh: a | has no command before it")
                return None
            out.push(st)
            st = Stage(buf(), "", "", false)
            i += 1
            continue
        if i + 1 == toks.len() || toks.at(i + 1).op
            print(s"sh: ${t.text} needs a file")
            return None
        val file = toks.at(i + 1).text
        if t.text == "<"
            st.input = file
        else
            st.output = file
            st.append = t.text == ">>"
        i += 2
    if st.args.len() == 0
        if out.len() > 0
            print("sh: a | has no command after it")
            return None
        return Some(out)
    out.push(st)
    Some(out)

// The exported variables, as a child's whole environment.
exported_vars(sh: *Shell) -> Buf[Var]
    val out: Buf[Var] = buf()
    for v in sh.vars.view()
        if v.exported then out.push(Var(v.name, v.value))
    out

// Say how a command that failed ended, and answer its status.
reported(name: string, code: i64) -> i64
    if code != 0 then print(s"sh: $name: exit status $code")
    code

// A job's stages as they were started: each with its name, the job's process group (0 when nothing
// started), and the status of a failure to start the last stage (0 when it started).
struct Started
    stages: Buf[(&Spawned, string)]
    pgid: int
    last: i64

// A job — one command or a pipeline — started through `sysl.process`: a pipe between each two stages,
// every stage started before any is waited for, and the shell's copy of every file it opened closed
// once the stage that needs it has its own — or no reader would ever see the end of its input. The
// first stage starts a new process group, made the console's before its program runs when the job is
// in the `foreground`, and every later one joins it.
start_job(sh: *Shell, all: Buf[Stage], foreground: bool) -> Started
    val env = exported_vars(sh)
    val started: Buf[(&Spawned, string)] = buf()
    var pgid = 0
    var last: i64 = 0
    var from_prev: Option[File] = None
    for i in 0..<all.len()
        val st = all.at(i)
        val name = st.args.at(0)
        var input = from_prev
        var output: Option[File] = None
        from_prev = None
        if i + 1 < all.len()
            process.pipe() match
                Ok((r, w)) ->
                    output = Some(w)
                    from_prev = Some(r)
                Err(e) ->
                    print(s"sh: cannot make a pipe: $e")
                    closed(input)
                    last = 1
                    break
        last = 0
        if st.input != ""
            closed(input)
            input = opened(st.input, fs.open(st.input))
            if input.is_none() then last = 1
        if st.output != ""
            closed(output)
            output = opened(st.output, if st.append then fs.append(st.output) else fs.create(st.output))
            if output.is_none() then last = 1
        if last == 0
            val group = if pgid == 0 then Group.New else Group.Join(pgid)
            process.spawn(name, st.args.view()[1..], env = env.view(), inherit_env = false, stdin = reading(input),
                          stdout = writing(output), group = group, foreground = foreground && pgid == 0) match
                Ok(child) ->
                    if pgid == 0 then pgid = child.group()
                    started.push((child, name))
                Err(IoError.NotFound) ->
                    print(s"sh: $name: not found")
                    last = 127
                Err(e) ->
                    print(s"sh: $name: cannot run it: $e")
                    last = 126
        closed(input)
        closed(output)
    Started(started, pgid, last)

// Which of a job's started stages answers for it: the last, if the last stage was started.
last_stage(job: Started) -> usize
    if job.stages.len() > 0 && job.last == 0 then job.stages.len() - 1 else job.stages.len()

// A job in the foreground: every stage is waited for, the status is the last stage's if it was
// started, and the shell takes the console back once every stage has ended.
run_foreground(sh: *Shell, all: Buf[Stage]) -> i64
    val job = start_job(sh, all, true)
    var last = job.last
    val last_at = last_stage(job)
    for i in 0..<job.stages.len()
        val (child, name) = job.stages.at(i)
        child.wait() match
            Ok(s) -> if i == last_at then last = status_of(name, s)
            Err(_) -> ()
    take_console(sh)
    last

// A file for `<`, `>` or `>>`, as `open` answered it; None (and a message) if it could not be opened.
opened(file: string, r: Result[File, IoError]) -> Option[File] = r match
    Ok(f) -> Some(f)
    Err(e) ->
        print(s"sh: $file: cannot open it: $e")
        None

// The shell's copy of a file it handed a stage, closed: the stage has its own.
closed(f: Option[File])
    f match
        Some(g) ->
            var h = g
            h.close()
        None -> ()

reading(f: Option[File]) -> Stdio = f match
    Some(g) -> Stdio.FromFile(g)
    None -> Stdio.Inherit

writing(f: Option[File]) -> Stdio = f match
    Some(g) -> Stdio.ToFile(g)
    None -> Stdio.Inherit

// A job in the background: started as `run_foreground` starts one, but kept rather than waited for —
// `reap_jobs` asks its stages with `try_wait` before each prompt. The shell says the job's number and
// its process group, the number `kill` and `fg` act on.
run_background(sh: *Shell, all: Buf[Stage], text: string) -> i64
    val job = start_job(sh, all, false)
    if job.stages.len() == 0 then return job.last
    val stages: Buf[&Spawned] = buf()
    for (child, _) in job.stages.view()
        stages.push(child)
    var number: u64 = 1
    for j in sh.jobs.view()
        if j.number >= number then number = j.number + 1
    sh.jobs.push(Job(number, job.pgid, stages, last_stage(job), text, false))
    print(s"[$number] ${job.pgid}")
    0

// Make the shell's own group the console's foreground group again.
take_console(sh: *Shell)
    val _ = process.set_foreground_group(sh.pgid)

// Bring job `j` (an index into the job list) to the foreground: the console is its group's, the line
// that started it is said, and every stage still running is waited for.
foreground(sh: *Shell, j: usize) -> i64
    val job = sh.jobs.at(j)
    sh.jobs.remove(j)
    val _ = process.set_foreground_group(job.pgid)
    print(job.text)
    var last: i64 = 0
    for i in 0..<job.stages.len()
        job.stages.at(i).wait() match
            Ok(s) -> if i == job.last_at then last = status_of(job.text, s)
            Err(_) -> ()
    take_console(sh)
    last

// The job a `%n` word names, as an index into the job list; the newest for "".
job_named(sh: *Shell, word: string) -> Option[usize]
    if sh.jobs.len() == 0 then return None
    if word == "" then return Some(sh.jobs.len() - 1)
    val b = word.bytes
    if b.len < 2 || b[0] != u8('%') then return None
    var n: u64 = 0
    for i in 1..<b.len
        if b[i] < u8('0') || b[i] > u8('9') then return None
        n = n * 10 + u64(b[i] - u8('0'))
    for i in 0..<sh.jobs.len()
        if sh.jobs.at(i).number == n then return Some(i)
    None

// Collect what has ended of every background job, and report each job whose stages have all ended.
// A job the shell has just signalled is given up to half a second (50 naps of 10 ms) to end first.
reap_jobs(sh: *Shell)
    var i: usize = 0
    while i < sh.jobs.len()
        var job = sh.jobs.at(i)
        var naps = if job.signalled then 50 else 0
        while !finished(job) && naps > 0
            naps -= 1
            val _ = user.nanosleep(10_000_000)
        job.signalled = false
        if !finished(job)
            sh.jobs.set(i, job)
            i += 1
            continue
        sh.jobs.remove(i)
        print(s"[${job.number}] ${ending(job_status(job))} ${job.text}")

// Whether every stage of `job` has ended. `try_wait` reaps a stage that has and remembers how it ended,
// so asking again answers at once; a stage it cannot ask about counts as ended.
finished(job: Job) -> bool
    var all = true
    for child in job.stages.view()
        child.try_wait() match
            Ok(None) -> all = false
            _ -> ()
    all

// How a job that has finished ended: its last stage's status, or done when that stage never started.
job_status(job: Job) -> Status
    if job.last_at < job.stages.len()
        job.stages.at(job.last_at).try_wait() match
            Ok(Some(s)) -> return s
            _ -> ()
    Status.Exited(0)

// How a background job ended, as its report says it.
ending(s: Status) -> string = s match
    Status.Signalled(n) -> s"killed by signal $n"
    Status.Exited(0) -> "done"
    Status.Exited(c) -> s"exit status $c"
    Status.TimedOut -> "timed out"

// `kill [-SIG] %n`: the signal (SIGTERM unless named, by number or by name) to job n's group.
kill_job(sh: *Shell, w: Buf[string]) -> i64
    var sig = SIGTERM
    var at: usize = 1
    if w.len() > 2
        sig = signal_named(w.at(1))
        at = 2
    if sig == 0
        print(s"sh: kill: ${w.at(1)}: no such signal")
        return 1
    val j = job_named(sh, w.at(at)) match
        Some(j) -> j
        None ->
            print(s"sh: kill: ${w.at(at)}: no such job")
            return 1
    var job = sh.jobs.at(j)
    signal.send(-i64(job.pgid), int(sig)) match
        Ok(_) -> ()
        Err(e) ->
            print(s"sh: kill: ${w.at(at)}: $e")
            return 1
    job.signalled = true
    sh.jobs.set(j, job)
    0

// `-9`, `-KILL`, `-SIGKILL` and the like as a signal's number; 0 for one it does not know.
signal_named(word: string) -> u64
    val b = word.bytes
    if b.len < 2 || b[0] != u8('-') then return 0
    var name = word_of(slice_buf(b[1..]))
    if name.bytes.len > 3 && name.bytes[0] == u8('S') && name.bytes[1] == u8('I') && name.bytes[2] == u8('G')
        name = word_of(slice_buf(name.bytes[3..]))
    var n: u64 = 0
    var digits = true
    for c in name.bytes
        if c < u8('0') || c > u8('9') then digits = false else n = n * 10 + u64(c - u8('0'))
    if digits then return if n > 0 && n < 32 then n else 0
    name match
        "HUP" -> 1
        "INT" -> 2
        "QUIT" -> 3
        "KILL" -> 9
        "USR1" -> 10
        "USR2" -> 12
        "PIPE" -> 13
        "ALRM" -> 14
        "TERM" -> 15
        "CHLD" -> 17
        else 0

// How the pipeline's last stage ended, said if it failed, as its status.
status_of(name: string, s: Status) -> i64 = s match
    Status.Signalled(n) ->
        print(s"sh: $name: killed by signal $n")
        128 + i64(n)
    Status.Exited(c) -> reported(name, i64(c))
    Status.TimedOut ->
        print(s"sh: $name: timed out")
        124

// A line's commands: variables set, or a job run, in the background if it ends in `&`. Answers the
// status.
run_line(sh: *Shell, toks: Buf[Token], text: string) -> i64
    var words = toks
    var background = false
    if words.len() > 0 && words.at(words.len() - 1).op && words.at(words.len() - 1).text == "&"
        background = true
        words.pop()
    for t in words.view()
        if t.op && t.text == "&"
            print("sh: & must end the line")
            return 2
    if words.len() == 0 then return sh.status
    var all_assignments = true
    for t in words.view()
        if assignment(t).is_none() then all_assignments = false
    if all_assignments
        for t in words.view()
            val (name, value) = assignment(t).unwrap()
            set_var(sh, name, value, false)
        return 0
    val all = stages(words) match
        Some(s) -> s
        None -> return 2
    if all.len() == 0 then return sh.status
    if all.len() == 1 && all.at(0).input == "" && all.at(0).output == "" && !background
        builtin(sh, all.at(0).args) match
            Some(status) -> return status
            None -> ()
    if background then run_background(sh, all, job_text(text)) else run_foreground(sh, all)

// The line as a job list shows it: without a trailing `&` or the spaces around it.
job_text(line: string) -> string
    val b = line.bytes
    var end = b.len
    while end > 0 && (b[end - 1] == u8(' ') || b[end - 1] == u8('\t') || b[end - 1] == u8('&'))
        end -= 1
    var start: usize = 0
    while start < end && (b[start] == u8(' ') || b[start] == u8('\t'))
        start += 1
    word_of(slice_buf(b[start..<end]))

// The built-ins, which act on the shell itself; None if `w` is not one of them, else their status.
builtin(sh: *Shell, w: Buf[string]) -> Option[i64]
    val name = w.at(0)
    if name == "jobs"
        for j in sh.jobs.view()
            print(s"[${j.number}] running ${j.text}")
        return Some(0)
    if name == "fg"
        val word = if w.len() > 1 then w.at(1) else ""
        return job_named(sh, word) match
            Some(j) -> Some(foreground(sh, j))
            None ->
                print(s"sh: fg: no such job")
                Some(1)
    if name == "kill"
        for a in w.view()
            if a.bytes.len > 0 && a.bytes[0] == u8('%') then return Some(kill_job(sh, w))
        return None
    if plain_builtin(sh, w) then Some(0) else None

// The built-ins that answer nothing: exit, cd, pwd, export.
plain_builtin(sh: *Shell, w: Buf[string]) -> bool
    val name = w.at(0)
    if name == "exit"
        val code = if w.len() > 1 then parse_code(w.at(1)) else 0
        exit(int(code))
    if name == "cd"
        val dir = if w.len() > 1 then w.at(1) else "/"
        fs.set_current_dir(dir) match
            Ok(_) -> ()
            Err(e) -> print(s"sh: cd: $dir: $e")
        return true
    if name == "pwd"
        fs.current_dir() match
            Ok(d) -> print(d)
            Err(e) -> print(s"sh: pwd: $e")
        return true
    if name == "export"
        for a in w.view()[1..]
            assignment(Token(a, false)) match
                Some((n, v)) -> set_var(sh, n, v, true)
                None -> set_var(sh, a, value_of(sh, a), true)
        return true
    false

// `exit`'s argument: decimal digits, and anything else 2.
parse_code(text: string) -> i64
    var n: i64 = 0
    for b in text.bytes
        if b < u8('0') || b > u8('9') then return 2
        n = n * 10 + i64(b - u8('0'))
    n

// The prompt says who the shell runs as: `# ` for root, `$ ` for anyone else.
val prompt = if process.user() == 0 then "# " else "$ "

var sh = Shell(buf(), 0, 0, buf())
for (name, value) in env.vars()
    set_var(&sh, name, value, true)

// A group of its own, the console's while it reads a line, and Ctrl-C ignored: it is the job's to take.
// Each of these may fail where the input is not the console, which changes nothing else.
val _ = process.set_process_group()
sh.pgid = process.process_group()
take_console(&sh)
val _ = signal.ignore(int(SIGINT))

var input = stdin()
prints(prompt)
for line in lines(&input)
    tokens(&sh, line) match
        Some(t) -> if t.len() > 0 then sh.status = run_line(&sh, t, line)
        None ->
            print("sh: a quote is not closed")
            sh.status = 2
    reap_jobs(&sh)
    prints(prompt)
print("")
exit(0)
