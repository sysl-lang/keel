// `grep`: the lines holding a pattern, of a file or of standard input.

package {
  name    = "grep"
  version = "0.0.1"
}

dependencies {
  rt { workspace = true }
  fsys { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "../user.ld"
    entry         = "_start"
  }
}
