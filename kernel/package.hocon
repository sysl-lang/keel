// keel — a research kernel for aarch64, QEMU `virt`.

package {
  name    = "keel"
  version = "0.0.1"
}

// Kernel code never touches the FP/SIMD registers (exception entry need not save them, and nothing
// traps before the unit is enabled) and never makes an unaligned access (with the MMU off all memory
// is Device memory).
codegen {
  general_regs_only = true
  strict_align      = true
}

// The kernel heap (keel.heap) is the program's allocator: every box, `Buf`, `string` and closure is
// allocated through this pair. A freestanding target has no libc `malloc` to default to. The names are
// aliases link.ld defines for keel.heap's `keel_alloc` and `keel_free`: naming the exported functions
// themselves makes the compiler declare and define one symbol in one module (FINDINGS.md 19).
allocator {
  alloc = "keel_heap_alloc"
  free  = "keel_heap_free"
}

// The system call numbers and error codes, which user programs build against too.
dependencies {
  abi { workspace = true }
  ondisk { workspace = true }
}

targets {
  aarch64-freestanding {
    linker_script = "link.ld"
    entry         = "_start"
  }
}
