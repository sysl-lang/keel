module keel.cpu

// The processor's own state: the exception level, the system registers keel reads and writes, and
// the instructions that wait for or mask interrupts. A register is read and written with the
// `read_sysreg`/`write_sysreg` built-ins (DAIFSet and DAIFClr among them); what is still `asm` here is
// an instruction sysl has no spelling for (`at`, `tlbi`, `dc`, `ic`, `yield`, `wfi`).

// The exception level the processor is running at, 0 to 3 (CurrentEL bits [3:2]).
current_el() -> u64 = (read_sysreg("CurrentEL") >> 2) & 3

// Point exception entry at a vector table. The `isb` makes the new base take effect before the next
// instruction can fault.
set_vbar(base: u64)
    write_sysreg("vbar_el1", base)
    isb()

// The syndrome of the exception being handled: its class and the class's own details.
esr() -> u64 = read_sysreg("esr_el1")

// The faulting virtual address, for an abort or a misaligned PC or SP.
far() -> u64 = read_sysreg("far_el1")

// A register value as its fields and back. A `@packed` struct with narrow fields *is* one integer, but
// there is no conversion between the two (FINDINGS.md 8), so the value goes through memory.
to_word[T](v: T) -> u64
    @assert(sizeof(T) == 8, "a system register or a descriptor is 64 bits")
    var x = v
    val p: *u64 = ptr_cast(&x)
    *p

from_word[T](raw: u64) -> T
    @assert(sizeof(T) == 8, "a system register or a descriptor is 64 bits")
    var x = raw
    val p: *T = ptr_cast(&x)
    *p

// The registers that set up translation (Arm ARM D19.2). Writing one does not affect the instructions
// already in flight; `isb` below is what makes it take effect.
set_mair(v: u64) = write_sysreg("mair_el1", v)

tcr() -> u64 = read_sysreg("tcr_el1")

set_tcr(v: u64) = write_sysreg("tcr_el1", v)

set_ttbr0(v: u64) = write_sysreg("ttbr0_el1", v)

set_ttbr1(v: u64) = write_sysreg("ttbr1_el1", v)

sctlr() -> u64 = read_sysreg("sctlr_el1")

set_sctlr(v: u64)
    write_sysreg("sctlr_el1", v)
    isb()

// ID_AA64MMFR0_EL1: the physical address size [3:0] and which granules exist.
mmfr0() -> u64 = read_sysreg("id_aa64mmfr0_el1")

// CTR_EL0: DminLine [19:16] is log2 of the smallest data cache line, in words.
ctr() -> u64 = read_sysreg("ctr_el0")

// Ask the MMU to translate `va` as an EL1 read would, and answer PAR_EL1, which holds the result.
translate_read(va: u64) -> u64
    var v: u64 = 0
    asm
        [aarch64]
            "at s1e1r, {va}"
            "isb"
            "mrs {v}, par_el1"
            in va : reg
            out v : reg
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
    v

// Maintenance. The barriers are the `dsb(opt)` and `isb()` built-ins; TLB and cache maintenance have
// no spelling yet (FINDINGS.md 14), so each sequence that needs one is a block of its own.

// Forget every EL1 translation this core has cached, wait for that, and refetch.
flush_tlb()
    asm
        [aarch64]
            "dsb ishst"
            "tlbi vmalle1"
            "dsb nsh"
            "isb"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Forget every core's cached translation of the page at kernel address `va`, for every address space,
// and wait until every core has. Inner shareable, so it is already right once there is a second core.
flush_tlb_page(va: u64)
    val page = va >> 12
    asm
        [aarch64]
            "dsb ishst"
            "tlbi vaae1is, {page}"
            "dsb ish"
            "isb"
            in page : reg
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Forget every core's cached translation of user page `va` in the address space tagged `asid`.
flush_tlb_user_page(asid: u64, va: u64)
    val arg = (asid << 48) | ((va >> 12) & 0xFFF_FFFF_FFFF)
    asm
        [aarch64]
            "dsb ishst"
            "tlbi vae1is, {arg}"
            "dsb ish"
            "isb"
            in arg : reg
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Forget every core's cached translation tagged `asid`, before the ASID is given to another process.
flush_tlb_asid(asid: u64)
    val arg = asid << 48
    asm
        [aarch64]
            "dsb ishst"
            "tlbi aside1is, {arg}"
            "dsb ish"
            "isb"
            in arg : reg
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Write the data cache line holding `addr` back as far as the point the instruction fetches see, for
// code the kernel copied in through a data mapping.
clean_dcache_line_pou(addr: u64)
    asm
        [aarch64]
            "dc cvau, {addr}"
            in addr : reg
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Discard every core's instruction cache, after `clean_dcache_line_pou` over new code, and refetch.
sync_icache()
    asm
        [aarch64]
            "dsb ish"
            "ic ialluis"
            "dsb ish"
            "isb"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Make translation table writes visible to the walker before the next instruction uses them.
publish_tables()
    dsb(ishst)
    isb()

// TPIDR_EL1, a register the architecture leaves to the kernel: keel keeps the running core's `Cpu`
// record there (keel.sched), so each core finds its own without asking which core it is.
tpidr() -> u64 = read_sysreg("tpidr_el1")

set_tpidr(v: u64) = write_sysreg("tpidr_el1", v)

// MPIDR_EL1's affinity level 0: which core of its cluster this is. QEMU's `virt` numbers its cores
// 0, 1, 2, ... there.
core_id() -> u64 = read_sysreg("mpidr_el1") & 0xff

// One busy-wait step: an instruction the optimizer cannot remove, and a hint to the core that this is
// a spin.
relax()
    asm
        [aarch64] "yield"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Discard the data cache line holding `addr`, so the next cacheable read goes to memory.
invalidate_dcache_line(addr: u64)
    asm
        [aarch64]
            "dc ivac, {addr}"
            in addr : reg
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Write the data cache line holding `addr` back to memory and discard it, so neither a stale copy nor
// a later eviction can disagree with what a core whose caches are off writes there.
clean_invalidate_dcache_line(addr: u64)
    asm
        [aarch64]
            "dc civac, {addr}"
            in addr : reg
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

// Let IRQs in: clear PSTATE.I.
enable_irqs() = write_sysreg("daifclr", 2)

// Mask IRQs on this core and answer what DAIF held before, for `irq_restore`. What a lock an interrupt
// handler may also take is held under.
irq_save() -> u64
    val v = read_sysreg("daif")
    write_sysreg("daifset", 2)
    v

// Put DAIF back as `irq_save` found it.
irq_restore(daif: u64) = write_sysreg("daif", daif)

// Sleep until an interrupt is pending. The block clobbers memory, so whatever the loop around it
// reads is read again after it.
wait_for_interrupt()
    asm
        [aarch64] "wfi"
        [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"
