module keel.timer

// The EL1 virtual timer of the Arm generic timer. It counts the system counter at `CNTFRQ_EL0` ticks
// a second and raises private interrupt 27 when its countdown (`CNTV_TVAL_EL0`) reaches zero. Under
// HVF the virtual timer is the one the hypervisor gives the guest.

// The timer's interrupt ID at the GIC.
const IRQ: u32 = 27

// How many counter ticks one period is; set by `start`.
private var period: u64 = 0

// The system counter's frequency, in Hz.
private frequency() -> u64 = read_sysreg("cntfrq_el0")

// Count down `ticks` from now. Writing the countdown also clears a condition already met.
private set_countdown(ticks: u64)
    write_sysreg("cntv_tval_el0", ticks)
    isb()

// Bit 0 enables the timer; bit 1 would mask its interrupt.
private set_control(bits: u64)
    write_sysreg("cntv_ctl_el0", bits)
    isb()

// Raise the timer's interrupt every `ms` milliseconds. Each core has a timer of its own; the boot core
// sets the period, and the others start theirs with `start_this_core`.
start(ms: u64)
    period = frequency() * ms / 1000
    start_this_core()

// Start this core's timer at the period `start` set.
start_this_core()
    set_countdown(period)
    set_control(1)

// Milliseconds since the system counter started; the same on every core.
now_ms() -> u64 = read_sysreg("cntvct_el0") * 1000 / frequency()

// Begin the next period. The interrupt handler calls this, or the timer's condition stays met and the
// interrupt stays raised.
rearm() = set_countdown(period)
