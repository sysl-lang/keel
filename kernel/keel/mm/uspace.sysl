module keel.mm

import keel.cpu
import sysl.sync.SpinLock

// User address spaces: the low half, TTBR0, one per process.
//
//   0 .. USER_BASE                     never mapped, so a null pointer (and anything near it) faults
//   USER_BASE ..                       the program's segments, where its ELF image says (user/user.ld
//                                      links at USER_BASE), then the heap, which `brk` grows upward
//   .. MMAP_BASE                       the heap's limit
//   MMAP_BASE .. mmap_top()            what `mmap` hands out (mmap.sysl), top-down
//   stack_bottom - PAGE                the guard page: never mapped, so running off the stack faults
//   stack_bottom .. USER_STACK_TOP     the stack, USER_STACK_PAGES pages, mapped from the start
//   USER_STACK_TOP .. 2^48             unmapped
//
// Every page is mapped from a frame (its own, until a fork shares it), with user access, never executable at EL1, and
// not-global: its translations are tagged with the space's ASID, so a switch between processes changes
// TTBR0 and nothing has to be flushed. The tables themselves are frames too, reached through the
// kernel's linear map of RAM (to_virt), and a space's every frame goes back when it is freed — a page
// frame shared with a forked relative (cow.sysl) only once its last sharer lets it go.
//
// Kernel threads run with TTBR0 at `empty_root`, a table with nothing in it, and ASID 0, which no
// process is given: the low half faults for them exactly as it did before there were processes.

const USER_BASE: u64 = 0x40_0000
const USER_STACK_TOP: u64 = 0x1_0000_0000           // 4 GiB
const USER_STACK_PAGES: u64 = 16                    // 64 KiB
const PAGE_SIZE: u64 = 4096

stack_bottom() -> u64 = USER_STACK_TOP - USER_STACK_PAGES * PAGE_SIZE

// How far the stack may grow, as Linux's default RLIMIT_STACK: 8 MiB. Below stack_bottom() its pages are
// mapped the first time the program touches them (a translation fault, keel.proc's `user_sync`). A
// system call is not the program touching them: `user_range` does not grow the stack, and a pointer
// below what is mapped is EFAULT — as on Linux since 6.5, whose get_user_pages stopped expanding stacks.
const USER_STACK_MAX: u64 = 8 * 1024 * 1024

stack_limit() -> u64 = USER_STACK_TOP - USER_STACK_MAX

// Off only to show what growing is for: without it the stack is its first 64 KiB and no more, and
// busybox's interactive shell, whose line editor keeps its buffers on the stack, dies of SIGSEGV.
private const GROW_STACK: bool = true

// Map a zeroed page for the stack at `va` if it lies where the stack may grow and nothing is mapped
// there yet; whether the page is there now.
grow_stack(s: *Space, va: u64) -> bool
    if !GROW_STACK || va < stack_limit() || va >= USER_STACK_TOP then return false
    val flags = cpu.irq_save()
    grow_lock.lock()
    val page = va & ~(PAGE_SIZE - 1)
    val done = page_in_use(s, page) || map_user_page(s, page, UserProt(true, false)).is_some()
    grow_lock.unlock()
    cpu.irq_restore(flags)
    done

// Two threads of a process may fault below its stack at once: one maps the page, the other finds it.
private var grow_lock: SpinLock = SpinLock(0)

// The highest address a segment or the heap may reach: where mmap's window begins (mmap.sysl).
heap_limit() -> u64 = MMAP_BASE

// One process's translation tables.
struct Space
    root: PhysAddr              // the level-0 table
    asid: u64                   // 1..255
    pages: u64                  // pages mapped, tables not counted

// What a user page allows. Every user page is readable; whether it may be written or executed is the
// segment's to say.
struct UserProt
    write: bool
    exec: bool

// A fresh space with nothing mapped, or None when there is no frame or no ASID for it.
new_space() -> Option[Space]
    val asid = alloc_asid() match
        Some(a) -> a
        None -> return None
    zeroed_frame() match
        Some(root) -> Some(Space(root, asid, 0))
        None ->
            free_asid(asid)
            None

// What TTBR0 holds while the space's process runs.
ttbr0_of(s: *Space) -> u64 = cpu.to_word(Ttbr(0, 0, frame_of(s.root), u16(s.asid)))

// Map one page at `va` (page aligned) to a new zeroed frame, and answer the frame. A page already
// mapped there keeps its frame, and is widened to allow whatever `prot` allows besides: two ELF segments
// may share a page.
map_user_page(s: *Space, va: u64, prot: UserProt) -> Option[PhysAddr]
    val slot = leaf_slot(s, va, true) match
        Some(p) -> p
        None -> return None
    if *slot != 0
        var old: LeafDesc = cpu.from_word(*slot)
        val was_write = old.ap == UserRw
        val was_exec = old.uxn == 0
        old.ap = if was_write || prot.write then UserRw else UserRo
        old.uxn = if was_exec || prot.exec then u1(0) else u1(1)
        *slot = cpu.to_word(old)
        flush_user_page(s, va)
        return Some(frame_addr(old.oa))
    val pa = zeroed_frame() match
        Some(p) -> p
        None -> return None
    *slot = cpu.to_word(user_leaf(pa, prot))
    s.pages += 1
    cpu.publish_tables()
    Some(pa)

// Take the page at `va` away and give its frame back; nothing happens if none is mapped there.
unmap_user_page(s: *Space, va: u64)
    val slot = leaf_slot(s, va, false) match
        Some(p) -> p
        None -> return
    if *slot == 0 then return
    val leaf: LeafDesc = cpu.from_word(*slot)
    *slot = 0
    flush_user_page(s, va)
    release_frame(leaf.oa)
    s.pages -= 1

// Where `va` leads in this space, if it is mapped: the physical address of the byte, and whether a user
// program may write it. A walk of the space's own tables, which is what a system call checks a pointer
// against.
user_translate(s: *Space, va: u64) -> Option[(PhysAddr, bool)]
    if va >= USER_STACK_TOP then return None
    val slot = leaf_slot(s, va & ~(PAGE_SIZE - 1), false) match
        Some(p) -> p
        None -> return None
    if *slot == 0 then return None
    val leaf: LeafDesc = cpu.from_word(*slot)
    // A PROT_NONE page (mmap.sysl) is there, but not the program's to use.
    if leaf.ap != UserRw && leaf.ap != UserRo then return None
    Some((frame_addr(leaf.oa) + (va & (PAGE_SIZE - 1)), leaf.ap == UserRw))

// Copy `dst.len` bytes in from user address `va` of space `s`, or answer false and copy nothing when
// any of them is not user memory of the space. The bytes are read through the kernel's linear map at the
// physical address the space's own tables give: a user address is never dereferenced.
copy_from_user(s: *Space, va: u64, dst: []u8) -> bool
    if !user_range(s, va, u64(dst.len), false) then return false
    var done: usize = 0
    while done < dst.len
        val a = va + u64(done)
        val chunk = min_usize(dst.len - done, usize(PAGE_SIZE - (a & (PAGE_SIZE - 1))))
        val src: *u8 = ptr_cast(usize(u64(to_virt(translated(s, a)))))
        for i in 0..<chunk
            dst[done + i] = src[i]
        done += chunk
    true

// Copy `src` out to user address `va` of space `s`, or answer false and copy nothing when any byte of
// the destination is not user memory the program may write.
copy_to_user(s: *Space, va: u64, src: []const u8) -> bool
    if !user_range(s, va, u64(src.len), true) then return false
    var done: usize = 0
    while done < src.len
        val a = va + u64(done)
        val chunk = min_usize(src.len - done, usize(PAGE_SIZE - (a & (PAGE_SIZE - 1))))
        val dst: *u8 = ptr_cast(usize(u64(to_virt(translated(s, a)))))
        for i in 0..<chunk
            dst[i] = src[done + i]
        done += chunk
    true

// Copy a NUL-terminated string in from user address `va` of space `s`, at most `dst.len` bytes with its
// NUL: Some of its length without the NUL, Some(dst.len) when no NUL came within that many bytes, or None
// when the bytes before the NUL are not all user memory. Read a page at a time, so a string that ends
// just before an unmapped page is read without touching it.
copy_cstr_from_user(s: *Space, va: u64, dst: []u8) -> Option[usize]
    var done: usize = 0
    while done < dst.len
        val a = va + u64(done)
        if !user_range(s, a, 1, false) then return None
        val chunk = min_usize(dst.len - done, usize(PAGE_SIZE - (a & (PAGE_SIZE - 1))))
        val src: *u8 = ptr_cast(usize(u64(to_virt(translated(s, a)))))
        for i in 0..<chunk
            dst[done + i] = src[i]
            if src[i] == 0 then return Some(done + i)
        done += chunk
    Some(dst.len)

// Whether all of `len` bytes from `va` are user memory of this space — inside the user range with no
// wrap around, every page mapped, and writable where `write` asks. A copy-on-write page is writable: it
// is given its own frame here, before the kernel writes it, as the program's own write would have been.
user_range(s: *Space, va: u64, len: u64, write: bool) -> bool
    if len == 0 then return true
    if va >= USER_STACK_TOP || len > USER_STACK_TOP - va then return false
    var page = va & ~(PAGE_SIZE - 1)
    while page < va + len
        val ok = user_translate(s, page) match
            Some((_, writable)) -> writable || !write || break_cow(s, page)
            None -> false
        if !ok then return false
        page += PAGE_SIZE
    true

private translated(s: *Space, va: u64) -> PhysAddr = user_translate(s, va) match
    Some((pa, _)) -> pa
    None -> panic("keel.mm: a user page went away under a copy")

private min_usize(a: usize, b: usize) -> usize = if a < b then a else b

// Give every frame of the space back — its pages, its tables, its root — and its ASID, after flushing
// whatever translations any core still caches under it. No core may be running the space.
free_space(s: *Space)
    free_level(s.root, 0)
    cpu.flush_tlb_asid(s.asid)
    free_asid(s.asid)
    s.pages = 0

private free_level(table: PhysAddr, level: u64)
    val t = table_of(table)
    for i in 0..<512
        val word = t.entries[i]
        if word == 0 then continue
        if level == 3
            val leaf: LeafDesc = cpu.from_word(word)
            release_frame(leaf.oa)
        else
            val d: TableDesc = cpu.from_word(word)
            free_level(frame_addr(d.next), level + 1)
    free_frame(frame_of(table))

// The level-3 entry for `va`, adding the tables on the way down when `create` says so. None when a table
// is missing and may not be added, or there is no frame for one.
private[mm] leaf_slot(s: *Space, va: u64, create: bool) -> Option[*u64]
    var t = table_of(s.root)
    var level: u64 = 0
    while level < 3
        val slot = &t.entries[user_index(va, level)]
        if *slot == 0
            if !create then return None
            val next = zeroed_frame() match
                Some(p) -> p
                None -> return None
            *slot = cpu.to_word(table_desc(next))
            t = table_of(next)
        else
            val d: TableDesc = cpu.from_word(*slot)
            t = table_of(frame_addr(d.next))
        level += 1
    Some(&t.entries[user_index(va, 3)])

private user_index(va: u64, level: u64) -> usize = usize((va >> (39 - 9 * level)) & 511)

// A table (or any frame) through the kernel's linear map of RAM.
private[mm] table_of(p: PhysAddr) -> *Table = ptr_cast(usize(u64(to_virt(p))))

private[mm] zeroed_frame() -> Option[PhysAddr]
    alloc_frame() match
        Some(f) ->
            val pa = frame_addr(f)
            val t = table_of(pa)
            for i in 0..<512
                t.entries[i] = 0
            Some(pa)
        None -> None

// A page descriptor for user memory: Normal, inner shareable, readable at EL0, never executable at EL1,
// and tagged with the ASID.
private user_leaf(pa: PhysAddr, prot: UserProt) -> LeafDesc
    val access = if prot.write then UserRw else UserRo
    val uxn = if prot.exec then u1(0) else u1(1)
    LeafDesc(1, 1, Normal, 0, access, Inner, 1, 1, frame_of(pa), 0, 0, 0, 0, 1, uxn, 0, 0)

private[mm] flush_user_page(s: *Space, va: u64) = cpu.flush_tlb_user_page(s.asid, va)

// ASIDs: 8 bits (TCR_EL1.AS = 0), 0 kept for the kernel's empty TTBR0, so 255 processes at once. A
// freed ASID is reused only after `free_space` flushed it from every core's TLB, so no generations.
private var asid_lock: SpinLock = SpinLock(0)
private var asids: [4]u64 = [1, 0, 0, 0]               // bit n: ASID n is taken; ASID 0 always

private alloc_asid() -> Option[u64]
    val flags = cpu.irq_save()
    asid_lock.lock()
    var found: Option[u64] = None
    for i in 0..<256
        val w = usize(i / 64)
        val bit = u64(1) << u64(i % 64)
        if asids[w] & bit == 0
            asids[w] |= bit
            found = Some(u64(i))
            break
    asid_lock.unlock()
    cpu.irq_restore(flags)
    found

private free_asid(a: u64)
    val flags = cpu.irq_save()
    asid_lock.lock()
    asids[usize(a / 64)] &= ~(u64(1) << (a % 64))
    asid_lock.unlock()
    cpu.irq_restore(flags)

// How many ASIDs processes hold right now.
asids_in_use() -> u64
    var n: u64 = 0
    for i in 1..<256
        if asids[usize(i / 64)] & (u64(1) << u64(i % 64)) != 0 then n += 1
    n

// The empty level-0 table kernel threads run with in TTBR0, and the TTBR0 value naming it (ASID 0).
// Made by `drop_identity` on the boot core, before any other core is up.
private[mm] var empty_root: PhysAddr = PhysAddr(0)

kernel_ttbr0() -> u64 = cpu.to_word(Ttbr(0, 0, frame_of(empty_root), 0))
