module keel.kfs

// KFS's platform in the kernel (kfs/SPEC.md sections 19 and 27): section 19's locks as keel.sched's,
// with their order checked on every acquisition; the clocks; the `kfs-commit` thread's hooks; and the
// clock of operations the caches are stamped with.
//
// **The locks.** The package names a lock (`LockId`) and never holds one, so the platform keeps them:
//
//   rename_lock, orphans.lock, inode.lock (per inode), group[g].lock, buffer.lock (per block)
//                         sleeping — a thread that finds one held sleeps on its wait queue, and the
//                         unlock hands the lock straight to the first sleeper, as keel.sched's Mutex does
//   journal.lock, cache.lock, icache.lock
//                         spinning, with this core's interrupts masked: leaves, held for a few
//                         instructions and never across a sleep
//
// A sleeping lock lives in a table entry for as long as a thread holds it or waits for it, found by kind
// and key under one IrqLock, so a lock for each of 2^64 blocks costs nothing until it is taken. A
// directory's lock and the same inode's ordinary lock are one entry (`Dir(n)` and `Inode(n)` name the
// rule they are taken under, not two locks).
//
// **The order** of section 19 is checked on every acquisition against what the calling thread already
// holds, by the same rules as the host platform's (`rank` in the package): a lock may be taken only while
// every lock held ranks strictly lower, except directories (rank 2) held together and non-directories
// (rank 3) held together in increasing number; an inode's lock taken again under either name, two group
// locks, or anything taken under a leaf is a violation, and keel stops (`keel.kfs: a lock taken out of
// section 19's order`). Each thread's held locks are a short list in a table keyed by the thread, an
// entry living while the list is not empty.
//
// **The commit thread** (kfs.sysl) is woken by `wake_committer`, which answers false while it runs, so
// a handle waiting for log room sleeps in `wait_for_commit` until the thread has made a pass: every pass
// bumps a generation and wakes the waiters, and a waiter returns once the generation has moved past the
// one it saw. With no commit thread (before it starts, and after it is stopped) `wake_committer` answers
// true and the caller commits inline, as on the host.
//
// **The clock of operations** (`stamp`) is what makes it safe to drop cached records while other cores
// use the filesystem. Every operation the kernel runs on KFS registers at its start (`begin_op`), taking
// the clock's current reading as its start and moving it on; every lookup of a buffer or an inode record
// is stamped with the clock's reading then, which is later than the start of the operation doing it. A
// record stamped before the start of the oldest operation still running is held by none of them
// (`oldest_op`), and only such a record is dropped.

import sh.sysl.kfs.{Fatal, LockId, Platform, Time, rank}
import keel.sched
import keel.sched.{IrqLock, Thread, WaitQueue}
import keel.timer
import sysl.sync.{Atomic, Ordering}

// -- Sleeping locks --------------------------------------------------------------------------------------

private const KIND_RENAME: u32 = 1
private const KIND_INODE: u32 = 2
private const KIND_ORPHANS: u32 = 3
private const KIND_GROUP: u32 = 4
private const KIND_BUFFER: u32 = 5

private const SLEEPERS: usize = 256

private struct Sleeper
    kind: u32                                   // 0: a free entry
    key: u64
    users: u32                                  // the holder and every thread waiting for it
    held: bool
    waiters: WaitQueue

private var sleepers: [SLEEPERS]Sleeper
private var sleepers_guard: IrqLock
// The most sleeping locks held or waited for at once, and how many acquisitions had to sleep.
private var sleepers_most: u64
private var sleeps: u64

private kind_of(l: LockId) -> u32 = l match
    LockId.Rename -> KIND_RENAME
    LockId.Dir(_) -> KIND_INODE
    LockId.Inode(_) -> KIND_INODE
    LockId.Orphans -> KIND_ORPHANS
    LockId.Group(_) -> KIND_GROUP
    LockId.Buffer(_) -> KIND_BUFFER
    _ -> 0

// A sleeping lock's key within its kind; for a leaf, which leaf (0 journal, 1 cache, 2 icache), so a
// report of what a thread holds can name it.
private key_of(l: LockId) -> u64 = l match
    LockId.Dir(i) -> i
    LockId.Inode(i) -> i
    LockId.Group(g) -> u64(g)
    LockId.Buffer(b) -> b
    LockId.Journal -> 0
    LockId.Cache -> 1
    LockId.Icache -> 2
    _ -> 0

// The entry for (kind, key), claimed if no thread holds or waits for it. Under `sleepers_guard`.
private entry(kind: u32, key: u64) -> *Sleeper
    var free: *Sleeper = null
    var live: u64 = 0
    for i in 0..<SLEEPERS
        val e = &sleepers[i]
        if e.kind == kind && e.key == key then return e
        if e.kind == 0
            if free == null then free = e
        else
            live += 1
    if free == null then panic("keel.kfs: more sleeping locks in use at once than the table holds")
    if live + 1 > sleepers_most then sleepers_most = live + 1
    free.kind = kind
    free.key = key
    free.users = 0
    free.held = false
    free

private lock_sleeping(kind: u32, key: u64)
    val flags = sleepers_guard.lock()
    val e = entry(kind, key)
    e.users += 1
    if e.held
        sleeps += 1
        // The unlock hands the lock over: `held` stays true.
        e.waiters.sleep(&sleepers_guard)
    else
        e.held = true
    sleepers_guard.unlock(flags)

private unlock_sleeping(kind: u32, key: u64)
    val flags = sleepers_guard.lock()
    var e: *Sleeper = null
    for i in 0..<SLEEPERS
        val s = &sleepers[i]
        if s.kind == kind && s.key == key then e = s
    if e == null || !e.held then panic("keel.kfs: a sleeping lock released that is not held")
    if !e.waiters.wake_one() then e.held = false
    e.users -= 1
    if e.users == 0 then e.kind = 0
    sleepers_guard.unlock(flags)

// -- Spinning leaves ---------------------------------------------------------------------------------

private struct Leaf
    lock: IrqLock
    flags: u64                                  // what `unlock` puts back; written by the holder

private var leaves: [3]Leaf

private leaf_of(l: LockId) -> usize = l match
    LockId.Journal -> 0
    LockId.Cache -> 1
    _ -> 2

// -- The order -----------------------------------------------------------------------------------------

private const HOLDERS: usize = 32
private const MOST_HELD: usize = 16

private struct Holder
    thread: usize                               // 0: a free entry
    n: usize
    ranks: [MOST_HELD]u32
    keys: [MOST_HELD]u64

private var holders: [HOLDERS]Holder
private var holders_guard: IrqLock
// Acquisitions checked, and the most locks one thread held at once.
private var checked: u64
private var most_held: u64

// Off only to show what the check is for: with it off, `scripts/boot-test.sh` still passes, and a lock
// taken out of order would deadlock some later run instead of stopping this one at the line that did it.
private const CHECK_ORDER: bool = true

// Whether the thread `sched.current()` answered is the one running this code: its stack holds this
// frame. (A diagnostic while a misattributed lock is hunted.)
private var wrong_current: Atomic[u64] = Atomic(0)

private on_own_stack(t: *Thread) -> bool
    var probe: u64 = 0
    val here = u64(usize(&probe))
    t.stack match
        Some(s) -> here <= u64(s.top) && here + 16384 >= u64(s.top)
        None -> true

wrong_currents() -> u64 = wrong_current.load()

// Check that the calling thread may take `l` now, and record that it holds it.
private take(l: LockId)
    val cur = sched.current()
    if !on_own_stack(cur)
        wrong_current.add(1)
        print("keel.kfs: current() is not the running thread")
    val me = usize(cur)
    val r = rank(l)
    val k = key_of(l)
    val flags = holders_guard.lock()
    var h: *Holder = null
    var free: *Holder = null
    for i in 0..<HOLDERS
        val e = &holders[i]
        if e.thread == me then h = e
        if e.thread == 0 && free == null then free = e
    failing(me, r, k, h)
    if h == null
        if free == null then fail_order(flags, "more threads hold KFS locks at once than the table holds")
        h = free
        h.thread = me
        h.n = 0
    failing_held = h
    checked += 1
    if CHECK_ORDER
        for i in 0..<h.n
            val hr = h.ranks[i]
            val hk = h.keys[i]
            if (hr == 2 || hr == 3) && (r == 2 || r == 3) && hk == k
                fail_order(flags, "an inode's lock taken while it is held")
            val together = (hr == 2 && r == 2) || (hr == 3 && r == 3 && hk < k)
            if hr >= r && !together then fail_order(flags, "a lock taken out of section 19's order")
    if h.n == MOST_HELD then fail_order(flags, "one thread holds more KFS locks than the table holds")
    h.ranks[h.n] = r
    h.keys[h.n] = k
    h.n += 1
    if u64(h.n) > most_held then most_held = u64(h.n)
    holders_guard.unlock(flags)

// Record that the calling thread no longer holds `l`.
private give(l: LockId)
    val me = usize(sched.current())
    val r = rank(l)
    val k = key_of(l)
    val flags = holders_guard.lock()
    var h: *Holder = null
    for i in 0..<HOLDERS
        if holders[i].thread == me then h = &holders[i]
    failing(me, r, k, h)
    if h == null then fail_order(flags, "a lock released by a thread holding none")
    var found = false
    var i = h.n
    while i > 0 && !found
        i -= 1
        if h.ranks[i] == r && h.keys[i] == k
            for j in i..<h.n - 1
                h.ranks[j] = h.ranks[j + 1]
                h.keys[j] = h.keys[j + 1]
            h.n -= 1
            found = true
    if !found then fail_order(flags, "a lock released that the thread does not hold")
    if h.n == 0 then h.thread = 0
    holders_guard.unlock(flags)

// What `fail_order` reports besides why: the thread, the lock it was taking or releasing, and what the
// thread held. Written under `holders_guard` just before a failure.
private var failing_thread: usize
private var failing_rank: u32
private var failing_key: u64
private var failing_held: *Holder

private failing(me: usize, r: u32, k: u64, h: *Holder)
    failing_thread = me
    failing_rank = r
    failing_key = k
    failing_held = h

private fail_order(flags: u64, why: string) -> never
    print("keel.kfs:", why, "— thread", failing_thread, "lock rank", failing_rank, "key", failing_key)
    val h = failing_held
    if h != null
        for j in 0..<h.n
            print("keel.kfs:   holding rank", h.ranks[j], "key", h.keys[j])
    for i in 0..<HOLDERS
        val e = &holders[i]
        if e.thread != 0
            print("keel.kfs:   thread", e.thread, "holds", e.n)
            for j in 0..<e.n
                print("keel.kfs:     rank", e.ranks[j], "key", e.keys[j])
    holders_guard.unlock(flags)
    panic("keel.kfs: a lock taken out of section 19's order")

// What the lock layer has done: acquisitions checked, the most locks one thread held at once, the most
// sleeping locks in use at once, and acquisitions that slept.
lock_stats() -> (u64, u64, u64, u64)
    val f1 = holders_guard.lock()
    val a = checked
    val b = most_held
    holders_guard.unlock(f1)
    val f2 = sleepers_guard.lock()
    val c = sleepers_most
    val d = sleeps
    sleepers_guard.unlock(f2)
    (a, b, c, d)

// The commit thread, by address (0 while none runs). It takes buffer locks and the journal leaf in the
// middle of every pass, whatever the operations are doing, so between operations it may legitimately
// hold one; nothing else may.
private var committer_thread: Atomic[u64] = Atomic(0)
private[kfs] set_committer_thread(t: u64) = committer_thread.store(t, Ordering.Release)

// The KFS locks held — or waited for, since a lock is recorded before it is taken — by every thread but
// the commit thread: none, between operations. Once the commit thread has stopped, every thread's.
locks_held() -> u64
    val committer = usize(committer_thread.load(Ordering.Acquire))
    val flags = holders_guard.lock()
    var n: u64 = 0
    for i in 0..<HOLDERS
        if holders[i].thread != committer || committer == 0 then n += u64(holders[i].n)
    holders_guard.unlock(flags)
    n

// Section 19's name for a lock, by the rank and key the order check recorded.
private lock_name(r: u32, k: u64) -> string = r match
    1 -> "rename_lock"
    2 -> "inode.lock (directory)"
    3 -> "inode.lock"
    5 -> "orphans.lock"
    6 -> "group.lock"
    7 -> "buffer.lock"
    8 -> k match
        0 -> "journal.lock"
        1 -> "cache.lock"
        _ -> "icache.lock"
    _ -> "an unranked lock"

// Print every KFS lock a thread holds or waits for, naming the thread (the commit thread as such) and the
// core it is on: what a failed `locks_held` check reports. Answers how many it printed.
locks_report() -> u64
    val committer = usize(committer_thread.load(Ordering.Acquire))
    val flags = holders_guard.lock()
    var n: u64 = 0
    for i in 0..<HOLDERS
        val e = &holders[i]
        if e.thread != 0
            n += u64(e.n)
            print("keel.kfs: thread", e.thread, if e.thread == committer then "(kfs-commit)" else "(an operation's)",
                  "on core", sched.core_running(e.thread), "holds or waits for", e.n)
            for j in 0..<e.n
                print("keel.kfs:   ", lock_name(e.ranks[j], e.keys[j]), "key", e.keys[j])
    holders_guard.unlock(flags)
    n

// -- The commit thread's hooks ----------------------------------------------------------------------------

// Whether the commit thread runs (1); while it does, `wake_committer` answers false.
private var committer_up: Atomic[u32] = Atomic(0)
// Set (1) to ask the commit thread for a pass; it naps on this flag.
private var kick: Atomic[u32] = Atomic(0)
// Passes the commit thread has finished, those that moved the journal on, and the waiters for either.
private var passes: u64
private var moves: u64
private var pass_waiters: WaitQueue
private var pass_guard: IrqLock

// Ask the commit thread for a pass now.
private nudge()
    kick.store(1, Ordering.Release)
    sched.wake_nappers()

// The commit thread finished a pass, which moved the journal on or not: wake whoever waits.
private[kfs] pass_done(moved: bool)
    val flags = pass_guard.lock()
    passes += 1
    if moved then moves += 1
    val _ = pass_waiters.wake_all()
    pass_guard.unlock(flags)

// Sleep until the journal has moved on — a commit or a checkpoint finished — or, should the move this
// waits for have come before the call, until two whole passes have gone by without one (the second, if
// no handle asks for it sooner, a timed one: PASS_MS). The caller then looks again. Waiting for a move
// rather than for any pass keeps a handle that cannot join until others leave from spinning the commit
// thread through empty passes.
private[kfs] wait_for_pass()
    val flags = pass_guard.lock()
    val moved = moves
    val target = passes + 2
    nudge()
    while moves == moved && passes < target && committer_up.load(Ordering.Acquire) != 0
        pass_waiters.sleep(&pass_guard)
    pass_guard.unlock(flags)

private[kfs] set_committer(up: bool) = committer_up.store(if up then 1 else 0, Ordering.Release)
private[kfs] kicked() -> *Atomic[u32] = &kick

// -- The clock of operations ----------------------------------------------------------------------------

private const OPS: usize = 64

private var clock: u64 = 1
private var op_starts: [OPS]u64                 // 0: a free entry
private var ops_guard: IrqLock

// Register an operation starting now; the answer is what `end_op` takes.
private[kfs] begin_op() -> usize
    val flags = ops_guard.lock()
    for i in 0..<OPS
        if op_starts[i] == 0
            op_starts[i] = clock
            clock += 1
            ops_guard.unlock(flags)
            return i
    ops_guard.unlock(flags)
    panic("keel.kfs: more operations at once than the table holds")

private[kfs] end_op(i: usize)
    val flags = ops_guard.lock()
    op_starts[i] = 0
    ops_guard.unlock(flags)

// The start of the oldest operation still running, or the clock's reading if none is: a record stamped
// before it is held by no operation.
private[kfs] oldest_op() -> u64
    val flags = ops_guard.lock()
    var oldest = clock
    for i in 0..<OPS
        if op_starts[i] != 0 && op_starts[i] < oldest then oldest = op_starts[i]
    ops_guard.unlock(flags)
    oldest

private read_clock() -> u64
    val flags = ops_guard.lock()
    val now = clock
    ops_guard.unlock(flags)
    now

// -- The platform ---------------------------------------------------------------------------------------

// The cache sizes the kernel gives the package's tables (kfs.sysl keeps what lives within them).
const BUFFER_SLOTS: usize = 2048
const INODE_SLOTS: usize = 1024

struct KernelPlatform
    // Which mount this platform serves; one at a time (kfs.sysl).
    mount: u32

impl Platform for KernelPlatform
    lock(*self, l: LockId)
        take(l)
        val kind = kind_of(l)
        if kind != 0
            lock_sleeping(kind, key_of(l))
        else
            val i = leaf_of(l)
            val f = leaves[i].lock.lock()
            leaves[i].flags = f

    unlock(*self, l: LockId)
        val kind = kind_of(l)
        if kind != 0
            unlock_sleeping(kind, key_of(l))
        else
            val i = leaf_of(l)
            val f = leaves[i].flags
            leaves[i].lock.unlock(f)
        give(l)

    now(*self) -> Time
        val ns = timer.realtime_ns()
        Time(i64(ns / 1_000_000_000), u32(ns % 1_000_000_000))

    monotonic_ms(*self) -> u64 = timer.now_ns() / 1_000_000

    wake_committer(*self) -> bool
        if committer_up.load(Ordering.Acquire) == 0 then return true
        nudge()
        false

    wait_for_commit(*self) = wait_for_pass()

    fatal(*self, f: Fatal)
        f match
            Fatal.CreditOverrun(op, n) -> print("keel.kfs: operation", op, "went past its", n, "credits")
            Fatal.RevokeOverrun(op, n) -> print("keel.kfs: operation", op, "revoked past its", n, "credits")
            Fatal.Deadlock(op) -> print("keel.kfs: operation", op, "waits for log room nothing can make")
            Fatal.LogOverrun(seq) -> print("keel.kfs: transaction", seq, "overran the log")
            Fatal.TableFull(what) -> print("keel.kfs: the", what, "is full")
        panic("keel.kfs: a bug in KFS")

    override stamp(*self) -> u64 = read_clock()
    override buffer_slots(self) -> usize = BUFFER_SLOTS
    override inode_slots(self) -> usize = INODE_SLOTS
