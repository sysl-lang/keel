module keel.proc

import abi.keel.abi.{FpRegs, SIGBUS, SIGFPE, SIGILL, SIGKILL, SIGSEGV, SIGTRAP, no_fp}
import keel.console
import keel.cpu
import keel.fs
import keel.mm
import keel.sched
import keel.sched.{Context, Cred, OpenFile, Process}
import sysl.sync.{Atomic, Ordering}

// User processes: made from an ELF image, run by kernel threads of their own — one to start with, more
// by `clone` (fork.sysl; keel.sched's group.sysl) — and ended when the last of them ends: by `exit`, or
// all at once by `exit_group`, a fatal signal, a fault, or `kill`.
//
// Each thread enters user mode from `run` and stays there: every system call, interrupt and fault it
// takes is handled on its kernel stack, below `run`'s frame, and returns to EL0. When the thread ends,
// `keel_leave_user` (user.sysl) unwinds straight back to `run`, which drops the address space from
// TTBR0, zeroes and wakes the word `set_tid_address` named, and — for the last thread out — closes the
// process's files and tells the process table (family.sysl); then the thread ends as any kernel thread
// does. Whoever started the process waits for it — the kernel with `wait`, a parent process with the
// `wait` system call — and that joins its threads and frees the address space.

private var next_pid: Atomic[u64] = Atomic(1)

// Start the program at `path` on the filesystem with no arguments, as a process the kernel waits for.
start(path: string) -> Result[&sync Process, LoadError] = start_with(path, [])

// Start the program at `path` with `args` — its argv, the program's name first by convention.
// The kernel's processes run as root.
start_with(path: string, args: []const string) -> Result[&sync Process, LoadError]
    val image = fs.read_executable("/".bytes, path.bytes, sched.root_cred()) match
        Ok(b) -> b
        Err(e) -> return Err(Unreadable(e))
    val p = start_image(image.bytes.view(), args, null, [sched.console_file(); 3], [], image.run_as,
        Group(NEW_GROUP, false))?
    // A program started with no arguments is named for its file, for `procs`.
    if args.len == 0 then p.name = sched.name_of(base_name(path.bytes))
    Ok(p)

// The last part of a path: what follows its last `/`.
private base_name(path: []const u8) -> []const u8
    var start: usize = 0
    for i in 0..<path.len
        if path[i] == u8('/') then start = i + 1
    path[start..]

// The next process's pid.
private[proc] new_pid() -> u64 = next_pid.add(1)

// Number processes from 1 again: init is pid 1. Only while there are none, which it answers.
restart_pids() -> bool
    if !table_empty() then return false
    next_pid.store(1, Ordering.Release)
    true

// Load `image`, an executable already in kernel memory, and start it running with `args` and the
// environment `env` (`NAME=value` entries, each followed by a NUL). A `parent` (null: the kernel)
// passes on its current directory. `std` are the child's descriptors 0 to 2, each already counted as
// open (`duplicate`); they are given back if the child cannot be started. It runs as `run_as`, in the
// process group `group` says. The process is in the table before its thread can run.
private[proc] start_image(image: []const u8, args: []const string, parent: *Process, std: [3]OpenFile,
        env: []const u8, run_as: Cred, group: Group) -> Result[&sync Process, LoadError]
    val started = start_loaded(image, args, parent, std, env, run_as, group)
    if started.is_err()
        // The descriptors handed over for the child are not the child's after all.
        for f in std
            release(f)
    started

// Which process group a new process goes in: `pgid` — INHERIT_GROUP for its parent's, NEW_GROUP for
// one of its own — and whether that group becomes the console's foreground group before it runs.
struct Group
    pgid: u64
    foreground: bool

// Off only to show what SPAWN_FOREGROUND is for: with it off the console's foreground group stays the
// shell's, a Ctrl-C goes to the shell (which ignores it), and the job it was meant for runs on.
private const FOREGROUND_AT_SPAWN: bool = true

private[proc] const INHERIT_GROUP: u64 = 0
private[proc] const NEW_GROUP: u64 = 0xffff_ffff_ffff_ffff

private start_loaded(image: []const u8, args: []const string, parent: *Process, std: [3]OpenFile,
        env: []const u8, run_as: Cred, group: Group) -> Result[&sync Process, LoadError]
    if env.len > sched.ENV_ROOM then return Err(TooManyArgs)
    var l = load(image)?
    val sp = lay_out_args(&l.space, args, env) match
        Some(sp) -> sp
        None ->
            mm.free_space(&l.space)
            return Err(TooManyArgs)
    // The descriptors are filled in once the process is in its box: a kernel stack is 16 KiB, and every
    // copy of a Process made on the way to the box is more than a KiB of it.
    val pid = new_pid()
    val p: &sync Process = Process(pid, l.space, l.heap_base, l.heap_base, sched.no_threads(),
        sched.fresh_signals(), 0, 0, 0, sched.no_files(), sched.root_dir(), 1, 0, false, None, run_as.uid,
        run_as.gid, sched.env_of(env), pid, pid, 0, name_from(args), 0, 0, 0)
    val raw: *Process = &*p
    set_standard(raw, std)
    if parent != null
        raw.ppid = parent.pid
        raw.cwd = parent.cwd
        raw.cwd_len = parent.cwd_len
        raw.sid = parent.sid
        if group.pgid == INHERIT_GROUP then raw.pgid = parent.pgid
    if group.pgid != INHERIT_GROUP && group.pgid != NEW_GROUP then raw.pgid = group.pgid
    if group.foreground && FOREGROUND_AT_SPAWN then console.set_foreground(raw.pgid)
    if !enter(p)
        // Not the child's after all: start_image gives them back.
        set_standard(raw, [sched.free_file(); 3])
        mm.free_space(&raw.space)
        return Err(NoRoom)
    val regs = fresh_regs(l.entry, sp, 0)
    start_first_thread(raw, () -> run(raw, regs), 0, 0, no_fp())
    Ok(p)

// Start a new process's first thread, whose id is the pid, with TPIDR_EL0 `tls`, the blocked set
// `blocked` and the FP/SIMD registers `fp`. A process with no threads yet always has room for one.
@crossing(f)
private[proc] start_first_thread(p: *Process, f: &sync Fn() -> unit, tls: u64, blocked: u64, fp: FpRegs)
    sched.spawn_user(p, f, p.pid, tls, blocked, fp) match
        Some(_) -> ()
        None -> panic("keel: a new process had no room for its first thread")

// A process's name for `procs`: its argv[0].
private[proc] name_from(args: []const string) -> [sched.NAME_ROOM]u8 =
    if args.len == 0 then sched.name_of("".bytes) else sched.name_of(args[0].bytes)

// The most a process's arguments and environment may take at the top of its stack, strings and
// vectors together: keel.abi's ARGS_ROOM and ENV_ROOM, and room for the pointers to both.
private const ARGS_ROOM: u64 = 8192

// Write `args` and `env` at the top of the new process's stack, Linux's way: the argument strings, each
// with a NUL after it, at the very top, then the environment's entries as they are (each already ends
// in a NUL); below them, 16-aligned, argc, the argc pointers and a zero, then a pointer to each entry
// and a zero. Answers the stack pointer the program starts with, which points at argc; None if they do
// not fit ARGS_ROOM.
private[proc] lay_out_args(space: *mm.Space, args: []const string, env: []const u8) -> Option[u64]
    var strings: u64 = u64(env.len)
    for a in args
        strings += u64(a.bytes.len) + 1
    var entries: u64 = 0
    for b in env
        if b == 0 then entries += 1
    val vector = (u64(args.len) + entries + 3) * 8
    if strings + vector + 16 > ARGS_ROOM then return None

    val text_at = mm.USER_STACK_TOP - strings
    val sp = (text_at - vector) & ~u64(15)
    var at = text_at
    var slot = sp
    if !put_word(space, slot, u64(args.len)) then return None
    for a in args
        slot += 8
        if !put_word(space, slot, at) then return None
        if !mm.copy_to_user(space, at, a.bytes) then return None
        if !mm.copy_to_user(space, at + u64(a.bytes.len), [u8(0)]) then return None
        at += u64(a.bytes.len) + 1
    slot += 8
    if !put_word(space, slot, 0) then return None
    if env.len > 0 && !mm.copy_to_user(space, at, env) then return None
    var start = at
    for i in 0..<env.len
        if env[i] != 0 then continue
        slot += 8
        if !put_word(space, slot, start) then return None
        start = at + u64(i) + 1
    if !put_word(space, slot + 8, 0) then return None
    Some(sp)

private put_word(space: *mm.Space, va: u64, w: u64) -> bool
    var bytes: [8]u8 = [0; 8]
    for i in 0..<8
        bytes[i] = u8((w >> u64(8 * i)) & 0xff)
    mm.copy_to_user(space, va, bytes[..])

// A thread of the process: switch to its address space and enter it with `regs` — a new program's, a
// forked child's copy of its parent's, or a cloned thread's; come back when the thread is over.
private[proc] run(p: *Process, regs: UserRegs)
    val t = sched.current()
    val flags = cpu.irq_save()
    t.process = p
    t.ttbr0 = mm.ttbr0_of(&p.space)
    sched.load_ttbr0(t.ttbr0)
    cpu.irq_restore(flags)

    var entry = regs
    val _ = enter_user(&t.user.ctx, &entry)

    // Back from `keel_leave_user`, with IRQs masked as the exception left them.
    t.process = null
    t.ttbr0 = 0
    sched.load_ttbr0(0)
    cpu.enable_irqs()

    // A thread that asked to be told of its end (set_tid_address, CLONE_CHILD_CLEARTID) has the word
    // zeroed and one waiter on it woken: how a C library joins a thread.
    val told = t.user.clear_tid
    t.user.clear_tid = 0
    if told != 0
        val zero: [4]u8 = [0; 4]
        if mm.copy_to_user(&p.space, told, zero[..]) then val _ = sched.futex_wake(p, told, 1)

    // The last thread out closes whatever the process left open, however it ended; then its parent may
    // reap it.
    if sched.thread_ended(p)
        close_all(p)
        ended(p)

// Wait for a process the kernel started to end, then give its address space back. It stays in the
// table until it has ended, so `kill` and `procs` find it (init, above all).
wait(p: &sync Process)
    reap(p)
    leave(&*p)

// Join the process's threads and free its address space: it has ended, or is about to.
private[proc] reap(p: &sync Process)
    val raw: *Process = &*p
    raw.preemptions = sched.join_threads(raw)
    mm.free_space(&raw.space)

// Ask the process to end: SIGKILL. It does at its next return to user mode — at the latest the next
// timer tick, or at once if it is asleep in a system call.
kill(p: &sync Process)
    var wakes = sched.no_wakes()
    wakes.add(sched.post(&*p, SIGKILL))
    wakes.wake_all()

// How the process ended, as the boot test prints it: "exited <code>" or "killed: <why>".
pid(p: &sync Process) -> u64 = p.pid
exited(p: &sync Process) -> bool = p.term_signal == 0
exit_code(p: &sync Process) -> i64 = p.exit_code
was_killed_by_request(p: &sync Process) -> bool = p.term_signal == SIGKILL && p.fault == 0

why(p: &sync Process) -> string = if p.fault != 0 then reason(p.fault) else s"signal ${p.term_signal}"
preemptions(p: &sync Process) -> u64 = p.preemptions

// The process the calling thread runs, or null for a kernel thread.
private[proc] current_process() -> *Process = sched.current().process

// A non-zero `fault` is ESR_EL1's exception class shifted left eight, with the fault status code (the
// low six bits of the ISS) below it.
private reason(fault: u64) -> string
    val ec = fault >> 8
    if ec == 0x20 || ec == 0x24
        return (fault & 0x3f) >> 2 match
            1 -> "translation fault"
            2 -> "access flag fault"
            3 -> "permission fault"
            else "abort"
    ec match
        0x00 -> "undefined instruction"
        0x07 -> "floating point access"
        0x22 -> "pc alignment fault"
        0x26 -> "sp alignment fault"
        0x3c -> "breakpoint"
        else "exception"

// Called by the trap handler for a synchronous exception from EL0: a system call, or anything else,
// which ends the process.
user_sync(regs: *u64, ec: u64, iss: u64)
    if ec == 0x15
        val again = system_call(regs)
        val p = current_process()
        if p != null then deliver(p, regs, again)
    else if ec == 0x24 && is_write_permission_fault(iss) && mm.break_cow(&current_process().space, cpu.far())
        // A write to a copy-on-write page (mm's cow.sysl): the page is writable now, and the store runs
        // again.
        returning_to_user(regs)
    else
        val fault = (ec << 8) | (iss & 0x3f)
        end(current_process(), fault_signal(ec), fault)

// A data abort's ISS: a permission fault at any level (DFSC 0b0011xx) on a write (WnR, bit 6).
private is_write_permission_fault(iss: u64) -> bool = ((iss & 0x3f) >> 2) == 3 && ((iss >> 6) & 1) == 1

// The signal a POSIX kernel raises for an exception class: an instruction or data abort is SIGSEGV, a
// PC or SP alignment fault SIGBUS, a trapped floating-point exception SIGFPE, `brk` SIGTRAP, and
// anything else it could not run SIGILL.
private fault_signal(ec: u64) -> u64 = ec match
    0x20 | 0x21 | 0x24 | 0x25 -> SIGSEGV
    0x22 | 0x26 -> SIGBUS
    0x2c -> SIGFPE
    0x3c -> SIGTRAP
    else SIGILL

// Called on every way back to EL0 after the kernel had the processor, with the registers the process
// resumes with: a pending signal is delivered here (signal.sysl) — ending the process, or running its
// handler. keel.trap calls it after an interrupt taken at EL0.
returning_to_user(regs: *u64)
    val p = current_process()
    if p != null then deliver(p, regs)

// End `p` — the calling thread's process, every thread of it — by the signal `sig` (0: `exit_group`
// with `code`), for `fault` if a fault raised it. Only the first way the group was ended is recorded.
private[proc] end(p: *Process, sig: u64, fault: u64, code: i64 = 0) -> never
    val _ = sched.begin_group_exit(p, sig, fault, code)
    leave_thread()

// End the calling thread only: back to `run`, which entered user mode for it.
private[proc] leave_thread() -> never = leave_user(&sched.current().user.ctx, 0)
