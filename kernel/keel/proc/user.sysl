module keel.proc

import keel.sched

// Entering user mode, and coming back.
//
//   keel_enter_user(kernel, entry, sp, arg) -> status
//       Save what a call preserves (x19-x30, SP) in *kernel, as `keel_switch` does, then `eret` to EL0
//       at `entry` with SP_EL0 = `sp`, x0 = `arg` and every other register zero, so nothing of the
//       kernel's reaches the program. SPSR = 0 is EL0t with every exception unmasked. IRQs are masked
//       first: an interrupt between writing ELR_EL1 and the `eret` would overwrite it.
//
//       SP_EL1 stays where it is, just below the caller's frame on the thread's kernel stack: every
//       exception the program takes (a system call, an interrupt, a fault) builds its `trap.Frame`
//       there, through the vector table's lower-EL slots.
//
//   keel_leave_user(kernel, status) -> never
//       Called from inside such an exception, on the same stack, when the process is over: load what
//       `keel_enter_user` saved and return from it with `status`. Every frame in between — the vector
//       code's, `keel_trap`'s, the system call's — is abandoned, so none of them may hold a counted
//       reference (FINDINGS.md 23); they are all in `@no_alloc` code that holds none.
//
// The offsets are `sched.Context`'s, which keel.sched's `@assert`s pin.
asm
    [aarch64]
        ".globl keel_enter_user"
        "keel_enter_user:"
        "msr daifset, #2"
        "mov x9, sp"
        "stp x19, x20, [x0, #0]"
        "stp x21, x22, [x0, #16]"
        "stp x23, x24, [x0, #32]"
        "stp x25, x26, [x0, #48]"
        "stp x27, x28, [x0, #64]"
        "stp x29, x30, [x0, #80]"
        "str x9, [x0, #96]"
        "msr elr_el1, x1"
        "msr spsr_el1, xzr"
        "msr sp_el0, x2"
        "mov x0, x3"
        "mov x1, xzr"
        "mov x2, xzr"
        "mov x3, xzr"
        "mov x4, xzr"
        "mov x5, xzr"
        "mov x6, xzr"
        "mov x7, xzr"
        "mov x8, xzr"
        "mov x9, xzr"
        "mov x10, xzr"
        "mov x11, xzr"
        "mov x12, xzr"
        "mov x13, xzr"
        "mov x14, xzr"
        "mov x15, xzr"
        "mov x16, xzr"
        "mov x17, xzr"
        "mov x18, xzr"
        "mov x19, xzr"
        "mov x20, xzr"
        "mov x21, xzr"
        "mov x22, xzr"
        "mov x23, xzr"
        "mov x24, xzr"
        "mov x25, xzr"
        "mov x26, xzr"
        "mov x27, xzr"
        "mov x28, xzr"
        "mov x29, xzr"
        "mov x30, xzr"
        "eret"
        ".globl keel_leave_user"
        "keel_leave_user:"
        "ldp x19, x20, [x0, #0]"
        "ldp x21, x22, [x0, #16]"
        "ldp x23, x24, [x0, #32]"
        "ldp x25, x26, [x0, #48]"
        "ldp x27, x28, [x0, #64]"
        "ldp x29, x30, [x0, #80]"
        "ldr x9, [x0, #96]"
        "mov sp, x9"
        "mov x0, x1"
        "ret"
    [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

extern "keel_enter_user" enter_user(kernel: *sched.Context, entry: u64, sp: u64, arg: u64) -> u64
extern "keel_leave_user" leave_user(kernel: *sched.Context, status: u64) -> never
