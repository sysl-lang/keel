module keel.proc

// Descriptors: what each of a process's descriptors stands for (keel.sched's `OpenFile` — the console,
// a file, one end of a pipe, or nothing), and the calls that work on any of them: read, write, close,
// pipe, dup2 and dup. A file's own reading and writing is keel.fs's; the console's is keel.console's;
// pipes are here.
//
// **A pipe** is a bounded ring of PIPE_ROOM bytes in a fixed table, with a count of the read ends and
// of the write ends open in every process. A reader sleeps while it is empty and a writer is left; a
// writer sleeps while it is full and a reader is left. The last write end's close wakes the readers,
// who then find it drained and answer 0, the end of the input; the last read end's close wakes the
// writers, who answer EPIPE. A slot is free again once both counts are 0. One `IrqLock` guards the whole
// table; bytes cross between the ring and the program through a chunk on the kernel stack, so no user
// memory is touched with the lock held.
//
// A signal wakes a reader or writer asleep in a pipe, which answers EINTR — or, for a writer, what it
// had already put in. A write with no reader left answers EPIPE and sends the writer SIGPIPE, which ends
// it unless it is ignored or handled.
//
// What is simplified: a second descriptor on a file (dup2, dup, a child's) copies the offset rather
// than sharing it, which is the same for the shell's `>` and `>>` (a fresh file, and O_APPEND).

import abi.keel.abi.{EBADF, EFAULT, EINTR, EMFILE, ENFILE, EPIPE, Errno, MAX_FDS, PIPE_ROOM, SIGPIPE}
import keel.console
import keel.fs
import keel.mm
import keel.pl011.put_byte
import keel.sched
import keel.sched.{Holds, IrqLock, OPEN_FILES, OpenFile, Process, WaitQueue}

private const PIPES: usize = 16
private const ROOM: usize = usize(PIPE_ROOM)
private const CHUNK: usize = 512

private struct Pipe
    bytes: [ROOM]u8
    head: usize                 // the oldest byte
    count: usize
    readers: u32                // read ends open, in every process
    writers: u32
    in_use: bool
    can_read: WaitQueue         // readers waiting for a byte, or for the last writer to go
    can_write: WaitQueue        // writers waiting for room, or for the last reader to go

private var pipes: [PIPES]Pipe
private var pipe_lock: IrqLock

// read(fd, buf, len) -> bytes read; 0 at the end of the input.
private[proc] sys_read(p: *Process, regs: *u64) -> Result[i64, Errno]
    val f = descriptor(p, regs[0])?
    f.holds match
        Console ->
            if !mm.user_range(&p.space, regs[1], regs[2], true) then return Err(EFAULT)
            console.read(p, regs[1], regs[2]) match
                Some(n) -> Ok(i64(n))
                None -> Err(EINTR)
        File -> fs.sys_read(p, regs)
        PipeRead -> pipe_read(p, usize(f.ino), regs[1], regs[2])
        else Err(EBADF)

// write(fd, buf, len) -> bytes written.
private[proc] sys_write(p: *Process, regs: *u64) -> Result[i64, Errno]
    val f = descriptor(p, regs[0])?
    f.holds match
        Console -> console_write(p, UserAddr(regs[1]), regs[2])
        File -> fs.sys_write(p, regs)
        PipeWrite -> pipe_write(p, usize(f.ino), regs[1], regs[2])
        else Err(EBADF)

// close(fd) -> 0
private[proc] sys_close(p: *Process, regs: *u64) -> Result[i64, Errno]
    val f = descriptor(p, regs[0])?
    release(*f)
    *f = sched.free_file()
    Ok(0)

// dup2(old, new) -> new. Whatever `new` held is closed first; `new` == `old` changes nothing.
private[proc] sys_dup2(p: *Process, regs: *u64) -> Result[i64, Errno]
    val old = descriptor(p, regs[0])?
    val to = regs[1]
    if to >= MAX_FDS then return Err(EBADF)
    if to == regs[0] then return Ok(i64(to))
    val o = *old
    duplicate(o)
    release(p.files[usize(to)])
    p.files[usize(to)] = o
    Ok(i64(to))

// dup(old) -> the lowest free descriptor, now standing for what `old` does.
private[proc] sys_dup(p: *Process, regs: *u64) -> Result[i64, Errno]
    val old = descriptor(p, regs[0])?
    val to = lowest_free(p, OPEN_FILES)?
    p.files[to] = *old
    duplicate(*old)
    Ok(i64(to))

// pipe(*[2]u32) -> 0, with the read end's descriptor and then the write end's written out.
private[proc] sys_pipe(p: *Process, regs: *u64) -> Result[i64, Errno]
    val r = lowest_free(p, OPEN_FILES)?
    val w = lowest_free(p, r)?
    val slot = new_pipe()?
    p.files[r] = OpenFile(Holds.PipeRead, u32(slot), 0, 0)
    p.files[w] = OpenFile(Holds.PipeWrite, u32(slot), 0, 0)
    var both: [2]u32 = [u32(r), u32(w)]
    val b: *u8 = ptr_cast(&both[0])
    if !mm.copy_to_user(&p.space, regs[0], b[0..<8])
        release(p.files[r])
        release(p.files[w])
        p.files[r] = sched.free_file()
        p.files[w] = sched.free_file()
        return Err(EFAULT)
    Ok(0)

// A second descriptor now stands for what `f` does (dup2, dup, a child's): count it.
private[proc] duplicate(f: OpenFile)
    f.holds match
        File -> fs.opened_again(f.ino)
        PipeRead | PipeWrite ->
            val flags = pipe_lock.lock()
            val pp = &pipes[usize(f.ino)]
            if f.holds == Holds.PipeRead then pp.readers += 1 else pp.writers += 1
            pipe_lock.unlock(flags)
        else ()

// A descriptor that stood for what `f` does is gone (close, dup2's target, a process's end, a child
// that could not be started). The last write end wakes the readers for their end of input; the last
// read end wakes the writers for their EPIPE.
private[proc] release(f: OpenFile)
    f.holds match
        File -> fs.closed(f.ino)
        PipeRead | PipeWrite ->
            val flags = pipe_lock.lock()
            val pp = &pipes[usize(f.ino)]
            if f.holds == Holds.PipeRead
                pp.readers -= 1
                if pp.readers == 0 then val _ = pp.can_write.wake_all()
            else
                pp.writers -= 1
                if pp.writers == 0 then val _ = pp.can_read.wake_all()
            if pp.readers == 0 && pp.writers == 0 then pp.in_use = false
            pipe_lock.unlock(flags)
        else ()

// Close every descriptor a process still has: it has ended.
private[proc] close_all(p: *Process)
    for fd in 0..<OPEN_FILES
        release(p.files[fd])
        p.files[fd] = sched.free_file()

// The descriptor `fd` names, if it holds anything.
private descriptor(p: *Process, fd: u64) -> Result[*OpenFile, Errno]
    if fd >= MAX_FDS then return Err(EBADF)
    val f = &p.files[usize(fd)]
    if f.holds == Holds.Free then return Err(EBADF)
    Ok(f)

// The lowest free descriptor other than `besides`.
private lowest_free(p: *Process, besides: usize) -> Result[usize, Errno]
    for fd in 0..<OPEN_FILES
        if fd != besides && p.files[fd].holds == Holds.Free then return Ok(fd)
    Err(EMFILE)

// A free pipe slot, made empty with one read end and one write end.
private new_pipe() -> Result[usize, Errno]
    val flags = pipe_lock.lock()
    for s in 0..<PIPES
        val pp = &pipes[s]
        if pp.in_use then continue
        pp.in_use = true
        pp.head = 0
        pp.count = 0
        pp.readers = 1
        pp.writers = 1
        pipe_lock.unlock(flags)
        return Ok(s)
    pipe_lock.unlock(flags)
    Err(ENFILE)

// Off only to show what waking a sleeper for a signal is for: with it off a read of an empty pipe
// sleeps through every signal, and the boot test's `sigtest` hangs in its interrupted read.
private const READ_INTERRUPTIBLE: bool = true

// Up to `len` bytes from pipe `slot`, sleeping while it is empty and a writer is left; 0 once none is.
private pipe_read(p: *Process, slot: usize, va: u64, len: u64) -> Result[i64, Errno]
    if len == 0 then return Ok(0)
    if !mm.user_range(&p.space, va, len, true) then return Err(EFAULT)
    var chunk: [CHUNK]u8 = [0; CHUNK]
    val flags = pipe_lock.lock()
    val pp = &pipes[slot]
    while pp.count == 0 && pp.writers > 0
        if !READ_INTERRUPTIBLE
            pp.can_read.sleep(&pipe_lock)
        else if !sched.sleep_interruptibly(p, &pp.can_read, &pipe_lock)
            pipe_lock.unlock(flags)
            return Err(EINTR)
    var n = pp.count
    if n > CHUNK then n = CHUNK
    if u64(n) > len then n = usize(len)
    for i in 0..<n
        chunk[i] = pp.bytes[(pp.head + i) % ROOM]
    pp.head = (pp.head + n) % ROOM
    pp.count -= n
    if n > 0 then val _ = pp.can_write.wake_all()
    pipe_lock.unlock(flags)
    if !mm.copy_to_user(&p.space, va, chunk[0..<n]) then return Err(EFAULT)
    Ok(i64(n))

// All `len` bytes into pipe `slot`, sleeping while it is full and a reader is left. EPIPE, and SIGPIPE
// sent to the writer, if no reader is left before anything went in; EINTR if a signal came first; what
// went in, if a reader went away or a signal came part way.
private pipe_write(p: *Process, slot: usize, va: u64, len: u64) -> Result[i64, Errno]
    if !mm.user_range(&p.space, va, len, false) then return Err(EFAULT)
    var chunk: [CHUNK]u8 = [0; CHUNK]
    var done: u64 = 0
    while done < len
        var want = usize(len - done)
        if want > CHUNK then want = CHUNK
        if !mm.copy_from_user(&p.space, va + done, chunk[0..<want]) then return Err(EFAULT)
        val (put, interrupted) = into_pipe(p, slot, chunk[0..<want])
        done += u64(put)
        if interrupted
            if done == 0 then return Err(EINTR)
            break
        if put < want
            if done == 0
                // The writer is running, so there is no sleep to end: the signal is delivered on the way
                // back to user mode.
                val _ = sched.post(p, SIGPIPE)
                return Err(EPIPE)
            break
    Ok(i64(done))

// Put `bytes` into pipe `slot`, waiting for room; answers how many went in before no reader was left or
// a signal for `p` came, and whether one did.
private into_pipe(p: *Process, slot: usize, bytes: []const u8) -> (usize, bool)
    var put: usize = 0
    val flags = pipe_lock.lock()
    val pp = &pipes[slot]
    while put < bytes.len && pp.readers > 0
        if pp.count == ROOM
            if !sched.sleep_interruptibly(p, &pp.can_write, &pipe_lock)
                pipe_lock.unlock(flags)
                return (put, true)
            continue
        var n = bytes.len - put
        if n > ROOM - pp.count then n = ROOM - pp.count
        for i in 0..<n
            pp.bytes[(pp.head + pp.count + i) % ROOM] = bytes[put + i]
        pp.count += n
        put += n
        val _ = pp.can_read.wake_all()
    pipe_lock.unlock(flags)
    (put, false)

// The console's write: every page of the buffer is checked against the process's translation tables
// first — mapped, and mapped for the user — so a bad pointer anywhere in it answers EFAULT and prints
// nothing, rather than faulting in the kernel or printing kernel memory.
private console_write(p: *Process, buf: UserAddr, len: u64) -> Result[i64, Errno]
    if len == 0 then return Ok(0)

    if !VALIDATE_USER_POINTERS
        for i in 0..<len
            val b: *u8 = ptr_cast(usize(u64(buf) + i))
            put_byte(*b)
        return Ok(i64(len))

    if !user_readable(&p.space, buf, len) then return Err(EFAULT)
    console.hold()
    var done: u64 = 0
    while done < len
        val at = u64(buf) + done
        var chunk = len - done
        val in_page = mm.PAGE_SIZE - (at & (mm.PAGE_SIZE - 1))
        if chunk > in_page then chunk = in_page
        val (pa, _) = mm.user_translate(&p.space, at) match
            Some(t) -> t
            None -> (mm.PhysAddr(0), false)
        val src: *u8 = ptr_cast(usize(u64(mm.to_virt(pa))))
        for i in 0..<chunk
            put_byte(src[usize(i)])
        done += chunk
    console.release()
    Ok(i64(len))
