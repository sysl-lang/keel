module keel.proc

// Descriptors: what each of a process's descriptors stands for (keel.sched's `OpenFile` — the console,
// a file, one end of a pipe, a socket, or nothing), and the calls that work on any of them: read, write,
// close, pipe2, dup3 and dup. A file's own reading and writing is keel.fs's; the console's is
// keel.console's; a socket's is socket.sysl's; pipes are here.
//
// **A pipe** is a bounded ring of PIPE_ROOM bytes in a fixed table, with a count of the read ends and
// of the write ends open in every process. A reader sleeps while it is empty and a writer is left; a
// writer sleeps while it is full and a reader is left. The last write end's close wakes the readers,
// who then find it drained and answer 0, the end of the input; the last read end's close wakes the
// writers, who answer EPIPE. A slot is free again once both counts are 0. One `IrqLock` guards the whole
// table; bytes cross between the ring and the program through a chunk on the kernel stack, so no user
// memory is touched with the lock held.
//
// A signal wakes a reader or writer asleep in a pipe, which answers EINTR — or, for a writer, what it
// had already put in. A write with no reader left answers EPIPE and sends the writer SIGPIPE, which ends
// it unless it is ignored or handled.
//
// What is simplified: a second descriptor on a file (dup3, dup, a child's) copies the offset rather
// than sharing it, which is the same for the shell's `>` and `>>` (a fresh file, and O_APPEND); and
// O_CLOEXEC is taken and changes nothing — keel has no close-on-exec.

import abi.keel.abi.{EBADF, EDESTADDRREQ, EFAULT, EINTR, EINVAL, EMFILE, ENFILE, EPIPE, Errno, MAX_FDS, O_CLOEXEC,
    PIPE_ROOM, POLLERR, POLLHUP, POLLIN, POLLOUT, POLLRDNORM, POLLWRNORM, SIGPIPE}
import keel.console
import keel.fs
import keel.mm
import keel.net
import keel.pl011.put_byte
import keel.sched
import keel.sched.{Holds, IrqLock, OPEN_FILES, OpenFile, Process, WaitQueue}

private const PIPES: usize = 16
private const ROOM: usize = usize(PIPE_ROOM)
private const CHUNK: usize = 512

private struct Pipe
    bytes: [ROOM]u8
    head: usize                 // the oldest byte
    count: usize
    readers: u32                // read ends open, in every process
    writers: u32
    in_use: bool
    can_read: WaitQueue         // readers waiting for a byte, or for the last writer to go
    can_write: WaitQueue        // writers waiting for room, or for the last reader to go

private var pipes: [PIPES]Pipe
private var pipe_lock: IrqLock

// **A process's threads share its descriptor table**, so every call that reads or changes it holds the
// table's lock (keel.sched's `lock_files`) while it does. Choosing a slot and filling it, closing one,
// copying one for dup3, dup, fork or spawn: all under the one lock, so two threads are never handed one
// descriptor and a count never goes wrong. A file's read, write, lseek, fstat and getdents keep the
// table locked for the whole call (keel.fs's lock serializes them anyway, and the offset they move is
// the slot's own). A call that may wait on another party for as long as it likes — the console's or a
// pipe's read and write, a socket's receive and send — cannot hold the table that long, so it takes a
// copy counted as one more open descriptor (`duplicate`, Linux's `fget`), lets the table go, and gives
// the count back at its end (`release`, `fput`). A thread closing that descriptor meanwhile frees the
// slot at once, but the pipe end or the socket stays open until the call in flight has finished with it,
// and a new descriptor in the slot is never what that call works on.
//
// Lock order: the table, then keel.fs's `Mutex`, then a pipe's or keel.net's `IrqLock`.

// What a call on a descriptor works on: a file's slot itself, the table staying locked for the call; or
// anything else's copy, counted, the table let go. `finished` ends either.
private enum Use
    InTable(slot: *OpenFile)
    Held(copy: OpenFile)

private taken(p: *Process, fd: u64) -> Result[Use, Errno]
    val t = sched.lock_files(p)
    val f = slot_in(t, fd) match
        Ok(f) -> f
        Err(e) ->
            sched.unlock_files(p)
            return Err(e)
    if f.holds == Holds.File then return Ok(Use.InTable(f))
    val copy = *f
    duplicate(copy)
    sched.unlock_files(p)
    Ok(Use.Held(copy))

private finished(p: *Process, u: Use)
    u match
        InTable(_) -> sched.unlock_files(p)
        Held(f) -> release(f)

// read(fd, buf, len) -> bytes read; 0 at the end of the input.
private[proc] sys_read(p: *Process, regs: *u64) -> Result[i64, Errno]
    val u = taken(p, regs[0])?
    val r = u match
        InTable(f) -> fs.sys_read(p, f, regs)
        Held(f) -> held_read(p, f, regs)
    finished(p, u)
    r

private held_read(p: *Process, f: OpenFile, regs: *u64) -> Result[i64, Errno] = f.holds match
    Console ->
        if !mm.user_range(&p.space, regs[1], regs[2], true) then return Err(EFAULT)
        console.read(p, regs[1], regs[2]) match
            Some(n) -> Ok(i64(n))
            None -> Err(EINTR)
    PipeRead -> pipe_read(p, usize(f.ino), regs[1], regs[2])
    Socket -> socket_read(p, f, regs[1], regs[2])
    else Err(EBADF)

// write(fd, buf, len) -> bytes written. A socket is never connected, so `write` has nowhere to send.
private[proc] sys_write(p: *Process, regs: *u64) -> Result[i64, Errno]
    val u = taken(p, regs[0])?
    val r = u match
        InTable(f) -> fs.sys_write(p, f, regs)
        Held(f) -> held_write(p, f, regs)
    finished(p, u)
    r

private held_write(p: *Process, f: OpenFile, regs: *u64) -> Result[i64, Errno] = f.holds match
    Console -> console_write(p, UserAddr(regs[1]), regs[2])
    PipeWrite -> pipe_write(p, usize(f.ino), regs[1], regs[2])
    Socket -> Err(EDESTADDRREQ)
    else Err(EBADF)

// lseek(fd, offset, whence), fstat(fd, *stat), getdents64(fd, buf, len), ftruncate(fd, length): a
// file's, with the table locked for the call (keel.fs has the rest).
private[proc] sys_lseek(p: *Process, regs: *u64) -> Result[i64, Errno]
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    fs.sys_lseek(p, slot_in(t, regs[0])?, regs)

private[proc] sys_fstat(p: *Process, regs: *u64) -> Result[i64, Errno]
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    fs.sys_fstat(p, slot_in(t, regs[0])?, regs)

private[proc] sys_getdents64(p: *Process, regs: *u64) -> Result[i64, Errno]
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    fs.sys_getdents64(p, slot_in(t, regs[0])?, regs)

private[proc] sys_ftruncate(p: *Process, regs: *u64) -> Result[i64, Errno]
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    fs.sys_ftruncate(p, slot_in(t, regs[0])?, regs)

// close(fd) -> 0. A call another thread has in flight on it keeps what it holds until that call ends.
private[proc] sys_close(p: *Process, regs: *u64) -> Result[i64, Errno]
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    val f = slot_in(t, regs[0])?
    release(*f)
    *f = sched.free_file()
    Ok(0)

// dup3(old, new, flags) -> new. Whatever `new` held is closed first; `new` == `old` is EINVAL, and the
// only flag is O_CLOEXEC.
private[proc] sys_dup3(p: *Process, regs: *u64) -> Result[i64, Errno]
    val to = regs[1]
    if (regs[2] & ~O_CLOEXEC) != 0 then return Err(EINVAL)
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    val old = slot_in(t, regs[0])?
    if to >= MAX_FDS then return Err(EBADF)
    if to == regs[0] then return Err(EINVAL)
    val o = *old
    duplicate(o)
    release(t.slots[usize(to)])
    t.slots[usize(to)] = o
    Ok(i64(to))

// dup(old) -> the lowest free descriptor, now standing for what `old` does.
private[proc] sys_dup(p: *Process, regs: *u64) -> Result[i64, Errno]
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    val old = slot_in(t, regs[0])?
    val to = lowest_free(t, OPEN_FILES)?
    t.slots[to] = *old
    duplicate(*old)
    Ok(i64(to))

// pipe2(*[2]i32, flags) -> 0, with the read end's descriptor and then the write end's written out. The
// only flag is O_CLOEXEC; a pipe that never waits (O_NONBLOCK) keel does not have. The two descriptors
// are filled in only once the program has their numbers.
private[proc] sys_pipe2(p: *Process, regs: *u64) -> Result[i64, Errno]
    if (regs[1] & ~O_CLOEXEC) != 0 then return Err(EINVAL)
    val t = sched.lock_files(p)
    defer sched.unlock_files(p)
    val r = lowest_free(t, OPEN_FILES)?
    val w = lowest_free(t, r)?
    val slot = new_pipe()?
    val read_end = OpenFile(Holds.PipeRead, u32(slot), 0, 0)
    val write_end = OpenFile(Holds.PipeWrite, u32(slot), 0, 0)
    var both: [2]u32 = [u32(r), u32(w)]
    val b: *u8 = ptr_cast(&both[0])
    if !mm.copy_to_user(&p.space, regs[0], b[0..<8])
        release(read_end)
        release(write_end)
        return Err(EFAULT)
    t.slots[r] = read_end
    t.slots[w] = write_end
    Ok(0)

// A second descriptor now stands for what `f` does (dup3, dup, a child's): count it.
private[proc] duplicate(f: OpenFile)
    f.holds match
        File -> fs.opened_again(f.ino)
        Socket -> net.socket_hold(usize(f.ino))
        PipeRead | PipeWrite ->
            val flags = pipe_lock.lock()
            val pp = &pipes[usize(f.ino)]
            if f.holds == Holds.PipeRead then pp.readers += 1 else pp.writers += 1
            pipe_lock.unlock(flags)
        else ()

// A descriptor that stood for what `f` does is gone (close, dup3's target, a process's end, a child
// that could not be started). The last write end wakes the readers for their end of input; the last
// read end wakes the writers for their EPIPE; the last descriptor on a socket closes it.
private[proc] release(f: OpenFile)
    f.holds match
        File -> fs.closed(f.ino)
        Socket -> net.socket_release(usize(f.ino))
        PipeRead | PipeWrite ->
            val flags = pipe_lock.lock()
            val pp = &pipes[usize(f.ino)]
            if f.holds == Holds.PipeRead
                pp.readers -= 1
                if pp.readers == 0 then val _ = pp.can_write.wake_all()
            else
                pp.writers -= 1
                if pp.writers == 0 then val _ = pp.can_read.wake_all()
            if pp.readers == 0 && pp.writers == 0 then pp.in_use = false
            // Only the last end of a kind changes what a poller sees (POLLHUP, POLLERR); every call that
            // may wait releases the count it took, and that is no event.
            if pp.readers == 0 || pp.writers == 0 then sched.poll_notify()
            pipe_lock.unlock(flags)
        else ()

// Close every descriptor a process still has: it has ended.
private[proc] close_all(p: *Process)
    val t = sched.lock_files(p)
    for fd in 0..<OPEN_FILES
        release(t.slots[fd])
        t.slots[fd] = sched.free_file()
    sched.unlock_files(p)

// Every descriptor of `from` copied into `to`'s table and counted (fork's child).
private[proc] copy_all(from: *Process, to: *Process)
    val mine = sched.lock_files(from)
    val theirs = sched.lock_files(to)
    for fd in 0..<OPEN_FILES
        theirs.slots[fd] = mine.slots[fd]
        duplicate(theirs.slots[fd])
    sched.unlock_files(to)
    sched.unlock_files(from)

// `p`'s descriptors 0 to 2 set to `std` (spawn's child: they come already counted).
private[proc] set_standard(p: *Process, std: [3]OpenFile)
    val t = sched.lock_files(p)
    for fd in 0..<3
        t.slots[fd] = std[fd]
    sched.unlock_files(p)

// The descriptor `fd` names in a locked table, if it holds anything.
private[proc] slot_in(t: *sched.Files, fd: u64) -> Result[*OpenFile, Errno]
    if fd >= MAX_FDS then return Err(EBADF)
    val f = &t.slots[usize(fd)]
    if f.holds == Holds.Free then return Err(EBADF)
    Ok(f)

// The lowest free descriptor in a locked table, other than `besides`.
private[proc] lowest_free(t: *sched.Files, besides: usize) -> Result[usize, Errno]
    for fd in 0..<OPEN_FILES
        if fd != besides && t.slots[fd].holds == Holds.Free then return Ok(fd)
    Err(EMFILE)

// A free pipe slot, made empty with one read end and one write end.
private new_pipe() -> Result[usize, Errno]
    val flags = pipe_lock.lock()
    for s in 0..<PIPES
        val pp = &pipes[s]
        if pp.in_use then continue
        pp.in_use = true
        pp.head = 0
        pp.count = 0
        pp.readers = 1
        pp.writers = 1
        pipe_lock.unlock(flags)
        return Ok(s)
    pipe_lock.unlock(flags)
    Err(ENFILE)

// Off only to show what waking a sleeper for a signal is for: with it off a read of an empty pipe
// sleeps through every signal, and the boot test's `sigtest` hangs in its interrupted read.
private const READ_INTERRUPTIBLE: bool = true

// Up to `len` bytes from pipe `slot`, sleeping while it is empty and a writer is left; 0 once none is.
private pipe_read(p: *Process, slot: usize, va: u64, len: u64) -> Result[i64, Errno]
    if len == 0 then return Ok(0)
    if !mm.user_range(&p.space, va, len, true) then return Err(EFAULT)
    var chunk: [CHUNK]u8 = [0; CHUNK]
    val flags = pipe_lock.lock()
    val pp = &pipes[slot]
    while pp.count == 0 && pp.writers > 0
        if !READ_INTERRUPTIBLE
            pp.can_read.sleep(&pipe_lock)
        else if !sched.sleep_interruptibly(p, &pp.can_read, &pipe_lock)
            pipe_lock.unlock(flags)
            return Err(EINTR)
    var n = pp.count
    if n > CHUNK then n = CHUNK
    if u64(n) > len then n = usize(len)
    for i in 0..<n
        chunk[i] = pp.bytes[(pp.head + i) % ROOM]
    pp.head = (pp.head + n) % ROOM
    pp.count -= n
    if n > 0
        val _ = pp.can_write.wake_all()
        sched.poll_notify()
    pipe_lock.unlock(flags)
    if !mm.copy_to_user(&p.space, va, chunk[0..<n]) then return Err(EFAULT)
    Ok(i64(n))

// All `len` bytes into pipe `slot`, sleeping while it is full and a reader is left. EPIPE, and SIGPIPE
// sent to the writer, if no reader is left before anything went in; EINTR if a signal came first; what
// went in, if a reader went away or a signal came part way.
private pipe_write(p: *Process, slot: usize, va: u64, len: u64) -> Result[i64, Errno]
    if !mm.user_range(&p.space, va, len, false) then return Err(EFAULT)
    var chunk: [CHUNK]u8 = [0; CHUNK]
    var done: u64 = 0
    while done < len
        var want = usize(len - done)
        if want > CHUNK then want = CHUNK
        if !mm.copy_from_user(&p.space, va + done, chunk[0..<want]) then return Err(EFAULT)
        val (put, interrupted) = into_pipe(p, slot, chunk[0..<want])
        done += u64(put)
        if interrupted
            if done == 0 then return Err(EINTR)
            break
        if put < want
            if done == 0
                // The writer is running, so there is no sleep to end: the signal is delivered on the way
                // back to user mode.
                val _ = sched.post(p, SIGPIPE)
                return Err(EPIPE)
            break
    Ok(i64(done))

// Put `bytes` into pipe `slot`, waiting for room; answers how many went in before no reader was left or
// a signal for `p` came, and whether one did.
private into_pipe(p: *Process, slot: usize, bytes: []const u8) -> (usize, bool)
    var put: usize = 0
    val flags = pipe_lock.lock()
    val pp = &pipes[slot]
    while put < bytes.len && pp.readers > 0
        if pp.count == ROOM
            if !sched.sleep_interruptibly(p, &pp.can_write, &pipe_lock)
                pipe_lock.unlock(flags)
                return (put, true)
            continue
        var n = bytes.len - put
        if n > ROOM - pp.count then n = ROOM - pp.count
        for i in 0..<n
            pp.bytes[(pp.head + pp.count + i) % ROOM] = bytes[put + i]
        pp.count += n
        put += n
        val _ = pp.can_read.wake_all()
        if WRITE_WAKES_POLLERS then sched.poll_notify()
    pipe_lock.unlock(flags)
    (put, false)

// Off only to show what waking the pollers is for: with it off a write into a pipe leaves a `ppoll` on its
// read end asleep until its timeout, and the boot test's `linuxpoll` fails its first wait.
private const WRITE_WAKES_POLLERS: bool = true

// What `ppoll` sees on pipe `slot`'s read end (`read_end`) or write end: Linux's pipe_poll — readable
// while it holds a byte, POLLHUP once no write end is left; writable while there is room, POLLERR once no
// read end is left.
private[proc] pipe_poll(slot: usize, read_end: bool) -> u16
    val flags = pipe_lock.lock()
    val pp = &pipes[slot]
    var mask: u16 = 0
    if read_end
        if pp.count > 0 then mask = POLLIN | POLLRDNORM
        if pp.writers == 0 then mask |= POLLHUP
    else
        if pp.count < ROOM then mask = POLLOUT | POLLWRNORM
        if pp.readers == 0 then mask |= POLLERR
    pipe_lock.unlock(flags)
    mask

// The console's write: every page of the buffer is checked against the process's translation tables
// first — mapped, and mapped for the user — so a bad pointer anywhere in it answers EFAULT and prints
// nothing, rather than faulting in the kernel or printing kernel memory.
private console_write(p: *Process, buf: UserAddr, len: u64) -> Result[i64, Errno]
    if len == 0 then return Ok(0)

    if !VALIDATE_USER_POINTERS
        for i in 0..<len
            val b: *u8 = ptr_cast(usize(u64(buf) + i))
            put_byte(*b)
        return Ok(i64(len))

    if !user_readable(&p.space, buf, len) then return Err(EFAULT)
    val oflag = console.output_flags()
    console.hold()
    var done: u64 = 0
    while done < len
        val at = u64(buf) + done
        var chunk = len - done
        val in_page = mm.PAGE_SIZE - (at & (mm.PAGE_SIZE - 1))
        if chunk > in_page then chunk = in_page
        val (pa, _) = mm.user_translate(&p.space, at) match
            Some(t) -> t
            None -> (mm.PhysAddr(0), false)
        val src: *u8 = ptr_cast(usize(u64(mm.to_virt(pa))))
        for i in 0..<chunk
            console.put(src[usize(i)], oflag)
        done += chunk
    console.release()
    Ok(i64(len))
