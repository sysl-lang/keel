module keel.proc

// `clone` (as fork) and `execve`.
//
// **clone** with flags SIGCHLD and no new stack — the combination a C library's `fork` makes, and the
// only one keel takes (anything else is EINVAL) — copies the calling process: its address space
// copy-on-write (keel.mm's cow.sysl), every descriptor (each counted open once more, so a pipe sees one
// more reader or writer and a socket one more holder; a descriptor's offset is copied, not shared, as
// everywhere in keel), its current directory, uid and gid, and its environment. The child's thread
// enters EL0 from a copy of the registers the parent's `svc` left in its trap frame, with x0 = 0: it
// returns from the same system call, answered 0, where the parent is answered the child's pid; the
// parent is sent SIGCHLD when it ends.
//
// **execve** replaces the calling process's image: the same pid, parent, descriptors and current
// directory; a new address space loaded from the file, the arguments and the environment laid on its
// stack as `spawn` lays them, and the uid of the file's owner when it is set-user-ID, as `spawn` honours
// it. There is no close-on-exec flag. Everything that can fail — the path, the file, the permission,
// the load, the room for the arguments — is done before the old image is touched, so a failed
// `execve` returns its error to a caller exactly as it was.

import abi.keel.abi.{ARGS_ROOM, CLONE_CHILD_CLEARTID, CLONE_PARENT_SETTID, CLONE_SETTLS, CLONE_THREAD_OPTIONS,
    CLONE_THREAD_SET, E2BIG, EAGAIN, EFAULT, EINVAL, ENAMETOOLONG, ENOENT, ENOMEM, ENV_ROOM, Errno, PATH_ROOM, SIGCHLD}
import keel.cpu
import keel.fs
import keel.mm
import keel.sched
import keel.sched.{Context, Env, Process}
import sysl.buf.{Buf, buf}

private const MAX_EXEC_PATH: usize = usize(PATH_ROOM)

// clone(flags, stack, parent_tid, tls, child_tid) -> the child's pid or thread id; 0 in the child. Two
// shapes are taken: flags SIGCHLD with stack 0 — a fork, where the three addresses mean nothing — and a
// thread (`clone_thread`); anything else is EINVAL.
private[proc] sys_clone(p: *Process, regs: *u64) -> Result[i64, Errno]
    val flags = regs[0]
    if (flags & ~CLONE_THREAD_OPTIONS) == CLONE_THREAD_SET then return clone_thread(p, regs, flags)
    if flags != SIGCHLD || regs[1] != 0 then return Err(EINVAL)
    val space = mm.fork_space(&p.space) match
        Some(s) -> s
        None -> return Err(ENOMEM)
    // The child has its parent's signal actions, nothing pending, its process group and its session; its
    // thread has the forking thread's blocked set and TLS pointer.
    val child: &sync Process = Process(new_pid(), space, p.heap_base, p.brk, sched.no_threads(),
        sched.copied_signals(p.sig), 0, 0, 0, sched.no_files(), p.cwd, p.cwd_len, p.pid, false, None, p.uid,
        p.gid, copied_env(p), p.pgid, p.sid, 0, p.name, 0, 0, 0)
    val raw: *Process = &*child
    for fd in 0..<sched.OPEN_FILES
        raw.files[fd] = p.files[fd]
        duplicate(raw.files[fd])
    if !enter(child)
        close_all(raw)
        mm.free_space(&raw.space)
        return Err(EAGAIN)
    var regs_copy = saved_regs(regs)
    regs_copy.x[0] = 0
    start_first_thread(raw, () -> run(raw, regs_copy), cpu.tpidr_el0(), sched.current().user.blocked)
    Ok(i64(raw.pid))

// A new thread of the calling process — `flags` is CLONE_THREAD_SET and any of CLONE_THREAD_OPTIONS, what
// musl's pthread_create passes. It shares everything the process holds; it starts from a copy of the
// caller's registers with x0 = 0 and SP = `stack` (unless 0), TPIDR_EL0 `tls` with CLONE_SETTLS (else the
// caller's), and the caller's blocked set. Its id is written to `parent_tid` with CLONE_PARENT_SETTID,
// and `child_tid` is zeroed and woken when it ends with CLONE_CHILD_CLEARTID. EAGAIN when the process has
// MAX_THREADS already.
private clone_thread(p: *Process, regs: *u64, flags: u64) -> Result[i64, Errno]
    val tid = new_pid()
    if (flags & CLONE_PARENT_SETTID) != 0
        val id: [4]u8 = [u8(tid & 0xff), u8((tid >> 8) & 0xff), u8((tid >> 16) & 0xff), u8((tid >> 24) & 0xff)]
        if !mm.copy_to_user(&p.space, regs[2], id[..]) then return Err(EFAULT)
    val clear_tid = if (flags & CLONE_CHILD_CLEARTID) != 0 then regs[4] else 0
    val tls = if (flags & CLONE_SETTLS) != 0 then regs[3] else cpu.tpidr_el0()
    var regs_copy = saved_regs(regs)
    regs_copy.x[0] = 0
    if regs[1] != 0 then regs_copy.sp_el0 = regs[1]
    sched.spawn_user(p, () -> run_clone(p, regs_copy, clear_tid), tid, tls, sched.current().user.blocked) match
        Some(_) -> Ok(i64(tid))
        None -> Err(EAGAIN)

// A cloned thread's start: what it is to clear when it ends, then into user mode.
private run_clone(p: *Process, regs: UserRegs, clear_tid: u64)
    sched.current().user.clear_tid = clear_tid
    run(p, regs)

// The parent's environment, in a box of the child's own. Read by index: a `&sync` box's array has no
// slice.
private copied_env(p: *Process) -> &sync Env
    val bytes: Buf[u8] = buf()
    for i in 0..<p.env.len
        bytes.push(p.env.bytes[i])
    sched.env_of(bytes.view())

// execve(path, argv, envp) -> does not return; an error leaves the caller as it was. `path` is a
// NUL-terminated string; `argv` and `envp` are arrays of pointers to them, each ending in a null
// pointer (a null array is an empty one). Their strings together are at most ARGS_ROOM and ENV_ROOM
// bytes, NULs included.
private[proc] sys_execve(p: *Process, regs: *u64) -> Result[i64, Errno]
    var path: [MAX_EXEC_PATH]u8 = [0; MAX_EXEC_PATH]
    val path_len = mm.copy_cstr_from_user(&p.space, regs[0], path[..]) match
        Some(n) -> n
        None -> return Err(EFAULT)
    if path_len == 0 then return Err(ENOENT)
    if path_len == MAX_EXEC_PATH then return Err(ENAMETOOLONG)
    val packed = vector_in(p, regs[1], ARGS_ROOM)?
    val args = unpacked(packed.view())?
    val env = vector_in(p, regs[2], ENV_ROOM)?

    val image = fs.read_executable(p.cwd[0..<p.cwd_len], path[0..<path_len], sched.cred_of(p))?
    var l = load(image.bytes.view()) match
        Ok(l) -> l
        Err(e) -> return Err(errno_of(e))
    val sp = lay_out_args(&l.space, args.view(), env.view()) match
        Some(sp) -> sp
        None ->
            mm.free_space(&l.space)
            return Err(E2BIG)

    // Every other thread of the process ends first, as Linux has it; if the group is already ending,
    // this thread ends with it instead.
    if !sched.end_other_threads(p)
        mm.free_space(&l.space)
        leave_thread()

    // Nothing can fail from here on: the new image takes the old one's place, and this thread is the
    // process's first: the pid is its id, it has no TLS and nothing to clear.
    var old = p.space
    val t = sched.current()
    t.user.tid = p.pid
    t.user.clear_tid = 0
    cpu.set_tpidr_el0(0)
    val flags = cpu.irq_save()
    p.space = l.space
    t.ttbr0 = mm.ttbr0_of(&p.space)
    sched.load_ttbr0(t.ttbr0)
    cpu.irq_restore(flags)
    mm.free_space(&old)
    p.heap_base = l.heap_base
    p.brk = l.heap_base
    p.uid = image.run_as.uid
    p.gid = image.run_as.gid
    p.env = sched.env_of(env.view())
    p.name = name_from(args.view())
    // A handler's address means nothing in the new program; an ignored signal stays ignored.
    sched.reset_handlers(p.sig)
    replace_regs(regs, fresh_regs(l.entry, sp, 0))
    Ok(0)

// The strings of the null-ended pointer array at the caller's `va`, each followed by its NUL, at most
// `room` bytes in all (E2BIG past it); none for a null `va`.
private vector_in(p: *Process, va: u64, room: u64) -> Result[Buf[u8], Errno]
    val out: Buf[u8] = buf()
    if va == 0 then return Ok(out)
    val space: Buf[u8] = buf()
    for _ in 0..<room
        space.push(0)
    var used: usize = 0
    var at = va
    loop
        var ptr: u64 = 0
        val raw: *u8 = ptr_cast(&ptr)
        if !mm.copy_from_user(&p.space, at, raw[0..<8]) then return Err(EFAULT)
        if ptr == 0 then break
        if used == usize(room) then return Err(E2BIG)
        val n = mm.copy_cstr_from_user(&p.space, ptr, space.view()[used..]) match
            Some(n) -> n
            None -> return Err(EFAULT)
        if n == usize(room) - used then return Err(E2BIG)
        used += n + 1
        at += 8
    out.extend(space.view()[0..<used])
    Ok(out)
