module keel.proc

// The user programs keel carries, built from user/<name> before the kernel and embedded in its
// read-only data with the assembler's `.incbin` — sysl has no way to name a file's bytes, so assembly
// at the top of a file is the way in (FINDINGS.md 33). The assembler resolves the path against the
// directory `sysl build` was started in, not this file's: scripts/boot-test.sh builds from the
// repository's root, where `scratch/user/` is.
//
// Each image starts at a label and ends at another; `.balign 8` keeps the ELF header 8-aligned, though
// the loader copies fields out byte by byte and does not depend on it.
@section(".rodata.programs")
asm
    [aarch64]
        ".balign 8"
        ".globl keel_prog_hello, keel_prog_hello_end"
        "keel_prog_hello:"
        ".incbin \"scratch/user/hello.elf\""
        "keel_prog_hello_end:"
    [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

extern keel_prog_hello: u8
extern keel_prog_hello_end: u8

private image(start: *u8, end: *u8) -> []const u8 = start[0..<usize(end) - usize(start)]

hello() -> []const u8 = image(&keel_prog_hello, &keel_prog_hello_end)
