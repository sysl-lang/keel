module keel.proc

import abi.keel.abi.{EFAULT, ENOSYS, Errno, STDERR, STDOUT, SYS_ACCESS, SYS_BRK, SYS_CHDIR, SYS_CLOSE, SYS_EXIT,
    SYS_FSTAT, SYS_FTRUNCATE, SYS_GETCWD, SYS_GETDENTS, SYS_GETPID, SYS_LSEEK, SYS_MKDIR, SYS_OPEN, SYS_READ,
    SYS_RENAME, SYS_RMDIR, SYS_STAT, SYS_SYNC, SYS_TRUNCATE, SYS_UNLINK, SYS_WRITE}
import keel.fs
import keel.mm
import keel.pl011.put_byte
import keel.sched.Process
import sysl.sync.SpinLock

// System calls (user/abi has the numbers): `svc #0` from EL0 arrives here with the saved registers, the
// number in x8 and the arguments in x0 to x5; the answer goes back in x0, an error as its negative
// errno.
//
// Every handler has the same shape — the process and its saved registers in, a `Result` out — and the
// dispatch is a `match` on the number. A table of the handlers' addresses (`[5]*extern(*Process, *u64)
// -> i64` in a module `val`) is the natural form, but its initializer is not folded into the image: it
// is computed in a `main` that an image entered at `_start` never runs, so every entry read as null
// (FINDINGS.md 31).
private[proc] system_call(regs: *u64)
    val p = current_process()
    val r = regs[8] match
        SYS_EXIT -> sys_exit(p, regs)
        SYS_WRITE -> sys_write(p, regs)
        SYS_GETPID -> sys_getpid(p, regs)
        SYS_BRK -> sys_brk(p, regs)
        SYS_OPEN -> fs.sys_open(p, regs)
        SYS_READ -> fs.sys_read(p, regs)
        SYS_CLOSE -> fs.sys_close(p, regs)
        SYS_LSEEK -> fs.sys_lseek(p, regs)
        SYS_FSTAT -> fs.sys_fstat(p, regs)
        SYS_STAT -> fs.sys_stat(p, regs)
        SYS_MKDIR -> fs.sys_mkdir(p, regs)
        SYS_GETDENTS -> fs.sys_getdents(p, regs)
        SYS_UNLINK -> fs.sys_unlink(p, regs)
        SYS_RMDIR -> fs.sys_rmdir(p, regs)
        SYS_RENAME -> fs.sys_rename(p, regs)
        SYS_SYNC -> fs.sys_sync()
        SYS_GETCWD -> fs.sys_getcwd(p, regs)
        SYS_CHDIR -> fs.sys_chdir(p, regs)
        SYS_TRUNCATE -> fs.sys_truncate(p, regs)
        SYS_FTRUNCATE -> fs.sys_ftruncate(p, regs)
        SYS_ACCESS -> fs.sys_access(p, regs)
        else Err(ENOSYS)
    regs[0] = r match
        Ok(v) -> u64(v)
        Err(e) -> u64(-i64(e))

private sys_exit(p: *Process, regs: *u64) -> Result[i64, Errno]
    p.exit_code = i64(regs[0])
    end(p, 0)

private sys_getpid(p: *Process, regs: *u64) -> Result[i64, Errno] = Ok(i64(p.pid))

// A user address: what a system call's pointer argument is. It is a number and nothing more — it has
// no dereference, so the kernel cannot read through one by mistake; `user_bytes` checks it against the
// process's own tables and answers where its bytes really are. A typed `UserPtr[T]` is not spellable
// as a distinct type (FINDINGS.md 32).
type UserAddr = new u64

// Off only to show what the check is for: with it off, `write` reads through whatever address the
// program passed, and a bad one is a fault in the kernel.
private const VALIDATE_USER_POINTERS: bool = true

// write(fd, buf, len): to a file (keel.fs), or for descriptors 1 and 2 to the console. Every page of the
// buffer is checked against the process's translation tables first — mapped, and mapped for the user —
// so a bad pointer anywhere in it answers EFAULT and prints nothing, rather than faulting in the kernel
// or printing kernel memory.
private sys_write(p: *Process, regs: *u64) -> Result[i64, Errno]
    val fd = regs[0]
    val buf = UserAddr(regs[1])
    val len = regs[2]
    if fd != STDOUT && fd != STDERR then return fs.sys_write(p, regs)
    if len == 0 then return Ok(0)

    if !VALIDATE_USER_POINTERS
        for i in 0..<len
            val b: *u8 = ptr_cast(usize(u64(buf) + i))
            put_byte(*b)
        return Ok(i64(len))

    if !user_readable(&p.space, buf, len) then return Err(EFAULT)
    console.lock()
    var done: u64 = 0
    while done < len
        val va = u64(buf) + done
        val chunk = min(len - done, mm.PAGE_SIZE - (va & (mm.PAGE_SIZE - 1)))
        val (pa, _) = mm.user_translate(&p.space, va) match
            Some(t) -> t
            None -> (mm.PhysAddr(0), false)
        val src: *u8 = ptr_cast(usize(u64(mm.to_virt(pa))))
        for i in 0..<chunk
            put_byte(src[usize(i)])
        done += chunk
    console.unlock()
    Ok(i64(len))

// One write's bytes stay together on the console, whichever cores are writing.
private var console: SpinLock = SpinLock(0)

// Whether all of `len` bytes from `addr` are user memory of this space: inside the user range with no
// wrap around, and every page they touch mapped.
private user_readable(s: *mm.Space, addr: UserAddr, len: u64) -> bool = mm.user_range(s, u64(addr), len, false)

private min(a: u64, b: u64) -> u64 = if a < b then a else b

// brk(addr): move the end of the heap to `addr`, mapping fresh zeroed pages or giving pages back, and
// answer the end as it now is — unchanged when `addr` is outside [heap start, heap limit] or memory ran
// out, which is how a caller tells. brk(0) asks where it is.
private sys_brk(p: *Process, regs: *u64) -> Result[i64, Errno]
    val want = regs[0]
    if want < p.heap_base || want > mm.heap_limit() then return Ok(i64(p.brk))
    val old_top = page_up(p.brk)
    val new_top = page_up(want)
    var va = old_top
    while va < new_top
        mm.map_user_page(&p.space, va, mm.UserProt(true, false)) match
            Some(_) -> va += mm.PAGE_SIZE
            None ->
                while va > old_top
                    va -= mm.PAGE_SIZE
                    mm.unmap_user_page(&p.space, va)
                return Ok(i64(p.brk))
    va = new_top
    while va < old_top
        mm.unmap_user_page(&p.space, va)
        va += mm.PAGE_SIZE
    p.brk = want
    Ok(i64(want))
