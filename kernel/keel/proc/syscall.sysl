module keel.proc

import abi.keel.abi.{EAGAIN, EFAULT, EINTR, EINVAL, ENOSYS, EPERM, ETIMEDOUT, Errno, FUTEX_CLOCK_REALTIME,
    FUTEX_PRIVATE_FLAG, FUTEX_WAIT, FUTEX_WAKE, SYS_BIND, SYS_BRK, SYS_CHDIR, SYS_CLONE, SYS_CLOSE,
    SYS_DUP, SYS_DUP3, SYS_EXECVE, SYS_EXIT, SYS_EXIT_GROUP, SYS_FACCESSAT, SYS_FCHMODAT, SYS_FCHOWNAT, SYS_FSTAT,
    SYS_FTRUNCATE, SYS_FUTEX, SYS_GETCWD, SYS_GETDENTS64, SYS_GETEGID, SYS_GETEUID, SYS_GETGID, SYS_GETPGID, SYS_GETPID,
    SYS_GETPPID, SYS_GETSID, SYS_GETTID, SYS_GETUID, SYS_IOCTL, SYS_KILL, SYS_LSEEK, SYS_MKDIRAT, SYS_NANOSLEEP, SYS_NEWFSTATAT,
    SYS_OPENAT, SYS_PIPE2, SYS_PROCS, SYS_READ, SYS_RECVFROM, SYS_RENAMEAT, SYS_RT_SIGACTION, SYS_RT_SIGPROCMASK,
    SYS_RT_SIGRETURN, SYS_SENDTO, SYS_SETGID, SYS_SETPGID, SYS_SETSID, SYS_SETSOCKOPT, SYS_SETUID, SYS_SET_TID_ADDRESS,
    SYS_SOCKET, SYS_SPAWN, SYS_SYNC, SYS_TRUNCATE, SYS_UNLINKAT, SYS_WAIT4, SYS_WRITE, Timespec, SYS_CLOCK_GETRES,
    SYS_CLOCK_GETTIME, SYS_CLOCK_NANOSLEEP, SYS_GETTIMEOFDAY, SYS_PPOLL, SYS_PSELECT6}
import keel.fs
import keel.mm
import keel.sched
import keel.sched.{IrqLock, Process}
import keel.timer

// System calls (user/abi has the numbers, Linux's aarch64 ones wherever keel has the call Linux has):
// `svc #0` from EL0 arrives here with the saved registers, the number in x8 and the arguments in x0 to
// x5; the answer goes back in x0, an error as its negative errno. `regs` is the whole trap frame
// (user.sysl's `UserRegs`): `clone` copies it and `execve` rewrites it.
//
// Every handler has the same shape — the process and its saved registers in, a `Result` out — and the
// dispatch is a `match` on the number. A table of the handlers' addresses (`[5]*extern(*Process, *u64)
// -> i64` in a module `val`) is the natural form, but its initializer is not folded into the image: it
// is computed in a `main` that an image entered at `_start` never runs, so every entry read as null
// (FINDINGS.md 31).
//
// Answers the x0 the call was made with when it answered EINTR and may be made again (every call but
// `nanosleep`, whose answer says how long was left), for `deliver` to restart it under SA_RESTART.
private[proc] system_call(regs: *u64) -> Option[u64]
    val p = current_process()
    val first = regs[0]
    val r = regs[8] match
        SYS_EXIT -> sys_exit(p, regs)
        SYS_EXIT_GROUP -> sys_exit_group(p, regs)
        SYS_WRITE -> sys_write(p, regs)
        SYS_GETPID -> sys_getpid(p, regs)
        SYS_GETTID -> Ok(i64(sched.current().user.tid))
        SYS_SET_TID_ADDRESS -> sys_set_tid_address(regs)
        SYS_FUTEX -> sys_futex(p, regs)
        SYS_BRK -> sys_brk(p, regs)
        SYS_OPENAT -> fs.sys_openat(p, regs)
        SYS_READ -> sys_read(p, regs)
        SYS_CLOSE -> sys_close(p, regs)
        SYS_LSEEK -> sys_lseek(p, regs)
        SYS_FSTAT -> sys_fstat(p, regs)
        SYS_NEWFSTATAT -> fs.sys_newfstatat(p, regs)
        SYS_MKDIRAT -> fs.sys_mkdirat(p, regs)
        SYS_GETDENTS64 -> sys_getdents64(p, regs)
        SYS_UNLINKAT -> fs.sys_unlinkat(p, regs)
        SYS_RENAMEAT -> fs.sys_renameat(p, regs)
        SYS_SYNC -> fs.sys_sync()
        SYS_GETCWD -> fs.sys_getcwd(p, regs)
        SYS_CHDIR -> fs.sys_chdir(p, regs)
        SYS_TRUNCATE -> fs.sys_truncate(p, regs)
        SYS_FTRUNCATE -> sys_ftruncate(p, regs)
        SYS_FACCESSAT -> fs.sys_faccessat(p, regs)
        SYS_WAIT4 -> sys_wait4(p, regs)
        SYS_GETPPID -> sys_getppid(p, regs)
        SYS_SOCKET -> sys_socket(p, regs)
        SYS_BIND -> sys_bind(p, regs)
        SYS_RECVFROM -> sys_recvfrom(p, regs)
        SYS_SENDTO -> sys_sendto(p, regs)
        SYS_SETSOCKOPT -> sys_setsockopt(p, regs)
        SYS_GETUID | SYS_GETEUID -> Ok(i64(p.uid))
        SYS_GETGID | SYS_GETEGID -> Ok(i64(p.gid))
        SYS_SETUID -> sys_setuid(p, regs)
        SYS_SETGID -> sys_setgid(p, regs)
        SYS_FCHMODAT -> fs.sys_fchmodat(p, regs)
        SYS_FCHOWNAT -> fs.sys_fchownat(p, regs)
        SYS_PIPE2 -> sys_pipe2(p, regs)
        SYS_DUP3 -> sys_dup3(p, regs)
        SYS_DUP -> sys_dup(p, regs)
        SYS_CLONE -> sys_clone(p, regs)
        SYS_EXECVE -> sys_execve(p, regs)
        SYS_RT_SIGACTION -> sys_rt_sigaction(p, regs)
        SYS_RT_SIGPROCMASK -> sys_rt_sigprocmask(p, regs)
        SYS_RT_SIGRETURN -> sys_rt_sigreturn(p, regs)
        SYS_KILL -> sys_kill(p, regs)
        SYS_SETPGID -> sys_setpgid(p, regs)
        SYS_GETPGID -> sys_getpgid(p, regs)
        SYS_SETSID -> sys_setsid(p)
        SYS_GETSID -> sys_getsid(p, regs)
        SYS_IOCTL -> sys_ioctl(p, regs)
        SYS_NANOSLEEP -> sys_nanosleep(p, regs)
        SYS_CLOCK_NANOSLEEP -> sys_clock_nanosleep(p, regs)
        SYS_CLOCK_GETTIME -> sys_clock_gettime(p, regs)
        SYS_CLOCK_GETRES -> sys_clock_getres(p, regs)
        SYS_GETTIMEOFDAY -> sys_gettimeofday(p, regs)
        SYS_PPOLL -> sys_ppoll(p, regs)
        SYS_PSELECT6 -> sys_pselect6(p, regs)
        SYS_SPAWN -> sys_spawn(p, regs)
        SYS_PROCS -> sys_procs(p, regs)
        else Err(ENOSYS)
    regs[0] = r match
        Ok(v) -> u64(v)
        Err(e) -> u64(-i64(e))
    r match
        Err(EINTR) if restartable(regs[8]) -> Some(first)
        _ -> None

// Whether a call that answered EINTR is made again for a handler with SA_RESTART: every call but the
// ones Linux never restarts that way — the sleeps, whose answer says how long was left, and ppoll and
// pselect6.
private restartable(nr: u64) -> bool =
    nr != SYS_NANOSLEEP && nr != SYS_CLOCK_NANOSLEEP && nr != SYS_PPOLL && nr != SYS_PSELECT6

// exit(code): the calling thread ends; the process ends with its last thread, and its status is the
// code its first thread passed, as Linux has it.
private sys_exit(p: *Process, regs: *u64) -> Result[i64, Errno]
    sched.leader_exit(p, i64(regs[0]))
    leave_thread()

// exit_group(code): every thread of the process ends.
private sys_exit_group(p: *Process, regs: *u64) -> Result[i64, Errno] = end(p, 0, 0, i64(regs[0]))

private sys_getpid(p: *Process, regs: *u64) -> Result[i64, Errno] = Ok(i64(p.pid))

// set_tid_address(*u32) -> the caller's thread id. The word is zeroed and futex-woken when the thread
// ends.
private sys_set_tid_address(regs: *u64) -> Result[i64, Errno]
    val t = sched.current()
    t.user.clear_tid = regs[0]
    Ok(i64(t.user.tid))

// futex(*u32, op, val, *Timespec | 0) -> FUTEX_WAIT: 0 once woken; FUTEX_WAKE: how many it woke
// (keel.sched's futex.sysl; keel.abi has the rules).
private sys_futex(p: *Process, regs: *u64) -> Result[i64, Errno]
    val addr = regs[0]
    val op = regs[1]
    if (op & FUTEX_CLOCK_REALTIME) != 0 then return Err(ENOSYS)
    val cmd = op & ~FUTEX_PRIVATE_FLAG
    if cmd != FUTEX_WAIT && cmd != FUTEX_WAKE then return Err(ENOSYS)
    if (addr & 3) != 0 then return Err(EINVAL)
    if cmd == FUTEX_WAKE
        val n = i64(i32(u32(regs[2] & 0xffff_ffff)))
        return Ok(i64(sched.futex_wake(p, addr, if n < 0 then 0 else u64(n))))
    var deadline: u64 = 0
    if regs[3] != 0
        var wait = Timespec(0, 0)
        val raw: *u8 = ptr_cast(&wait)
        if !mm.copy_from_user(&p.space, regs[3], raw[0..<sizeof(Timespec)]) then return Err(EFAULT)
        if wait.sec < 0 || wait.nsec < 0 || wait.nsec >= 1_000_000_000 then return Err(EINVAL)
        deadline = timer.now_ms() + u64(wait.sec) * 1000 + (u64(wait.nsec) + 999_999) / 1_000_000
    sched.futex_wait(p, addr, u32(regs[2] & 0xffff_ffff), deadline) match
        sched.FutexWait.Woken -> Ok(0)
        sched.FutexWait.Differs -> Err(EAGAIN)
        sched.FutexWait.TimedOut -> Err(ETIMEDOUT)
        sched.FutexWait.Interrupted -> Err(EINTR)
        sched.FutexWait.Unreadable -> Err(EFAULT)

// A user address: what a system call's pointer argument is. It is a number and nothing more — it has
// no dereference, so the kernel cannot read through one by mistake; `user_bytes` checks it against the
// process's own tables and answers where its bytes really are. A typed `UserPtr[T]` is not spellable
// as a distinct type (FINDINGS.md 32).
type UserAddr = new u64

// Off only to show what the check is for: with it off, a console `write` reads through whatever address
// the program passed (descriptors.sysl), and a bad one is a fault in the kernel.
private[proc] const VALIDATE_USER_POINTERS: bool = true

private sys_getppid(p: *Process, regs: *u64) -> Result[i64, Errno] = Ok(i64(p.ppid))

// setuid(uid), setgid(gid): only root may become someone else, and only to an id the disk can record
// as an owner (16 bits); anyone may set the id they already have. A process that gives up root cannot
// take it back.
private sys_setuid(p: *Process, regs: *u64) -> Result[i64, Errno]
    if regs[0] == u64(p.uid) then return Ok(0)
    if !may_change_ids(p) then return Err(EPERM)
    if regs[0] > 0xffff then return Err(EINVAL)
    p.uid = u32(regs[0])
    Ok(0)

private sys_setgid(p: *Process, regs: *u64) -> Result[i64, Errno]
    if regs[0] == u64(p.gid) then return Ok(0)
    if !may_change_ids(p) then return Err(EPERM)
    if regs[0] > 0xffff then return Err(EINVAL)
    p.gid = u32(regs[0])
    Ok(0)

// The one check both make: the caller is root.
private may_change_ids(p: *Process) -> bool = p.uid == 0

// Whether all of `len` bytes from `addr` are user memory of this space: inside the user range with no
// wrap around, and every page they touch mapped.
private[proc] user_readable(s: *mm.Space, addr: UserAddr, len: u64) -> bool =
    mm.user_range(s, u64(addr), len, false)

// brk(addr): move the end of the heap to `addr`, mapping fresh zeroed pages or giving pages back, and
// answer the end as it now is — unchanged when `addr` is outside [heap start, heap limit] or memory ran
// out, which is how a caller tells. brk(0) asks where it is.
private sys_brk(p: *Process, regs: *u64) -> Result[i64, Errno]
    val flags = brk_guard.lock()
    val r = brk_locked(p, regs[0])
    brk_guard.unlock(flags)
    Ok(r)

// Two threads of a process may move its break at once; one lock for every process's is enough.
private var brk_guard: IrqLock

private brk_locked(p: *Process, want: u64) -> i64
    if want < p.heap_base || want > mm.heap_limit() then return i64(p.brk)
    val old_top = page_up(p.brk)
    val new_top = page_up(want)
    var va = old_top
    while va < new_top
        mm.map_user_page(&p.space, va, mm.UserProt(true, false)) match
            Some(_) -> va += mm.PAGE_SIZE
            None ->
                while va > old_top
                    va -= mm.PAGE_SIZE
                    mm.unmap_user_page(&p.space, va)
                return i64(p.brk)
    va = new_top
    while va < old_top
        mm.unmap_user_page(&p.space, va)
        va += mm.PAGE_SIZE
    p.brk = want
    i64(want)
