module keel.proc

import abi.keel.abi.{EINTR, EINVAL, ENOSYS, EPERM, Errno, SYS_CHMOD, SYS_CHOWN, SYS_DUP, SYS_DUP2, SYS_GETGID, SYS_PIPE,
    SYS_GETUID, SYS_SETGID, SYS_SETUID, SYS_ACCESS, SYS_BRK, SYS_CHDIR, SYS_CLOSE,
    SYS_EXIT, SYS_FSTAT, SYS_FTRUNCATE, SYS_GETCWD, SYS_GETDENTS, SYS_GETPID, SYS_GETPPID, SYS_LSEEK, SYS_MKDIR,
    SYS_OPEN, SYS_READ, SYS_RENAME, SYS_RMDIR, SYS_SPAWN, SYS_STAT, SYS_SYNC, SYS_TRUNCATE, SYS_UNLINK, SYS_WAIT,
    SYS_WRITE, SYS_SOCKET, SYS_BIND, SYS_RECVFROM, SYS_SENDTO, SYS_SOCKCLOSE, SYS_FORK, SYS_EXECVE, SYS_SIGACTION,
    SYS_SIGPROCMASK, SYS_SIGRETURN, SYS_KILL, SYS_SETPGID, SYS_GETPGID, SYS_TCSETPGRP, SYS_TCGETPGRP, SYS_NANOSLEEP,
    SYS_PROCS}
import keel.fs
import keel.mm
import keel.sched.Process

// System calls (user/abi has the numbers): `svc #0` from EL0 arrives here with the saved registers, the
// number in x8 and the arguments in x0 to x5; the answer goes back in x0, an error as its negative
// errno. `regs` is the whole trap frame (user.sysl's `UserRegs`): `fork` copies it and `execve`
// rewrites it.
//
// Every handler has the same shape — the process and its saved registers in, a `Result` out — and the
// dispatch is a `match` on the number. A table of the handlers' addresses (`[5]*extern(*Process, *u64)
// -> i64` in a module `val`) is the natural form, but its initializer is not folded into the image: it
// is computed in a `main` that an image entered at `_start` never runs, so every entry read as null
// (FINDINGS.md 31).
//
// Answers the x0 the call was made with when it answered EINTR and may be made again (every call but
// `nanosleep`, whose answer says how long was left), for `deliver` to restart it under SA_RESTART.
private[proc] system_call(regs: *u64) -> Option[u64]
    val p = current_process()
    val first = regs[0]
    val r = regs[8] match
        SYS_EXIT -> sys_exit(p, regs)
        SYS_WRITE -> sys_write(p, regs)
        SYS_GETPID -> sys_getpid(p, regs)
        SYS_BRK -> sys_brk(p, regs)
        SYS_OPEN -> fs.sys_open(p, regs)
        SYS_READ -> sys_read(p, regs)
        SYS_CLOSE -> sys_close(p, regs)
        SYS_LSEEK -> fs.sys_lseek(p, regs)
        SYS_FSTAT -> fs.sys_fstat(p, regs)
        SYS_STAT -> fs.sys_stat(p, regs)
        SYS_MKDIR -> fs.sys_mkdir(p, regs)
        SYS_GETDENTS -> fs.sys_getdents(p, regs)
        SYS_UNLINK -> fs.sys_unlink(p, regs)
        SYS_RMDIR -> fs.sys_rmdir(p, regs)
        SYS_RENAME -> fs.sys_rename(p, regs)
        SYS_SYNC -> fs.sys_sync()
        SYS_GETCWD -> fs.sys_getcwd(p, regs)
        SYS_CHDIR -> fs.sys_chdir(p, regs)
        SYS_TRUNCATE -> fs.sys_truncate(p, regs)
        SYS_FTRUNCATE -> fs.sys_ftruncate(p, regs)
        SYS_ACCESS -> fs.sys_access(p, regs)
        SYS_SPAWN -> sys_spawn(p, regs)
        SYS_WAIT -> sys_wait(p, regs)
        SYS_GETPPID -> sys_getppid(p, regs)
        SYS_SOCKET -> sys_socket(p)
        SYS_BIND -> sys_bind(p, regs)
        SYS_RECVFROM -> sys_recvfrom(p, regs)
        SYS_SENDTO -> sys_sendto(p, regs)
        SYS_SOCKCLOSE -> sys_sockclose(p, regs)
        SYS_GETUID -> Ok(i64(p.uid))
        SYS_GETGID -> Ok(i64(p.gid))
        SYS_SETUID -> sys_setuid(p, regs)
        SYS_SETGID -> sys_setgid(p, regs)
        SYS_CHMOD -> fs.sys_chmod(p, regs)
        SYS_CHOWN -> fs.sys_chown(p, regs)
        SYS_PIPE -> sys_pipe(p, regs)
        SYS_DUP2 -> sys_dup2(p, regs)
        SYS_DUP -> sys_dup(p, regs)
        SYS_FORK -> sys_fork(p, regs)
        SYS_EXECVE -> sys_execve(p, regs)
        SYS_SIGACTION -> sys_sigaction(p, regs)
        SYS_SIGPROCMASK -> sys_sigprocmask(p, regs)
        SYS_SIGRETURN -> sys_sigreturn(p, regs)
        SYS_KILL -> sys_kill(p, regs)
        SYS_SETPGID -> sys_setpgid(p, regs)
        SYS_GETPGID -> sys_getpgid(p, regs)
        SYS_TCSETPGRP -> sys_tcsetpgrp(p, regs)
        SYS_TCGETPGRP -> sys_tcgetpgrp(p, regs)
        SYS_NANOSLEEP -> sys_nanosleep(p, regs)
        SYS_PROCS -> sys_procs(p, regs)
        else Err(ENOSYS)
    regs[0] = r match
        Ok(v) -> u64(v)
        Err(e) -> u64(-i64(e))
    r match
        Err(EINTR) if regs[8] != SYS_NANOSLEEP -> Some(first)
        _ -> None

private sys_exit(p: *Process, regs: *u64) -> Result[i64, Errno]
    p.exit_code = i64(regs[0])
    end(p, 0, 0)

private sys_getpid(p: *Process, regs: *u64) -> Result[i64, Errno] = Ok(i64(p.pid))

// A user address: what a system call's pointer argument is. It is a number and nothing more — it has
// no dereference, so the kernel cannot read through one by mistake; `user_bytes` checks it against the
// process's own tables and answers where its bytes really are. A typed `UserPtr[T]` is not spellable
// as a distinct type (FINDINGS.md 32).
type UserAddr = new u64

// Off only to show what the check is for: with it off, a console `write` reads through whatever address
// the program passed (descriptors.sysl), and a bad one is a fault in the kernel.
private[proc] const VALIDATE_USER_POINTERS: bool = true

private sys_getppid(p: *Process, regs: *u64) -> Result[i64, Errno] = Ok(i64(p.ppid))

// setuid(uid), setgid(gid): only root may become someone else, and only to an id the disk can record
// as an owner (16 bits). A process that gives up root cannot take it back.
private sys_setuid(p: *Process, regs: *u64) -> Result[i64, Errno]
    if !may_change_ids(p) then return Err(EPERM)
    if regs[0] > 0xffff then return Err(EINVAL)
    p.uid = u32(regs[0])
    Ok(0)

private sys_setgid(p: *Process, regs: *u64) -> Result[i64, Errno]
    if !may_change_ids(p) then return Err(EPERM)
    if regs[0] > 0xffff then return Err(EINVAL)
    p.gid = u32(regs[0])
    Ok(0)

// The one check both make: the caller is root.
private may_change_ids(p: *Process) -> bool = p.uid == 0

// Whether all of `len` bytes from `addr` are user memory of this space: inside the user range with no
// wrap around, and every page they touch mapped.
private[proc] user_readable(s: *mm.Space, addr: UserAddr, len: u64) -> bool =
    mm.user_range(s, u64(addr), len, false)

// brk(addr): move the end of the heap to `addr`, mapping fresh zeroed pages or giving pages back, and
// answer the end as it now is — unchanged when `addr` is outside [heap start, heap limit] or memory ran
// out, which is how a caller tells. brk(0) asks where it is.
private sys_brk(p: *Process, regs: *u64) -> Result[i64, Errno]
    val want = regs[0]
    if want < p.heap_base || want > mm.heap_limit() then return Ok(i64(p.brk))
    val old_top = page_up(p.brk)
    val new_top = page_up(want)
    var va = old_top
    while va < new_top
        mm.map_user_page(&p.space, va, mm.UserProt(true, false)) match
            Some(_) -> va += mm.PAGE_SIZE
            None ->
                while va > old_top
                    va -= mm.PAGE_SIZE
                    mm.unmap_user_page(&p.space, va)
                return Ok(i64(p.brk))
    va = new_top
    while va < old_top
        mm.unmap_user_page(&p.space, va)
        va += mm.PAGE_SIZE
    p.brk = want
    Ok(i64(want))
