module keel.proc

// Parents and children: the process table, and the `spawn`, `wait4` and `getppid` system calls.
//
// **Two ways to make a child.** `spawn(path, args, attr)` makes a new address space from an
// executable on the disk — exactly what `start` already did for the kernel — and gives the child its
// parent's current directory, environment and standard descriptors, any of them replaced as `attr`
// says (a shell's `>`, `<`, a pipeline's ends, an exported variable); the shell uses it, as
// posix_spawn is used, because it builds nothing only to throw it away. `fork` and `execve`
// (fork.sysl) are the other way: a copy-on-write copy of the caller, which may then replace its own
// image.
//
// **The table** holds every process from its start until it is reaped, ended or not, as raw pointers
// under one IrqLock (`family`); each entry keeps its own box alive through `Process.me`, as a thread
// does (keel.sched), so a parent needs no handle on its children. A process that ends is marked
// `ended` and its children are handed to init, pid 1 — exactly then, so an orphan is never without a
// parent to reap it. `wait4` sleeps on `changed`, which every ending wakes.

import abi.keel.abi.{ANY_CHILD, ARGS_ROOM, E2BIG, EAGAIN, ECHILD, EFAULT, EINTR, EINVAL, ENAMETOOLONG, ENOENT,
    ENOEXEC, EBADF, ENOMEM, ENV_ROOM, EPERM, Errno, ExitStatus, INIT_PID, MAX_FDS, NO_FD, RUSAGE_SIZE, SIGCHLD,
    SPAWN_FOREGROUND, SPAWN_SETPGROUP, SpawnAttr, WCONTINUED, WNOHANG, WUNTRACED, exit_status, signal_status}
import keel.fs
import keel.mm
import keel.sched
import keel.sched.{Holds, IrqLock, OpenFile, Process, WaitQueue}
import sysl.buf.{Buf, buf, buf_with_capacity}
import sysl.text.from_utf8

private[proc] const MAX_PROCS: usize = 64
private const MAX_PATH: usize = 256

private[proc] var table: [MAX_PROCS]*Process
private[proc] var family: IrqLock
private var changed: WaitQueue

// Put a new process in the table; false when it is full.
private[proc] enter(p: &sync Process) -> bool
    val raw: *Process = &*p
    val flags = family.lock()
    for i in 0..<MAX_PROCS
        if table[i] == null
            table[i] = raw
            raw.me = Some(p)
            family.unlock(flags)
            return true
    family.unlock(flags)
    false

// Take a process the kernel waits for out of the table.
private[proc] leave(p: *Process)
    val flags = family.lock()
    for i in 0..<MAX_PROCS
        if table[i] == p then table[i] = null
    family.unlock(flags)
    p.me = None

// The process has ended (its thread is on its way out): its parent may reap it and is sent SIGCHLD, and
// its children are init's now.
private[proc] ended(p: *Process)
    var wakes = sched.no_wakes()
    val flags = family.lock()
    p.ended = true
    for i in 0..<MAX_PROCS
        val c = table[i]
        if c == null then continue
        if c.ppid == p.pid then c.ppid = INIT_PID
        if c.pid == p.ppid && !c.ended then wakes.add(sched.post(c, SIGCHLD))
    val _ = changed.wake_all()
    family.unlock(flags)
    wakes.wake_all()

// Whether every process that started has been reaped.
all_reaped() -> bool = table_empty()

private[proc] table_empty() -> bool
    val flags = family.lock()
    var empty = true
    for i in 0..<MAX_PROCS
        if table[i] != null then empty = false
    family.unlock(flags)
    empty

// spawn(path, path_len, args, args_len, *SpawnAttr | 0) -> the child's pid
private[proc] sys_spawn(p: *Process, regs: *u64) -> Result[i64, Errno]
    val path_len = regs[1]
    if path_len == 0 then return Err(ENOENT)
    if path_len > u64(MAX_PATH) then return Err(ENAMETOOLONG)
    var path: [MAX_PATH]u8 = [0; MAX_PATH]
    if !mm.copy_from_user(&p.space, regs[0], path[0..<usize(path_len)]) then return Err(EFAULT)

    val args_len = regs[3]
    if args_len > ARGS_ROOM then return Err(E2BIG)
    var packed: Buf[u8] = buf_with_capacity(usize(args_len), 0)
    for _ in 0..<args_len
        packed.push(0)
    if args_len > 0 && !mm.copy_from_user(&p.space, regs[2], packed.view()) then return Err(EFAULT)
    val args = unpacked(packed.view())?
    val (env, fds, group) = asked_for(p, regs[4])?

    // The file must be executable by the caller; the child runs as the caller, or as the file's owner
    // when it is set-user-ID.
    val image = fs.read_executable(p.cwd[0..<p.cwd_len], path[0..<usize(path_len)], sched.cred_of(p))?
    val std = standard_files(p, fds)?
    start_image(image.bytes.view(), args.view(), p, std, env.view(), image.run_as, group) match
        Ok(child) -> Ok(i64(child.pid))
        Err(e) -> Err(errno_of(e))

// What a spawn's caller asked for besides the program and its arguments — the SpawnAttr at `va`, or
// every default for 0: the child's environment, the caller's descriptors for its 0 to 2, and its
// process group. A function of its own so that its frame is gone before the child is built (kernel
// stacks are 16 KiB).
private asked_for(p: *Process, va: u64) -> Result[(Buf[u8], [3]u64, Group), Errno]
    var attr = SpawnAttr([NO_FD, NO_FD, NO_FD], 0, 0, 0, 0, 0)
    if va != 0
        val b: *u8 = ptr_cast(&attr)
        if !mm.copy_from_user(&p.space, va, b[0..<sizeof(SpawnAttr)]) then return Err(EFAULT)
    var group = Group(INHERIT_GROUP, (attr.flags & SPAWN_FOREGROUND) != 0)
    if (attr.flags & SPAWN_SETPGROUP) != 0
        if attr.pgid == 0
            group.pgid = NEW_GROUP
        else if group_joinable(p, attr.pgid)
            group.pgid = attr.pgid
        else
            return Err(EPERM)
    val env: Buf[u8] = buf()
    if attr.env_given != 0
        if attr.env_len > ENV_ROOM then return Err(E2BIG)
        for _ in 0..<attr.env_len
            env.push(0)
        if attr.env_len > 0 && !mm.copy_from_user(&p.space, attr.env, env.view()) then return Err(EFAULT)
        if attr.env_len > 0 && env.at(env.len() - 1) != 0 then return Err(EINVAL)
    else
        for i in 0..<p.env.len
            env.push(p.env.bytes[i])
    Ok((env, attr.fds, group))

// The child's descriptors 0 to 2: for each, the caller's descriptor `fds[i]` names, or its own i for
// NO_FD (which may be free), counted as open once more. EBADF for a named descriptor that is not open.
private standard_files(p: *Process, fds: [3]u64) -> Result[[3]OpenFile, Errno]
    for i in 0..<3
        val fd = if fds[i] == NO_FD then u64(i) else fds[i]
        if fd >= MAX_FDS || (fds[i] != NO_FD && p.files[usize(fd)].holds == Holds.Free) then return Err(EBADF)
    var std: [3]OpenFile = [sched.free_file(); 3]
    for i in 0..<3
        val fd = if fds[i] == NO_FD then usize(i) else usize(fds[i])
        std[i] = p.files[fd]
        duplicate(std[i])
    Ok(std)

// NUL-terminated arguments, one after another, as strings.
private[proc] unpacked(packed: []const u8) -> Result[Buf[string], Errno]
    val out: Buf[string] = buf()
    var start: usize = 0
    for i in 0..<packed.len
        if packed[i] != 0 then continue
        val arg = from_utf8(packed[start..<i]) match
            Ok(s) -> s
            Err(_) -> return Err(EINVAL)
        out.push(arg)
        start = i + 1
    if start != packed.len then return Err(EINVAL)
    Ok(out)

private[proc] errno_of(e: LoadError) -> Errno = e match
    Unreadable(why) -> why
    NoMemory -> ENOMEM
    TooManyArgs -> E2BIG
    NoRoom -> EAGAIN
    _ -> ENOEXEC

// wait4(pid, *i32 status | 0, options, *rusage | 0) -> the pid of the child that ended: `pid` itself,
// any child for -1, one in the caller's group for 0, one in group -pid below -1. Sleeps until one has —
// or, with WNOHANG, answers 0 at once if none has; EINTR if a signal comes first. WUNTRACED and
// WCONTINUED ask about stopped children, and keel has none. A `rusage` is zeros: keel counts nothing.
private[proc] sys_wait4(p: *Process, regs: *u64) -> Result[i64, Errno]
    val want = i64(regs[0])
    val status_at = regs[1]
    val usage_at = regs[3]
    if (regs[2] & ~(WNOHANG | WUNTRACED | WCONTINUED)) != 0 then return Err(EINVAL)
    if status_at != 0 && !mm.user_range(&p.space, status_at, u64(sizeof(ExitStatus)), true) then return Err(EFAULT)
    if usage_at != 0 && !mm.user_range(&p.space, usage_at, RUSAGE_SIZE, true) then return Err(EFAULT)
    val found = ended_child(p, want, (regs[2] & WNOHANG) != 0)?
    val child = found match
        Some(c) -> c
        None -> return Ok(0)
    reap(child)
    if status_at != 0
        val how = if child.term_signal == 0 then exit_status(child.exit_code) else signal_status(child.term_signal)
        var status = ExitStatus(u32(how))
        val b: *u8 = ptr_cast(&status)
        if !mm.copy_to_user(&p.space, status_at, b[0..<sizeof(ExitStatus)]) then return Err(EFAULT)
    if usage_at != 0
        var zeros: [RUSAGE_SIZE]u8 = [0; RUSAGE_SIZE]
        if !mm.copy_to_user(&p.space, usage_at, zeros[..]) then return Err(EFAULT)
    Ok(i64(child.pid))

// Whether child `c` is one `want` names, `own_group` being the caller's: wait4's reading of its pid.
private wanted(c: *Process, want: i64, own_group: u64) -> bool
    if want == ANY_CHILD then return true
    if want == 0 then return c.pgid == own_group
    if want < 0 then return c.pgid == u64(-want)
    i64(c.pid) == want

// A child of `parent` that has ended — one `want` names — taken out of the table; None if there is a
// child but none has ended and `no_hang` says not to wait.
private ended_child(parent: *Process, want: i64, no_hang: bool) -> Result[Option[&sync Process], Errno]
    val flags = family.lock()
    loop
        var any = false
        for i in 0..<MAX_PROCS
            val c = table[i]
            if c == null || c.ppid != parent.pid then continue
            if !wanted(c, want, parent.pgid) then continue
            any = true
            if !c.ended then continue
            table[i] = null
            val handle = c.me
            c.me = None
            family.unlock(flags)
            return handle match
                Some(h) -> Ok(Some(h))
                None -> Err(ECHILD)
        if !any
            family.unlock(flags)
            return Err(ECHILD)
        if no_hang
            family.unlock(flags)
            return Ok(None)
        if !sched.sleep_interruptibly(parent, &changed, &family)
            family.unlock(flags)
            return Err(EINTR)
