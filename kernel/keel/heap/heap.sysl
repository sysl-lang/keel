module keel.heap

// The kernel heap: the allocator every `&T` box, `Buf`, `string` and closure in the kernel comes from.
// `kernel/sysl.hocon` names `keel_alloc` and `keel_free` as the program's allocating pair, so the
// compiler calls these for every block, telling both the block's size and the boundary it must begin
// on (`alloc(size, align)`, `free(p, size, align)`, the same two on both calls).
//
// Two kinds of block, both carved from frames, each with a `Page` header in the page holding the byte
// before the object, so `free` finds what a pointer belongs to by rounding `p - 1` down to its page:
//
//   small   eight size classes, 16 to 2048 bytes. A slab is one frame holding objects of one class
//           after its header, with its own free list. The slabs of a class that have a free object are
//           on a doubly-linked list; a slab whose last object comes back returns its frame. An object
//           of class `s` begins on min(s, 64): the frame is page-aligned and the header 64 bytes. So a
//           block asking for a boundary up to 64 takes the class of max(size, align).
//   large   anything bigger, or asking for more than 64: a run of whole frames, the object on its
//           boundary inside it, the run's first frame and length in the header. Freed straight back to
//           the frame allocator.
//
// `free` checks the size and boundary it is told against the kind of block it finds, so a free that
// names another block's shape stops the kernel. Running out is a panic that says so: the language has
// no way for an allocation to fail.

import keel.cpu
import keel.mm
import keel.mm.{Frame, PhysAddr}
import sysl.raw.ptr_cast
import sysl.sync.SpinLock

private const PAGE: u64 = 4096
private const HEADER: u64 = 64
private const CLASSES: usize = 8
private const MIN_SHIFT: u64 = 4                 // the smallest class is 16 bytes
private const LARGE: u32 = 0xffff_ffff
private const MAGIC: u32 = 0x6b65_6c68           // "kelh"

// The first 64 bytes of every frame (or run of frames) the heap owns.
private struct Page
    magic: u32
    class: u32                  // a size class, or LARGE
    used: u64                   // objects handed out (small), frames in the run (large)
    free: *u8                   // the first free object; each free object holds the next
    next: *Page                 // the class's list of slabs with a free object
    prev: *Page
    first: *Page                // large: the run's first frame, where the header may be further in

@assert(sizeof(Page) <= 64, "a page header fits in HEADER bytes")

private var lock: SpinLock = SpinLock(0)

// Per class, the first slab with a free object.
private var partial: [CLASSES]*Page

private var allocated: u64 = 0

@export("keel_alloc")
keel_alloc(size: usize, align: usize) -> *u8
    val flags = cpu.irq_save()
    lock.lock()
    val p = if is_small(u64(size), u64(align))
        small(class_for(u64(size), u64(align)))
    else
        large(u64(size), u64(align))
    allocated += 1
    lock.unlock()
    cpu.irq_restore(flags)
    p

@export("keel_free")
keel_free(p: *u8, size: usize, align: usize)
    if p == null then return
    val flags = cpu.irq_save()
    lock.lock()
    val page: *Page = ptr_cast(usize((u64(usize(p)) - 1) & ~(PAGE - 1)))
    if page.magic != MAGIC then panic("keel: free of a pointer the heap did not hand out")
    val small_block = is_small(u64(size), u64(align))
    if page.class == LARGE && !small_block
        page.magic = 0
        mm.free_frames(frame_of_page(page.first), page.used)
    else if page.class != LARGE && small_block && usize(page.class) == class_for(u64(size), u64(align))
        give_back(page, p)
    else
        panic("keel: free told a size or boundary the block was not taken with")
    allocated -= 1
    lock.unlock()
    cpu.irq_restore(flags)

// How many blocks are handed out and not yet freed.
live() -> u64 = allocated

// Whether a block of `size` bytes on `align` comes from a slab: its class must hold it and begin on its
// boundary, and no class begins on more than HEADER.
private is_small(size: u64, align: u64) -> bool = align <= HEADER && max(size, align) <= class_size(CLASSES - 1)

private class_for(size: u64, align: u64) -> usize = class_of(max(size, align))

private max(a: u64, b: u64) -> u64 = if a > b then a else b

private class_size(c: usize) -> u64 = u64(1) << (MIN_SHIFT + u64(c))

private class_of(n: u64) -> usize
    var c: usize = 0
    while class_size(c) < n
        c += 1
    c

// An object of class `c`, from the first slab that has one, or from a new slab.
private small(c: usize) -> *u8
    if partial[c] == null then partial[c] = new_slab(c)
    val page = partial[c]
    val obj = page.free
    val link: **u8 = ptr_cast(obj)
    page.free = *link
    page.used += 1
    if page.free == null then unlink(page, c)
    obj

// A frame cut into objects of class `c`, each free one pointing at the next.
private new_slab(c: usize) -> *Page
    val page = page_of_frame(frame_or_panic(1))
    val size = class_size(c)
    val count = (PAGE - HEADER) / size
    val base = u64(usize(page)) + HEADER
    for i in 0..<count
        val link: **u8 = ptr_cast(usize(base + i * size))
        *link = if i + 1 == count then null else ptr_cast(usize(base + (i + 1) * size))
    page.magic = MAGIC
    page.class = u32(c)
    page.used = 0
    page.free = ptr_cast(usize(base))
    page.next = null
    page.prev = null
    page.first = page
    page

private give_back(page: *Page, p: *u8)
    val c = usize(page.class)
    val was_full = page.free == null
    val link: **u8 = ptr_cast(p)
    *link = page.free
    page.free = p
    page.used -= 1
    if page.used == 0
        if !was_full then unlink(page, c)
        page.magic = 0
        mm.free_frame(frame_of_page(page))
    else if was_full
        page.prev = null
        page.next = partial[c]
        if partial[c] != null then partial[c].prev = page
        partial[c] = page

private unlink(page: *Page, c: usize)
    if page.prev != null then page.prev.next = page.next else partial[c] = page.next
    if page.next != null then page.next.prev = page.prev
    page.next = null
    page.prev = null

// A run of whole frames holding one object of `n` bytes on `align`. Below a page's boundary the object
// is `max(align, HEADER)` bytes into the run and the header is the run's first frame. From a page up the
// run is `align` longer, the object is on the first boundary at least a frame in, and the header is the
// frame just below it: the boundary is at most `align` in, so the object fits. Either way the header is
// the page holding the byte before the object.
private large(n: u64, align: u64) -> *u8
    val ahead = if align < PAGE then max(align, HEADER) else align
    val frames = (ahead + n + PAGE - 1) / PAGE
    val first = page_of_frame(frame_or_panic(frames))
    val start = u64(usize(first))
    val at = if align < PAGE then start + ahead else (start + PAGE + align - 1) & ~(align - 1)
    val page: *Page = if align < PAGE then first else ptr_cast(usize(at - PAGE))
    page.magic = MAGIC
    page.class = LARGE
    page.used = frames
    page.free = null
    page.next = null
    page.prev = null
    page.first = first
    ptr_cast(usize(at))

private frame_or_panic(n: u64) -> Frame = mm.alloc_frames(n) match
    Some(f) -> f
    None -> panic("keel: out of memory: the kernel heap asked for more frames than are free")

private page_of_frame(f: Frame) -> *Page = ptr_cast(usize(u64(mm.to_virt(mm.frame_addr(f)))))

private frame_of_page(p: *Page) -> Frame = mm.frame_of(mm.to_phys(mm.VirtAddr(u64(usize(p)))))
