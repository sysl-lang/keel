module keel.rt

// The C symbols a freestanding image has to define for itself: LLVM turns a loop that zeroes or
// copies memory, and a structure assignment, into calls to these, as any C compiler does
// (getting-started/cli.md § "Freestanding does not mean self-contained").
//
// They are ordinary loops. The compiler marks the code it emits for a freestanding target
// `no-builtins`, so LLVM does not recognise a loop here as a `memset` and call the function from
// inside itself. Byte at a time is slow, and nothing in keel is big enough yet to care.

@export("memset")
mem_set(dst: *u8, c: int, n: usize) -> *u8
    for i in 0..<n
        dst[i] = u8(c)
    dst

@export("memcpy")
mem_copy(dst: *u8, src: *u8, n: usize) -> *u8
    for i in 0..<n
        dst[i] = src[i]
    dst

@export("memmove")
mem_move(dst: *u8, src: *u8, n: usize) -> *u8
    if usize(dst) < usize(src)
        for i in 0..<n
            dst[i] = src[i]
    else
        var i = n
        while i > 0
            i -= 1
            dst[i] = src[i]
    dst

@export("memcmp")
mem_compare(a: *u8, b: *u8, n: usize) -> int
    for i in 0..<n
        if a[i] != b[i] then return int(a[i]) - int(b[i])
    0
