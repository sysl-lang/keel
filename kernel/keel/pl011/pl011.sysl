module keel.pl011

import keel.mm

// The ARM PL011 UART that QEMU's `virt` machine puts at 0x0900_0000. QEMU's model transmits without
// being configured, so this is the transmit half and nothing else: wait for room, write the byte.

// The registers, at the offsets the PL011 TRM gives them.
private struct Regs
    dr: volatile u32            // 0x00 data
    rsr: volatile u32           // 0x04 receive status / error clear
    reserved: [4]u32            // 0x08 .. 0x17
    fr: volatile u32            // 0x18 flags

private const BASE: u64 = 0x0900_0000  // physical
private const FR_TXFF: u32 = 1 << 5     // transmit FIFO full

// Through the kernel's device mapping, so only once the MMU is on.
private regs() -> *Regs = mm.io(mm.PhysAddr(BASE))

put_byte(b: u8)
    val r = regs()
    while (r.fr & FR_TXFF) != 0 do ()
    r.dr = u32(b)

// Write a string with no line ending, for a line built from several pieces.
put_str(s: string)
    for b in s.bytes
        put_byte(b)

// Write `v` as `0x` and sixteen hexadecimal digits. The standard library prints integers in decimal
// only, and a register value is read in hexadecimal.
put_hex(v: u64)
    put_str("0x")
    for i in 0..<16
        val d = u8((v >> (60 - 4 * i)) & 0xf)
        put_byte(if d < 10 then u8('0') + d else u8('a') + d - 10)

// The standard library's `print` writes through C's `putchar`, and a freestanding image has no C
// library to supply it, so the console is the supplier.
@export("putchar")
putchar(c: int) -> int
    put_byte(u8(c & 0xff))
    c
