module keel.gic

import keel.mm

// The Arm Generic Interrupt Controller, version 3, as QEMU's `virt` machine provides it with
// `gic-version=3`. Under HVF that is the only GIC there is: QEMU hands the guest the hypervisor's own
// GICv3, and a GICv2 CPU interface at 0x0801_0000 reads as zeros.
//
// Three parts: the distributor at 0x0800_0000 (shared interrupts, and the global enable), this
// processor's redistributor at 0x080A_0000 (its private interrupts: SGIs and PPIs, the timer's
// among them), and the CPU interface, which in GICv3 is system registers rather than memory.

// The distributor: the global enable, and the configuration of the shared peripheral interrupts (SPIs,
// 32 and up), a bit, two bits or a byte per interrupt in banks of 32-bit registers, and a 64-bit
// routing register each. The banks are sized for INTIDs below 128, which covers every device `virt`
// wires (its virtio-mmio slots are SPIs 16-47, INTIDs 48-79).
private struct Distributor
    ctlr: volatile u32                  // 0x000
    reserved0: [31]u32                  // 0x004 .. 0x07f
    igroupr: [32]volatile u32           // 0x080 group, a bit per interrupt
    isenabler: [32]volatile u32         // 0x100 set-enable, a bit per interrupt
    reserved1: [160]u32                 // 0x180 .. 0x3ff
    ipriorityr: [256]volatile u32       // 0x400 priority, a byte per interrupt
    reserved2: [256]u32                 // 0x800 .. 0xbff
    icfgr: [64]volatile u32             // 0xc00 trigger, two bits per interrupt (0b10 = edge)
    reserved3: [5312]u32                // 0xd00 .. 0x5fff
    irouter: [128]volatile u64          // 0x6000 routing, one register per interrupt

@assert(offsetof(Distributor, igroupr) == 0x080, "GICD_IGROUPR is at 0x080")
@assert(offsetof(Distributor, isenabler) == 0x100, "GICD_ISENABLER is at 0x100")
@assert(offsetof(Distributor, ipriorityr) == 0x400, "GICD_IPRIORITYR is at 0x400")
@assert(offsetof(Distributor, icfgr) == 0xc00, "GICD_ICFGR is at 0xc00")
@assert(offsetof(Distributor, irouter) == 0x6000, "GICD_IROUTER is at 0x6000")

private const CTLR_ENABLE_GRP1: u32 = 1 << 1
private const CTLR_ARE: u32 = 1 << 4         // affinity routing, which GICv3 private interrupts need

// A redistributor is two 64 KiB frames. The first holds its power state.
private struct RedistributorControl
    ctlr: volatile u32                  // 0x000
    iidr: volatile u32                  // 0x004
    typer: volatile u64                 // 0x008 read whole: under HVF either 32-bit half reads as 0
    statusr: volatile u32               // 0x010
    waker: volatile u32                 // 0x014

@assert(offsetof(RedistributorControl, waker) == 0x014, "GICR_WAKER is at 0x014")

private const WAKER_PROCESSOR_SLEEP: u32 = 1 << 1
private const WAKER_CHILDREN_ASLEEP: u32 = 1 << 2

// The second frame holds the private interrupts' configuration, one bit (or one priority byte) per
// interrupt ID 0-31.
private struct Redistributor
    reserved0: [32]u32                  // 0x000 .. 0x07f
    igroupr0: volatile u32              // 0x080 group
    reserved1: [31]u32                  // 0x084 .. 0x0ff
    isenabler0: volatile u32            // 0x100 set-enable
    reserved2: [191]u32                // 0x104 .. 0x3ff
    ipriorityr: [8]volatile u32         // 0x400 priority, a byte per interrupt

@assert(offsetof(Redistributor, igroupr0) == 0x080, "GICR_IGROUPR0 is at 0x080")
@assert(offsetof(Redistributor, isenabler0) == 0x100, "GICR_ISENABLER0 is at 0x100")
@assert(offsetof(Redistributor, ipriorityr) == 0x400, "GICR_IPRIORITYR is at 0x400")

// Physical addresses, reached through the kernel's device mapping.
private const DIST_BASE: u64 = 0x0800_0000
private const REDIST_BASE: u64 = 0x080A_0000
private const SGI_FRAME: u64 = 0x1_0000

// What `acknowledge` answers when nothing is pending after all.
const SPURIOUS: u32 = 1023

// Each core has a redistributor of its own: two frames, one after another in core order.
private const REDIST_STRIDE: u64 = 0x2_0000
private const TYPER_LAST: u64 = 1 << 4          // GICR_TYPER: the last redistributor in the region

// The interrupt keel sends a core to make it look at the run queue (an SGI, 0-15).
const RESCHEDULE: u32 = 0

private dist() -> *Distributor = mm.io(mm.PhysAddr(DIST_BASE))

// This core's redistributor: the one whose GICR_TYPER affinity is this core's MPIDR affinity. The
// search is made each time rather than remembered, because remembering it is per-core data and keel
// keeps that only in `sched.Cpu`; it runs only while a core sets itself up.
private redist_base() -> u64
    val me = mpidr_affinity()
    var base = REDIST_BASE
    loop
        val r: *RedistributorControl = mm.io(mm.PhysAddr(base))
        val typer = r.typer                     // one 64-bit read: HVF's GIC answers 32-bit halves with 0
        if u32((typer >> 32) & 0xffff) == me then return base   // [63:32]: Aff3.Aff2.Aff1.Aff0
        if (typer & TYPER_LAST) != 0 then panic("keel: no redistributor for this core")
        base += REDIST_STRIDE

private redist_control() -> *RedistributorControl = mm.io(mm.PhysAddr(redist_base()))
private redist() -> *Redistributor = mm.io(mm.PhysAddr(redist_base() + SGI_FRAME))

// MPIDR_EL1's Aff1.Aff0, as GICR_TYPER's low affinity bytes hold them.
private mpidr_affinity() -> u32 = u32(read_sysreg("mpidr_el1") & 0xffff)

// Switch on the distributor, once, from the boot core; then the boot core's own interface.
init()
    dist().ctlr = dist().ctlr | CTLR_ARE | CTLR_ENABLE_GRP1
    init_cpu()

// Wake this core's redistributor, and open its CPU interface to group 1 interrupts of every priority.
// Every core runs this for itself.
init_cpu()
    val w = redist_control()
    w.waker = w.waker & ~WAKER_PROCESSOR_SLEEP
    while (w.waker & WAKER_CHILDREN_ASLEEP) != 0 do ()

    enable_system_registers()
    set_priority_mask(0xff)
    enable_group1()

// Send software-generated interrupt `id` to the core whose MPIDR Aff0 is `core` (in cluster 0, which
// is every core QEMU's `virt` has up to 16). ICC_SGI1R_EL1: INTID [27:24], Aff1 [23:16], the target
// list [15:0] a bit per Aff0. The run queue the target will look at was written before this, and a
// system register write is not a memory access, so no `sysl.sync` ordering puts the stores first: the
// `dsb ishst` does (FINDINGS.md 28).
send_sgi(id: u32, core: u64)
    dsb(ishst)
    write_sysreg("icc_sgi1r_el1", (u64(id) << 24) | (u64(1) << core))
    isb()

// Enable private interrupt `id` (0-31: an SGI or a PPI) in group 1 on this core's redistributor, which
// this processor takes as an IRQ, at the middle priority.
enable(id: u32)
    val r = redist()
    val word = usize(id / 4)
    val shift = (id % 4) * 8
    r.ipriorityr[word] = (r.ipriorityr[word] & ~(u32(0xff) << shift)) | (u32(0x80) << shift)
    r.igroupr0 = r.igroupr0 | (u32(1) << id)
    r.isenabler0 = u32(1) << id

// Enable shared interrupt `id` (32 and up), level-triggered, in group 1 at the middle priority, and
// route it to the core whose MPIDR affinity is `core` (Aff0; every `virt` core is in cluster 0). Called
// once, from the core that sets the device up; the distributor is shared, so no redistributor is
// involved.
enable_spi(id: u32, core: u64)
    val d = dist()
    val bank = usize(id / 32)
    val bit = u32(1) << (id % 32)
    val word = usize(id / 4)
    val shift = (id % 4) * 8
    d.ipriorityr[word] = (d.ipriorityr[word] & ~(u32(0xff) << shift)) | (u32(0x80) << shift)
    val cfg = usize(id / 16)
    d.icfgr[cfg] = d.icfgr[cfg] & ~(u32(3) << ((id % 16) * 2))      // 0b00: level-sensitive
    d.irouter[usize(id)] = core                                       // IRM = 0: that core alone
    d.igroupr[bank] = d.igroupr[bank] | bit
    d.isenabler[bank] = bit

// Take the highest-priority pending interrupt, answering its ID. Its source then waits for
// `complete` before it can be delivered again.
acknowledge() -> u32 = u32(read_sysreg("icc_iar1_el1") & 0xff_ffff)

// Signal that interrupt `id` has been handled.
complete(id: u32)
    write_sysreg("icc_eoir1_el1", u64(id))
    isb()

// Reach the CPU interface through system registers (ICC_SRE_EL1.SRE).
private enable_system_registers()
    write_sysreg("icc_sre_el1", read_sysreg("icc_sre_el1") | 1)
    isb()

// Let through interrupts of a priority numerically below `mask`.
private set_priority_mask(mask: u64) = write_sysreg("icc_pmr_el1", mask)

private enable_group1()
    write_sysreg("icc_igrpen1_el1", 1)
    isb()
