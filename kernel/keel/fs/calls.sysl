module keel.fs

// The filesystem's system calls (user/abi has the numbers and the flags), dispatched from keel.proc.
// Each takes the process and its saved registers and answers a `Result`, which keel.proc turns into the
// x0 the program sees: the value, or the error's negative number.
//
// Every user pointer is checked against the process's own tables before anything else happens, and
// read or written only through the kernel's linear map (keel.mm's `copy_from_user`/`copy_to_user`).
// Bytes move between a program and a file through a small buffer on the kernel stack, one chunk at a
// time, all under the filesystem's lock.
//
// What is simplified: an inode open on a descriptor cannot be unlinked (EBUSY) rather than living on
// until it is closed; `rename` does not replace a directory, or replace anything with one (EEXIST); and
// an operation that fails half way through can leave a block or an inode allocated and unnamed, which
// mkfs's check reports.

import abi.keel.abi.{AT_EACCESS, AT_EMPTY_PATH, AT_FDCWD, AT_REMOVEDIR, AT_SYMLINK_NOFOLLOW, DIRENT64_NAME, DT_DIR, DT_REG,
    EBADF, EBUSY, EEXIST, EFAULT, EINVAL, EISDIR, EMFILE, ENAMETOOLONG, ENOENT, ENOTDIR, EOPNOTSUPP, EPERM, ENOTEMPTY,
    ERANGE, ESPIPE, Errno, FIRST_FILE_FD, MAX_FDS, O_ACCMODE, O_APPEND, O_CREAT, O_DIRECTORY, O_EXCL, O_RDONLY, O_TRUNC,
    O_WRONLY, PATH_ROOM, SEEK_CUR, SEEK_END, SEEK_SET, Stat}
import keel.mm
import keel.sched.{Cred, Holds, OpenFile, Process, cred_of, lock_files, unlock_files}
import ondisk.keel.ondisk
import ondisk.keel.ondisk.{BLOCK_SIZE, DIRENT_SIZE, Dirent, Inode, KIND_DIR, KIND_FILE, PERMISSION_BITS, ROOT_INO,
    S_IFMT}

private const MAX_PATH: usize = usize(PATH_ROOM)
private const CHUNK: usize = 512

// openat(dirfd, path, flags, mode) -> fd. A file made by O_CREAT gets `mode` less the process's umask.
sys_openat(p: *Process, regs: *u64) -> Result[i64, Errno]
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, regs[0], regs[1], room[..])?
    val flags = regs[2]
    val access = flags & O_ACCMODE
    if access == O_ACCMODE then return Err(EINVAL)
    // The descriptor is chosen and filled in under the table's lock, held across the open (the
    // table's lock comes before the filesystem's): another thread cannot be handed it meanwhile.
    val t = lock_files(p)
    defer unlock_files(p)
    var fd = FIRST_FILE_FD
    while fd < MAX_FDS && t.slots[usize(fd)].holds != Holds.Free
        fd += 1
    if fd == MAX_FDS then return Err(EMFILE)

    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val ino = resolve(st, path, who) match
        Ok(ino) ->
            if (flags & O_CREAT) != 0 && (flags & O_EXCL) != 0 then return Err(EEXIST)
            ino
        Err(ENOENT) ->
            if (flags & O_CREAT) == 0 then return Err(ENOENT)
            create(st, path, KIND_FILE, who, regs[3] & ~u64(p.umask))?
        Err(e) -> return Err(e)
    var i = read_inode(st, ino)?
    if (flags & O_DIRECTORY) != 0 && i.kind != KIND_DIR then return Err(ENOTDIR)
    if i.kind == KIND_DIR && access != O_RDONLY then return Err(EISDIR)
    val want = if access == O_RDONLY then MAY_READ elif access == O_WRONLY then MAY_WRITE else MAY_READ | MAY_WRITE
    allowed(&i, who, want)?
    if (flags & O_TRUNC) != 0 && access != O_RDONLY && i.kind == KIND_FILE && i.size != 0
        truncate(st, &i)?
        write_inode(st, ino, i)?
    st.opens[usize(ino)] += 1
    t.slots[usize(fd)] = OpenFile(Holds.File, ino, u32(flags), 0)
    Ok(i64(fd))

// read(fd, buf, len) -> bytes read, from `f`, the descriptor's slot, which is a file (keel.proc has
// the console's, and holds the table locked for the call).
sys_read(p: *Process, f: *OpenFile, regs: *u64) -> Result[i64, Errno]
    if (u64(f.flags) & O_ACCMODE) == O_WRONLY then return Err(EBADF)
    val va = regs[1]
    val len = regs[2]
    if !mm.user_range(&p.space, va, len, true) then return Err(EFAULT)

    val st = lock()
    defer unlock()
    var i = read_inode(st, f.ino)?
    if i.kind == KIND_DIR then return Err(EISDIR)
    var chunk: [CHUNK]u8 = [0; CHUNK]
    var done: u64 = 0
    while done < len
        val want = min(len - done, u64(CHUNK))
        val n = read_bytes(st, &i, f.offset, chunk[0..<usize(want)])?
        if n == 0 then break
        if !mm.copy_to_user(&p.space, va + done, chunk[0..<n]) then return Err(EFAULT)
        f.offset += u64(n)
        done += u64(n)
    Ok(i64(done))

// write(fd, buf, len) -> bytes written, to `f`, which is a file (as sys_read).
sys_write(p: *Process, f: *OpenFile, regs: *u64) -> Result[i64, Errno]
    if (u64(f.flags) & O_ACCMODE) == O_RDONLY then return Err(EBADF)
    val va = regs[1]
    val len = regs[2]
    if !mm.user_range(&p.space, va, len, false) then return Err(EFAULT)

    val st = lock()
    defer unlock()
    var i = read_inode(st, f.ino)?
    if (u64(f.flags) & O_APPEND) != 0 then f.offset = i.size
    var chunk: [CHUNK]u8 = [0; CHUNK]
    var done: u64 = 0
    var failed: Option[Errno] = None
    while done < len
        val want = usize(min(len - done, u64(CHUNK)))
        if !mm.copy_from_user(&p.space, va + done, chunk[0..<want]) then return Err(EFAULT)
        val n = write_bytes(st, &i, f.offset, chunk[0..<want]) match
            Ok(n) -> n
            Err(e) ->
                failed = Some(e)
                break
        f.offset += u64(n)
        done += u64(n)
        if n < want then break
    // The inode is written back whatever happened: blocks given to the file belong to it now.
    write_inode(st, f.ino, i)?
    failed match
        Some(e) -> if done == 0 then return Err(e)
        None -> ()
    Ok(i64(done))

// A second descriptor now stands for inode `ino` (keel.proc's dup2, dup and spawn): it stays open until
// both are closed.
opened_again(ino: u32)
    val st = lock()
    defer unlock()
    st.opens[usize(ino)] += 1

// A descriptor that stood for inode `ino` has been closed (keel.proc's close, and a process's end).
closed(ino: u32)
    val st = lock()
    defer unlock()
    st.opens[usize(ino)] -= 1

// lseek(fd, offset, whence) -> the new offset. Past the end is allowed: a write there fills the gap
// with zeros. A pipe or the console has no offset. `f` is the descriptor's slot, open, in a table
// keel.proc holds locked for the call, as for every call below that takes one.
sys_lseek(p: *Process, f: *OpenFile, regs: *u64) -> Result[i64, Errno]
    if f.holds != Holds.File then return Err(ESPIPE)
    val base = regs[2] match
        SEEK_SET -> 0
        SEEK_CUR -> i64(f.offset)
        SEEK_END ->
            val st = lock()
            defer unlock()
            i64(read_inode(st, f.ino)?.size)
        else return Err(EINVAL)
    val at = base + i64(regs[1])
    if at < 0 then return Err(EINVAL)
    f.offset = u64(at)
    Ok(at)

// fstat(fd, *Stat) -> 0
sys_fstat(p: *Process, f: *OpenFile, regs: *u64) -> Result[i64, Errno]
    file_in(f)?
    val st = lock()
    defer unlock()
    val s = stat_of(f.ino, read_inode(st, f.ino)?)
    stat_out(p, regs[1], s)

// newfstatat(dirfd, path, *Stat, flags) -> 0. keel has no symbolic links, so AT_SYMLINK_NOFOLLOW
// changes nothing; with AT_EMPTY_PATH an empty path is `dirfd` itself, as fstat.
sys_newfstatat(p: *Process, regs: *u64) -> Result[i64, Errno]
    val flags = regs[3]
    if (flags & ~(AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH)) != 0 then return Err(EINVAL)
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    if (flags & AT_EMPTY_PATH) != 0
        var first: [1]u8 = [0]
        mm.copy_cstr_from_user(&p.space, regs[1], first[..]) match
            Some(0) ->
                if i64(regs[0]) != AT_FDCWD
                    val t = lock_files(p)
                    defer unlock_files(p)
                    if regs[0] >= MAX_FDS then return Err(EBADF)
                    val f = &t.slots[usize(regs[0])]
                    file_in(f)?
                    val st = lock()
                    defer unlock()
                    return stat_out(p, regs[2], stat_of(f.ino, read_inode(st, f.ino)?))
            None -> return Err(EFAULT)
            _ -> ()
    val path = path_at(p, regs[0], regs[1], room[..], (flags & AT_EMPTY_PATH) != 0)?
    val st = lock()
    defer unlock()
    val ino = resolve(st, path, cred_of(p))?
    val s = stat_of(ino, read_inode(st, ino)?)
    stat_out(p, regs[2], s)

// mkdirat(dirfd, path, mode) -> 0: a directory of `mode` less the process's umask.
sys_mkdirat(p: *Process, regs: *u64) -> Result[i64, Errno]
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, regs[0], regs[1], room[..])?
    val st = lock()
    defer unlock()
    val _ = create(st, path, KIND_DIR, cred_of(p), regs[2] & ~u64(p.umask))?
    Ok(0)

// getdents64(fd, buf, len) -> bytes: as many whole `linux_dirent64` records as fit, from where the last
// call stopped. EINVAL when not even the next one fits.
sys_getdents64(p: *Process, f: *OpenFile, regs: *u64) -> Result[i64, Errno]
    file_in(f)?
    val va = regs[1]
    val len = regs[2]
    if !mm.user_range(&p.space, va, len, true) then return Err(EFAULT)
    val st = lock()
    defer unlock()
    var d = read_inode(st, f.ino)?
    if d.kind != KIND_DIR then return Err(ENOTDIR)
    val count = usize(d.size) / DIRENT_SIZE
    var slot = usize(f.offset) / DIRENT_SIZE
    var done: u64 = 0
    while slot < count
        var e = entry_at(st, &d, slot)?
        if e.ino == 0
            slot += 1
            continue
        var rec: [RECORD_ROOM]u8 = [0; RECORD_ROOM]
        val n = record64(&e, u64((slot + 1) * DIRENT_SIZE), rec[..])
        if done + u64(n) > len then break
        if !mm.copy_to_user(&p.space, va + done, rec[0..<n]) then return Err(EFAULT)
        done += u64(n)
        slot += 1
    if done == 0 && slot < count then return Err(EINVAL)
    f.offset = u64(slot * DIRENT_SIZE)
    Ok(i64(done))

// A `linux_dirent64` is 19 bytes, a name of up to 24 and its NUL, padded to 8.
private const RECORD_ROOM: usize = 48

// Directory entry `e` as a `linux_dirent64` record in `out`, `next` the offset of the entry after it;
// answers the record's length.
private record64(e: *Dirent, next: u64, out: []u8) -> usize
    val name = usize(e.len)
    val n = (usize(DIRENT64_NAME) + name + 1 + 7) & ~usize(7)
    put_le(out[0..<8], u64(e.ino))
    put_le(out[8..<16], next)
    put_le(out[16..<18], u64(n))
    out[18] = if u16(e.kind) == KIND_DIR then DT_DIR else DT_REG
    for i in 0..<name
        out[usize(DIRENT64_NAME) + i] = e.name[i]
    n

// `v` little-endian into all of `out`.
private put_le(out: []u8, v: u64)
    for i in 0..<out.len
        out[i] = u8((v >> u64(8 * i)) & 0xff)

// unlinkat(dirfd, path, flags) -> 0: a file, or with AT_REMOVEDIR an empty directory.
sys_unlinkat(p: *Process, regs: *u64) -> Result[i64, Errno]
    if regs[2] == AT_REMOVEDIR then return rmdir(p, regs)
    if regs[2] != 0 then return Err(EINVAL)
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, regs[0], regs[1], room[..])?
    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val (dir_ino, name) = parent_of(st, path, who)?
    var dir = read_inode(st, dir_ino)?
    val f = named(st, &dir, name)?
    allowed(&dir, who, MAY_WRITE | MAY_EXEC)?
    if f.kind == KIND_DIR then return Err(EISDIR)
    if st.opens[usize(f.ino)] != 0 then return Err(EBUSY)
    clear_slot(st, &dir, f.slot)?
    free_inode(st, f.ino)?
    Ok(0)

// unlinkat's AT_REMOVEDIR: an empty directory.
private rmdir(p: *Process, regs: *u64) -> Result[i64, Errno]
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, regs[0], regs[1], room[..])?
    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val (dir_ino, name) = parent_of(st, path, who)?
    var dir = read_inode(st, dir_ino)?
    val f = named(st, &dir, name)?
    allowed(&dir, who, MAY_WRITE | MAY_EXEC)?
    if f.kind != KIND_DIR then return Err(ENOTDIR)
    if st.opens[usize(f.ino)] != 0 then return Err(EBUSY)
    var victim = read_inode(st, f.ino)?
    if !is_empty(st, &victim)? then return Err(ENOTEMPTY)
    clear_slot(st, &dir, f.slot)?
    dir.links -= 1
    write_inode(st, dir_ino, dir)?
    free_inode(st, f.ino)?
    Ok(0)

// renameat(olddirfd, old, newdirfd, new) -> 0. A file may replace a file; a directory moves only to a
// name that is free, and never into itself.
sys_renameat(p: *Process, regs: *u64) -> Result[i64, Errno]
    var from_room: [MAX_PATH]u8 = [0; MAX_PATH]
    var to_room: [MAX_PATH]u8 = [0; MAX_PATH]
    val from = path_at(p, regs[0], regs[1], from_room[..])?
    val to = path_at(p, regs[2], regs[3], to_room[..])?
    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val (src_ino, src_name) = parent_of(st, from, who)?
    val (dst_ino, dst_name) = parent_of(st, to, who)?
    if dots(dst_name) then return Err(EINVAL)
    var src_dir = read_inode(st, src_ino)?
    val src = named(st, &src_dir, src_name)?
    var dst_dir = if dst_ino == src_ino then src_dir else read_inode(st, dst_ino)?
    if dst_dir.kind != KIND_DIR then return Err(ENOTDIR)
    allowed(&src_dir, who, MAY_WRITE | MAY_EXEC)?
    allowed(&dst_dir, who, MAY_WRITE | MAY_EXEC)?
    val existing = find(st, &dst_dir, dst_name)?
    existing match
        Some(e) ->
            if e.ino == src.ino then return Ok(0)
            if e.kind == KIND_DIR || src.kind == KIND_DIR then return Err(EEXIST)
            if st.opens[usize(e.ino)] != 0 then return Err(EBUSY)
        None -> ()
    if src.kind == KIND_DIR && inside(st, dst_ino, src.ino)? then return Err(EINVAL)

    if dst_ino == src_ino
        // One directory: the entry is renamed where it is, or takes the place of the one it replaces.
        existing match
            Some(e) ->
                set_slot(st, &src_dir, e.slot, src.ino, src.kind, dst_name)?
                clear_slot(st, &src_dir, src.slot)?
                free_inode(st, e.ino)?
            None -> set_slot(st, &src_dir, src.slot, src.ino, src.kind, dst_name)?
        write_inode(st, src_ino, src_dir)?
        return Ok(0)

    existing match
        Some(e) ->
            set_slot(st, &dst_dir, e.slot, src.ino, src.kind, dst_name)?
            free_inode(st, e.ino)?
        None -> add_entry(st, &dst_dir, dst_name, src.ino, src.kind)?
    clear_slot(st, &src_dir, src.slot)?
    if src.kind == KIND_DIR
        // A directory that moves names its new parent as `..`, and the parents' link counts follow.
        var moved = read_inode(st, src.ino)?
        val up = named(st, &moved, "..".bytes)?
        set_slot(st, &moved, up.slot, dst_ino, KIND_DIR, "..".bytes)?
        src_dir.links -= 1
        dst_dir.links += 1
    write_inode(st, src_ino, src_dir)?
    write_inode(st, dst_ino, dst_dir)?
    Ok(0)

// sync() -> 0
sys_sync() -> Result[i64, Errno]
    val st = lock()
    defer unlock()
    flush(st)?
    Ok(0)

// --- Shared by the calls above --------------------------------------------------------------------

// Make a file or a directory at `path`, which must not exist, owned by `who`, with the permission bits
// of `mode` (the caller has taken its umask off); its parent must exist and let `who` write and search it.
private create(st: *State, path: []const u8, kind: u16, who: Cred, mode: u64) -> Result[u32, Errno]
    val (dir_ino, name) = parent_of(st, path, who)?
    if dots(name) then return Err(EEXIST)
    var dir = read_inode(st, dir_ino)?
    if dir.kind != KIND_DIR then return Err(ENOTDIR)
    find(st, &dir, name)? match
        Some(_) -> return Err(EEXIST)
        None -> ()
    allowed(&dir, who, MAY_WRITE | MAY_EXEC)?
    val ino = new_inode(st, kind, who, u16(mode & u64(PERMISSION_BITS)))?
    if kind == KIND_DIR
        var d = read_inode(st, ino)?
        add_entry(st, &d, ".".bytes, ino, KIND_DIR)?
        add_entry(st, &d, "..".bytes, dir_ino, KIND_DIR)?
        d.links = 2
        write_inode(st, ino, d)?
        dir.links += 1
    add_entry(st, &dir, name, ino, kind)?
    write_inode(st, dir_ino, dir)?
    Ok(ino)

// The entry `name` in `dir`, which must be there and must not be `.` or `..`.
private named(st: *State, dir: *Inode, name: []const u8) -> Result[Found, Errno]
    if dots(name) && name != "..".bytes then return Err(EINVAL)
    find(st, dir, name)? match
        Some(f) -> Ok(f)
        None -> Err(ENOENT)

private dots(name: []const u8) -> bool = name == ".".bytes || name == "..".bytes

// Whether directory `dir` is `ancestor` or below it: a walk up the `..` entries to the root.
private inside(st: *State, dir: u32, ancestor: u32) -> Result[bool, Errno]
    var ino = dir
    loop
        if ino == ancestor then return Ok(true)
        if ino == ROOT_INO then return Ok(false)
        var d = read_inode(st, ino)?
        ino = named(st, &d, "..".bytes)?.ino

// A path argument: a NUL-terminated string at `va`, copied in, of a `*at` call whose directory
// descriptor is `dirfd`. One that does not begin with `/` is taken from the current directory — what
// comes back is the current directory, a `/`, and the argument, for `resolve` to walk from the root (`.`
// and `..` are entries every directory has, so the walk needs no help with them) — and so `dirfd` must
// be AT_FDCWD for one: keel keeps no path for an open directory, so a relative path from any other
// answers EOPNOTSUPP (EBADF when it is not open). An absolute path ignores `dirfd`, as Linux's does.
// An empty path is ENOENT, or the current directory when `empty_ok`.
private path_at(p: *Process, dirfd: u64, va: u64, room: []u8, empty_ok: bool = false) -> Result[[]const u8, Errno]
    var given: [MAX_PATH]u8 = [0; MAX_PATH]
    var len = mm.copy_cstr_from_user(&p.space, va, given[..]) match
        Some(n) -> n
        None -> return Err(EFAULT)
    if len == MAX_PATH then return Err(ENAMETOOLONG)
    if len == 0
        if !empty_ok then return Err(ENOENT)
        given[0] = u8('.')
        len = 1
    if given[0] != u8('/') && i64(dirfd) != AT_FDCWD
        if dirfd >= MAX_FDS then return Err(EBADF)
        val t = lock_files(p)
        val open = t.slots[usize(dirfd)].holds != Holds.Free
        unlock_files(p)
        return Err(if open then EOPNOTSUPP else EBADF)
    joined(p.cwd[0..<p.cwd_len], given[0..<len], room)

// getcwd(buf, size) -> bytes of the path with its NUL; ERANGE when they do not fit.
sys_getcwd(p: *Process, regs: *u64) -> Result[i64, Errno]
    val n = p.cwd_len
    if regs[1] < u64(n + 1) then return Err(ERANGE)
    var nul: [1]u8 = [0]
    if !mm.copy_to_user(&p.space, regs[0], p.cwd[0..<n]) then return Err(EFAULT)
    if !mm.copy_to_user(&p.space, regs[0] + u64(n), nul[..]) then return Err(EFAULT)
    Ok(i64(n + 1))

// chdir(path) -> 0. The directory is found by walking the path as given; what is kept is the same path
// with `.`, `..` and repeated slashes taken out of its text, which names the same directory because keel
// has no symbolic links.
sys_chdir(p: *Process, regs: *u64) -> Result[i64, Errno]
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, u64(AT_FDCWD), regs[0], room[..])?
    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val ino = resolve(st, path, who)?
    var d = read_inode(st, ino)?
    if d.kind != KIND_DIR then return Err(ENOTDIR)
    allowed(&d, who, MAY_EXEC)?
    var clean: [MAX_PATH]u8 = [0; MAX_PATH]
    val n = normalized(path, clean[..])
    for j in 0..<n
        p.cwd[j] = clean[j]
    p.cwd_len = n
    Ok(0)

// truncate(path, length) -> 0
sys_truncate(p: *Process, regs: *u64) -> Result[i64, Errno]
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, u64(AT_FDCWD), regs[0], room[..])?
    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val ino = resolve(st, path, who)?
    var i = read_inode(st, ino)?
    if i.kind == KIND_FILE then allowed(&i, who, MAY_WRITE)?
    resized(st, ino, regs[1])

// ftruncate(fd, length) -> 0, on a descriptor open for writing.
sys_ftruncate(p: *Process, f: *OpenFile, regs: *u64) -> Result[i64, Errno]
    file_in(f)?
    if (u64(f.flags) & O_ACCMODE) == O_RDONLY then return Err(EBADF)
    val st = lock()
    defer unlock()
    resized(st, f.ino, regs[1])

// faccessat(dirfd, path, how) -> 0 when the path names something and the caller may do what `how`
// asks (its low three bits: r 4, w 2, x 1; 0 asks only whether it is there).
sys_faccessat(p: *Process, regs: *u64) -> Result[i64, Errno]
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, regs[0], regs[1], room[..])?
    if regs[2] > 7 then return Err(EINVAL)
    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val ino = resolve(st, path, who)?
    var i = read_inode(st, ino)?
    allowed(&i, who, u16(regs[2]))?
    Ok(0)

// faccessat2(dirfd, path, how, flags) -> faccessat's answer. AT_EACCESS is the same check (one user id
// per process) and AT_SYMLINK_NOFOLLOW changes nothing (no links).
sys_faccessat2(p: *Process, regs: *u64) -> Result[i64, Errno]
    if (regs[3] & ~(AT_EACCESS | AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH)) != 0 then return Err(EINVAL)
    sys_faccessat(p, regs)

// readlinkat(dirfd, path, buf, len) -> EINVAL for anything that is there, since nothing on a keel disk is
// a symbolic link; ENOENT and the rest as the walk to it answers.
sys_readlinkat(p: *Process, regs: *u64) -> Result[i64, Errno]
    var args: [3]u64 = [regs[0], regs[1], 0]
    sys_faccessat(p, &args[0])?
    Err(EINVAL)

// utimensat(dirfd, path | 0, *times, flags) -> 0 once the path (or, with no path, the descriptor) is
// found: the disk keeps no times, so there is nothing to set (FORMAT.md).
sys_utimensat(p: *Process, regs: *u64) -> Result[i64, Errno]
    if regs[1] == 0
        val t = lock_files(p)
        val open = regs[0] < MAX_FDS && t.slots[usize(regs[0])].holds != Holds.Free
        unlock_files(p)
        return if open then Ok(0) else Err(EBADF)
    var args: [3]u64 = [regs[0], regs[1], 0]
    sys_faccessat(p, &args[0])

// fchmodat(dirfd, path, mode) -> 0: the set-user-ID and rwx bits of `mode` (others are EINVAL), by the
// owner or root (EPERM).
sys_fchmodat(p: *Process, regs: *u64) -> Result[i64, Errno]
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, regs[0], regs[1], room[..])?
    val mode = regs[2]
    if (mode | u64(PERMISSION_BITS)) != u64(PERMISSION_BITS) then return Err(EINVAL)
    val who = cred_of(p)
    val st = lock()
    defer unlock()
    val ino = resolve(st, path, who)?
    var i = read_inode(st, ino)?
    if who.uid != 0 && who.uid != u32(i.uid) then return Err(EPERM)
    i.mode = (i.mode & S_IFMT) | u16(mode)
    write_inode(st, ino, i)?
    Ok(0)

// fchownat(dirfd, path, uid, gid, flags) -> 0: root only (EPERM). An id of -1 is left as it is; any
// other fits 16 bits on the disk (EINVAL). keel has no links, so AT_SYMLINK_NOFOLLOW changes nothing.
sys_fchownat(p: *Process, regs: *u64) -> Result[i64, Errno]
    if (regs[4] & ~AT_SYMLINK_NOFOLLOW) != 0 then return Err(EINVAL)
    var room: [MAX_PATH]u8 = [0; MAX_PATH]
    val path = path_at(p, regs[0], regs[1], room[..])?
    val uid = u32(regs[2] & 0xffff_ffff)
    val gid = u32(regs[3] & 0xffff_ffff)
    val keep: u32 = 0xffff_ffff
    if (uid != keep && uid > 0xffff) || (gid != keep && gid > 0xffff) then return Err(EINVAL)
    val who = cred_of(p)
    if who.uid != 0 then return Err(EPERM)
    val st = lock()
    defer unlock()
    val ino = resolve(st, path, who)?
    var i = read_inode(st, ino)?
    if uid != keep then i.uid = u16(uid)
    if gid != keep then i.gid = u16(gid)
    write_inode(st, ino, i)?
    Ok(0)

private resized(st: *State, ino: u32, length: u64) -> Result[i64, Errno]
    if i64(length) < 0 then return Err(EINVAL)
    var i = read_inode(st, ino)?
    if i.kind == KIND_DIR then return Err(EISDIR)
    resize(st, &i, length)?
    write_inode(st, ino, i)?
    Ok(0)

// `path`, absolute, with its `.` and `..` components and empty ones taken out of the text, into `out`;
// answers its length. `..` at the root stays at the root, as the root's own `..` entry does.
private normalized(path: []const u8, out: []u8) -> usize
    var n: usize = 0
    var at: usize = 0
    while at < path.len
        while at < path.len && path[at] == u8('/')
            at += 1
        val start = at
        while at < path.len && path[at] != u8('/')
            at += 1
        val name = path[start..<at]
        if name.len == 0 || name == ".".bytes then continue
        if name == "..".bytes
            while n > 0 && out[n - 1] != u8('/')
                n -= 1
            if n > 0 then n -= 1
            continue
        out[n] = u8('/')
        n += 1
        for c in name
            out[n] = c
            n += 1
    if n == 0
        out[0] = u8('/')
        n = 1
    n

// EBADF unless the descriptor's slot `f` holds a file.
private file_in(f: *OpenFile) -> Result[unit, Errno]
    if f.holds != Holds.File then return Err(EBADF)
    Ok(())

// Linux's `struct stat` of inode `ino`: no device and no times, which keel keeps none of; `blocks` in
// 512-byte units, of whole filesystem blocks.
private stat_of(ino: u32, i: Inode) -> Stat
    val bs = u64(BLOCK_SIZE)
    val blocks = (i.size + bs - 1) / bs * (bs / 512)
    Stat(0, u64(ino), u32(i.mode), u32(i.links), u32(i.uid), u32(i.gid), 0, 0, i64(i.size), i32(BLOCK_SIZE), 0,
         i64(blocks), 0, 0, 0, 0, 0, 0, 0, 0)

private stat_out(p: *Process, va: u64, s: Stat) -> Result[i64, Errno]
    if !mm.copy_to_user(&p.space, va, bytes_of(&s)) then return Err(EFAULT)
    Ok(0)

// A value's bytes, for copying out to a program whose struct has the same layout (keel.abi's `Stat`
// is Linux's `struct stat`, whose size is `@assert`ed there).
private bytes_of[T](v: *T) -> []const u8
    val b: *u8 = ptr_cast(v)
    b[0..<sizeof(T)]

private min(a: u64, b: u64) -> u64 = if a < b then a else b
