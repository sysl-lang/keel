module keel.sched

import keel.mm
import sysl.sync.Atomic

// A user process: an address space, and the threads running in it (keel.proc creates, enters and ends
// them). It is declared here, beside `Thread`, because a thread names the process it runs and the
// scheduler loads that process's address space; keel.proc, which does everything else with it, imports
// this module, and modules may not import each other in a cycle.
//
// Its threads (group.sysl) share everything here: the space, the descriptors, the current directory,
// the signal actions and the pending set. What is each thread's own — its id, its registers, its TLS
// pointer, its blocked set — is in `Thread.user`.
struct Process
    pid: u64
    space: mm.Space
    heap_base: u64              // where the heap starts: the page after the last segment
    brk: u64                    // where it ends now; `brk` moves it, up to mm.heap_limit()
    threads: &sync Threads      // its threads, and whether they are being ended (group.sysl)
    sig: &sync Signals          // its signals: pending, the actions (signal.sysl)
    exit_code: i64              // what its first thread passed to `exit`, or any thread to `exit_group`
    fault: u64                  // the fault that ended it (keel.proc's encoding); 0 if none did
    preemptions: u64            // times the timer took the processor from its threads, once it has ended
    files: Mutex[Files]         // its descriptors, under their own lock (`lock_files`)
    cwd: [CWD_ROOM]u8           // the current directory: an absolute path with no `.`, `..` or `//`
    cwd_len: usize
    ppid: u64                   // the parent's pid; 0 for a process the kernel started and waits for
    ended: bool                 // it has ended and is waiting to be reaped (keel.proc's table lock)
    me: Option[&sync Process]   // the box keeping itself alive while it is in keel.proc's table
    uid: u32                    // who it runs as: 0 is root; a child starts with its parent's
    gid: u32                    // its one group; there are no supplementary groups
    env: &sync Env              // its environment, which a child is given unless its parent says otherwise
    pgid: u64                   // its process group
    sid: u64                    // its session: a child's is its parent's; `setsid` starts one numbered by its pid
    term_signal: u64            // the signal that ended it; 0 when it called `exit`
    name: [NAME_ROOM]u8         // argv[0], cut to NAME_ROOM bytes, for `procs`
    running: u64                // how many of its threads are on a core now; under the scheduler's lock
    parallel: u64               // the most that ever were at once
    cores: u64                  // a bit for each core any of its threads has run on
    umask: u32                  // the permission bits a file or directory it makes does not get; inherited

// Room for a process's name in its record (keel.abi's ProcInfo.name).
const NAME_ROOM: usize = 16

// A name as a process record holds it: the first NAME_ROOM bytes, the rest zero.
name_of(text: []const u8) -> [NAME_ROOM]u8
    var n: [NAME_ROOM]u8 = [0; NAME_ROOM]
    for i in 0..<text.len
        if i == NAME_ROOM then break
        n[i] = text[i]
    n

// Who a process runs as, for keel.fs's permission checks.
struct Cred
    uid: u32
    gid: u32

// The kernel's own processes, and every check it makes for itself, run as root.
root_cred() -> Cred = Cred(0, 0)

cred_of(p: *Process) -> Cred = Cred(p.uid, p.gid)

// Room for the current directory's path; keel.fs's longest path argument is the same.
const CWD_ROOM: usize = 256

// A new process's current directory, `/`.
root_dir() -> [CWD_ROOM]u8
    var d: [CWD_ROOM]u8 = [0; CWD_ROOM]
    d[0] = u8('/')
    d

// How many descriptors a process has, the console's three included (keel.abi's MAX_FDS).
const OPEN_FILES: usize = 16

// What a descriptor stands for. `Free` is first, so a zeroed descriptor is a free one.
enum Holds
    Free
    Console
    File            // `ino`, an inode of the filesystem (keel.fs)
    PipeRead        // `ino` is the pipe's slot (keel.proc's pipe table)
    PipeWrite
    Socket          // `ino` is the socket's slot in keel.net's table, `offset` its receive timeout in ms
    Stream          // `ino` is the TCP connection's slot in keel.net's table (its options live there)

// A descriptor: what it holds, and for a file the flags it was opened with and where the next read or
// write starts. Plain numbers, so a process can name its files and pipes without this module importing
// the filesystem or the pipes, which import this one.
struct OpenFile
    holds: Holds
    ino: u32
    flags: u32
    offset: u64

// A descriptor that holds nothing.
free_file() -> OpenFile = OpenFile(Holds.Free, 0, 0, 0)

// A process's descriptor table, indexed by descriptor: the console, a file, a pipe end, a socket, or
// free. Its threads share it, so it is only read or changed under `Process.files`' lock, which is a
// sleeping `Mutex`: a file's call holds it across the filesystem's own lock (in that order, never the
// other), and keel.proc's `duplicate`/`release` take a pipe's or a socket's `IrqLock` inside it.
struct Files
    slots: [OPEN_FILES]OpenFile

// A new process's descriptors: the console at 0 to 2, the rest free.
no_files() -> Mutex[Files]
    var f: [OPEN_FILES]OpenFile = [free_file(); OPEN_FILES]
    for fd in 0..<3
        f[fd] = console_file()
    mutex(Files(f))

// A descriptor that is the console.
console_file() -> OpenFile = OpenFile(Holds.Console, 0, 0, 0)

// Off only to show what the lock is for: with it off two threads opening, duplicating or closing at
// once can be handed one descriptor, and the boot test's `linuxthreads fds` finds it shared.
private const FILES_LOCKED: bool = true

// `p`'s descriptor table, locked; `unlock_files` lets it go.
lock_files(p: *Process) -> *Files
    val t = p.files.lock()
    if !FILES_LOCKED then p.files.unlock()
    t

unlock_files(p: *Process)
    if FILES_LOCKED then p.files.unlock()

// Room for a process's environment: `NAME=value` entries, each followed by a NUL (keel.abi's ENV_ROOM).
const ENV_ROOM: usize = 1024

// A process's environment, in a box of its own rather than inline: a Process is built by value before
// it is boxed, and a kernel stack is 16 KiB. A `Buf` cannot be a field, every count inside a `&sync`
// box having to be atomic.
struct Env
    bytes: [ENV_ROOM]u8
    len: usize

// An environment holding `entries`, which must fit ENV_ROOM.
env_of(entries: []const u8) -> &sync Env
    val e: &sync Env = Env([0; ENV_ROOM], entries.len)
    for i in 0..<entries.len
        e.bytes[i] = entries[i]
    e
