module keel.sched

import keel.mm
import sysl.sync.Atomic

// A user process: an address space, and the one thread running in it (keel.proc creates, enters and
// ends them). It is declared here, beside `Thread`, because a thread names the process it runs and the
// scheduler loads that process's address space; keel.proc, which does everything else with it, imports
// this module, and modules may not import each other in a cycle.
//
// One thread per process for now. A second would share `space` and `brk` (under a lock of the
// process's own), and `kernel` and `kill` would move to the thread.
struct Process
    pid: u64
    space: mm.Space
    heap_base: u64              // where the heap starts: the page after the last segment
    brk: u64                    // where it ends now; `brk` moves it, up to mm.heap_limit()
    kernel: Context             // the kernel side of entering user mode, which leaving it returns to
    kill: Atomic[u64]           // non-zero: end the process the next time it would return to user mode
    exit_code: i64              // what it passed to `exit`
    fault: u64                  // why it was killed (keel.proc's encoding); 0 when it exited by itself
    thread: Option[&sync Thread]
    preemptions: u64            // times the timer took the processor from its thread, once it has ended
    files: [OPEN_FILES]OpenFile // indexed by descriptor; 0 to 2 are the console unless a file stands there
    cwd: [CWD_ROOM]u8           // the current directory: an absolute path with no `.`, `..` or `//`
    cwd_len: usize
    ppid: u64                   // the parent's pid; 0 for a process the kernel started and waits for
    ended: bool                 // it has ended and is waiting to be reaped (keel.proc's table lock)
    me: Option[&sync Process]   // the box keeping itself alive while it is in keel.proc's table
    uid: u32                    // who it runs as: 0 is root; a child starts with its parent's
    gid: u32                    // its one group; there are no supplementary groups

// Who a process runs as, for keel.fs's permission checks.
struct Cred
    uid: u32
    gid: u32

// The kernel's own processes, and every check it makes for itself, run as root.
root_cred() -> Cred = Cred(0, 0)

cred_of(p: *Process) -> Cred = Cred(p.uid, p.gid)

// Room for the current directory's path; keel.fs's longest path argument is the same.
const CWD_ROOM: usize = 256

// A new process's current directory, `/`.
root_dir() -> [CWD_ROOM]u8
    var d: [CWD_ROOM]u8 = [0; CWD_ROOM]
    d[0] = u8('/')
    d

// How many descriptors a process has, the console's three included (keel.abi's MAX_FDS).
const OPEN_FILES: usize = 16

// A descriptor's file: an inode of the filesystem (keel.fs), the flags it was opened with, and where
// the next read or write starts. `ino` 0 is a free descriptor — or, for 0 to 2, the console. Plain
// numbers, so a process can name its
// files without this module importing the filesystem, which imports this one.
struct OpenFile
    ino: u32
    flags: u32
    offset: u64

no_files() -> [OPEN_FILES]OpenFile = [OpenFile(0, 0, 0); OPEN_FILES]
