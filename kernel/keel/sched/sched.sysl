module keel.sched

// The scheduler: round robin over one run queue shared by every core, preempted by each core's timer.
//
// One run queue for the whole machine, under one spinlock (`lock`), taken with IRQs masked — decided
// for SMP too, over per-core queues with stealing. With four cores and a hold of a few dozen
// instructions the lock is not the bottleneck; one queue needs no balancing (a ready thread runs on
// whichever core comes free first, which per-core queues only approximate by stealing), keeps the
// lock-handover argument below a single-lock argument, and has no second lock order to get wrong.
// Per-core queues are what to move to when a core count or a profile says the lock is contended, and
// what they would cost is a steal path and an affinity policy.
//
// What is per core is in `Cpu`: the running thread, the idle thread, the time slice, and the flag that
// asks for a switch. A core finds its own `Cpu` through TPIDR_EL1, read only with IRQs masked (see
// `this_cpu`). Every core runs the scheduler; each has an idle thread that sleeps in `wfi` while the
// queue is empty, and a thread made ready sends the reschedule interrupt (an SGI) to one idle core, so
// new work starts at once rather than at that core's next tick.
//
// The lock is handed over with the processor: a thread calls `switch_locked` holding it, and the thread
// that resumes is the one that releases it — after `finish_switch`, once the previous thread is no
// longer on its stack. That is what stops a second core from picking a thread off the run queue while
// it is still saving its registers, and what makes an exiting thread's stack safe to free as soon as
// it is `Dead`.
//
// Lock order: a wait queue's guard (an `IrqLock`), then `lock`. `sleep` holds the guard until it holds
// `lock`, so a waker — who needs both — cannot make the sleeper runnable before it is off the core.

import keel.cpu
import keel.gic
import keel.mm
import sysl.sync.{Atomic, Ordering, SpinLock}

const MAX_CPUS: usize = 4

// Timer ticks a thread runs before the scheduler is asked to switch (keel.timer's period each).
private const SLICE: u64 = 1

// Off only to show the boot test's interleaving check failing without preemption.
private const PREEMPTION: bool = true

// One core's record. Only that core writes `last`, `slice`, `need_resched` and `reaper`; `current` is
// written with `lock` held, so another core holding it may read which cores are idle.
//
// Each record is one 64-byte cache line, so one core's writes never take a line another core's record
// is in: `@align(64)` pads the struct to its line and strides the array by it, and the `@assert` says a
// record still fits in one.
@align(64)
struct Cpu
    id: u64
    current: *Thread
    idle: *Thread               // null until the core is up
    last: *Thread               // the thread this core switched away from, for `finish_switch`
    slice: u64                  // ticks left in `current`'s time slice
    need_resched: bool          // the slice ran out, or another core asked; switch on the way out
    reaper: Reaper              // the drain list for releases made before this core has a thread

@assert(sizeof(Cpu) == 64, "a Cpu record is one cache line")

@align(64)
private var cpus: [MAX_CPUS]Cpu

private[sched] var lock: SpinLock = SpinLock(0)
private var ready: Queue = Queue(null, null)
private var started: bool = false
private[sched] var next_id: Atomic[u64] = Atomic(0)

// The drain list for references released before any core has a `Cpu` (kmain, before `init`).
private var boot_reaper: Reaper = Reaper(null, 0)

// The running core's record. Valid once `init` or `init_secondary` has run on it.
//
// **Only with IRQs masked** (or `lock` held, which implies it): a thread preempted between reading
// TPIDR_EL1 and using the answer may resume on another core and read that core's record, and nothing
// in the language marks the window — per-core data is a pointer the program keeps, not storage the
// compiler knows is per core (FINDINGS.md 27).
private[sched] this_cpu() -> *Cpu = ptr_cast(usize(cpu.tpidr()))

// Make the code running now — kmain, on the boot stack — the boot core's first thread, give the core an
// idle thread, and start scheduling. Interrupts may already be on; the timer only asks for a switch
// once `started` is set.
init()
    val c = &cpus[usize(cpu.core_id())]
    c.id = cpu.core_id()
    c.reaper = Reaper(null, 0)

    val boot: &sync Thread = Thread(Context([0; 12], 0, 0), next_id.add(1), Running, null, None, None, None,
        empty_wait_queue(), Reaper(null, 0), 0, null, 0)
    val bp: *Thread = &*boot
    bp.me = Some(boot)

    val idle = new_thread(Some(idle_loop))

    val flags = cpu.irq_save()
    lock.lock()
    c.current = bp
    c.idle = &*idle
    c.slice = SLICE
    cpu.set_tpidr(u64(usize(c)))
    started = true
    lock.unlock()
    cpu.irq_restore(flags)

// Make the code running now — a secondary core, on the boot stack `keel.smp` gave it — that core's idle
// thread, and start scheduling there. Called with IRQs masked; TPIDR_EL1 is set before anything can
// release a reference, so the runtime's reaper hook finds this core's list from the start.
init_secondary()
    val c = &cpus[usize(cpu.core_id())]
    c.id = cpu.core_id()
    c.reaper = Reaper(null, 0)
    c.current = null
    cpu.set_tpidr(u64(usize(c)))

    val idle: &sync Thread = Thread(Context([0; 12], 0, 0), next_id.add(1), Running, null, None, None, None,
        empty_wait_queue(), Reaper(null, 0), 0, null, 0)
    val ip: *Thread = &*idle
    ip.me = Some(idle)

    lock.lock()
    c.current = ip
    c.idle = ip
    c.slice = SLICE
    lock.unlock()

// Become this core's idle thread for good. The caller is the code `init_secondary` made into one.
run_idle() -> never
    idle_loop()
    panic("keel: an idle loop returned")

// How many cores are scheduling.
cores_up() -> u64
    val flags = cpu.irq_save()
    lock.lock()
    var n: u64 = 0
    for i in 0..<MAX_CPUS
        if cpus[i].idle != null then n += 1
    lock.unlock()
    cpu.irq_restore(flags)
    n

// What a core runs when nothing is ready. Idle itself makes threads ready — `finish_switch` wakes an
// exited thread's joiners in whichever thread runs next, often this one — so it hands the core over
// whenever the run queue is not empty, and sleeps only when it is. The check and the `wfi` are made
// with IRQs masked: an interrupt arriving in between stays pending, which `wfi` wakes on, and is
// taken when IRQs are unmasked again.
private idle_loop()
    loop
        yield_now()
        val flags = cpu.irq_save()
        lock.lock()
        val nothing = ready.empty()
        lock.unlock()
        if nothing then cpu.wait_for_interrupt()
        cpu.irq_restore(flags)

// The thread calling this. IRQs are masked for the read (see `this_cpu`); the answer stays right after,
// because a thread is its own wherever it runs.
current() -> *Thread
    val flags = cpu.irq_save()
    val t = this_cpu().current
    cpu.irq_restore(flags)
    t

// Ready to run: on the run queue, and one idle core, if there is one, told so. Called with `lock` held.
private[sched] make_ready_locked(t: *Thread)
    t.state = Ready
    ready.push(t)
    if IPI then wake_an_idle_core()

// Off only to show what the reschedule interrupt is for: without it an idle core notices new work at its
// next timer tick instead of at once.
private const IPI: bool = true

// Send the reschedule interrupt to one core that is running its idle thread, other than this one.
// Called with `lock` held, which is what makes `current` safe to read on another core's record; the
// woken core takes `lock` before it looks at the run queue, so it sees the push this follows.
private wake_an_idle_core()
    val me = this_cpu()
    for i in 0..<MAX_CPUS
        val c = &cpus[i]
        if c != me && c.idle != null && c.current == c.idle
            gic.send_sgi(gic.RESCHEDULE, c.id)
            return

// Off only to show what it is for: without it a process resumed on a core keeps whatever address space
// that core last loaded, and reads another process's memory at its own addresses.
private const TTBR0_SWITCH: bool = true

// Put a thread's address space in TTBR0: a process's table and ASID, or the kernel's empty table. The
// kernel half is TTBR1's and does not change, so the code doing this keeps running; the ASID tags every
// translation, so nothing is flushed.
load_ttbr0(v: u64)
    cpu.set_ttbr0(if v == 0 then mm.kernel_ttbr0() else v)
    cpu.isb()

// The reschedule interrupt's part: switch on the way out of it, if anything is ready.
reschedule_requested()
    if !started then return
    this_cpu().need_resched = true

// Switch this core to the next ready thread. Called with `lock` held and IRQs masked; returns, with the
// lock held, when something switches back to the caller. A caller still `Running` goes to the back of
// the run queue, or simply carries on when nothing else is ready; one that is `Blocked` or `Exited`
// has already been put where it belongs.
private[sched] switch_locked()
    val c = this_cpu()
    val prev = c.current
    if prev.state == Running
        if ready.empty() then return
        if prev == c.idle then prev.state = Ready else make_ready_locked(prev)
    var next = ready.pop()
    if next == null then next = c.idle
    if next == prev
        prev.state = Running
        return
    next.state = Running
    c.current = next
    c.last = prev
    c.slice = SLICE
    c.need_resched = false
    if TTBR0_SWITCH && next.ttbr0 != prev.ttbr0 then load_ttbr0(next.ttbr0)
    switch_context(&prev.ctx, &next.ctx)
    finish_switch()

// The first thing a thread does once it has the processor back, with `lock` still held: the thread it
// took over from is now off its stack, so an exited one is dead and its joiners may run.
private[sched] finish_switch()
    val c = this_cpu()
    val prev = c.last
    c.last = null
    if prev != null && prev.state == Exited
        prev.state = Dead
        loop
            val t = prev.exit_waiters.list.pop()
            if t == null then break
            make_ready_locked(t)

// Sleep on `q` with `lock` held: woken by `finish_switch` or a `wake_*` on the same queue.
private[sched] sleep_locked(q: *WaitQueue)
    val me = this_cpu().current
    me.state = Blocked
    q.list.push(me)
    switch_locked()

// The timer interrupt's part: count down the running thread's slice.
tick()
    if !started then return
    val c = this_cpu()
    if c.slice > 0 then c.slice -= 1
    if c.slice == 0 then c.need_resched = true

// On the way out of an interrupt, with IRQs masked and the interrupted thread's registers saved on its
// stack: switch if its slice is over. The thread switched to resumes wherever it gave up the processor
// — another interrupt's return path, a `yield_now`, a `sleep`, or its start — and the interrupted one
// resumes here, later, and returns from the exception as though nothing happened.
preempt()
    if !started || !PREEMPTION then return
    val c = this_cpu()
    if !c.need_resched then return
    c.need_resched = false
    lock.lock()
    if !ready.empty() && c.current != c.idle then c.current.preemptions += 1
    switch_locked()
    lock.unlock()

// The ownership runtime asks this for the running thread's drain list whenever a release reaches zero
// (link.ld names it `__sysl_arc_reaper`, FINDINGS.md 21). Each thread needs its own: a thread preempted
// half way through draining would otherwise have its list taken over by the next.
//
// It runs with IRQs on, from any thread, so the TPIDR_EL1 read and the `current` load are made with
// IRQs masked: preempted between them, the thread could resume on another core and take that core's
// thread's list.
@export("keel_arc_reaper")
arc_reaper() -> *Reaper
    val flags = cpu.irq_save()
    val c = cpu.tpidr()
    var r: *Reaper = &boot_reaper
    if c != 0
        val p: *Cpu = ptr_cast(usize(c))
        r = if p.current == null then &p.reaper else &p.current.reaper
    cpu.irq_restore(flags)
    r
