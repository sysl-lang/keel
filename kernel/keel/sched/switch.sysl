module keel.sched

import abi.keel.abi.{FpRegs, no_fp}

// The context switch. A thread that gives up the processor does it by calling `keel_switch`, as an
// ordinary function, so all it has to keep is what a call preserves: x19 to x29, the link register and
// the stack pointer. Everything else is already saved by the caller's own code, or — for a thread
// preempted in an interrupt — by the vector code, in a `trap.Frame` on that thread's stack, below
// the call into the scheduler. The kernel's own code never uses the FP/SIMD registers
// (`codegen.general_regs_only`), so what they hold is always the user thread's; `switch_locked` saves and
// loads them with `keel_fp_save`/`keel_fp_load` below.
//
//   keel_switch(from, to)    store the callee-saved registers and SP into *from, load them from *to,
//                            and return — into whatever `to` was doing when it last called this.
//
// A thread that has never run has a `Context` made by `new_thread`: SP at the top of its stack, x30 at
// `keel_thread_start`, x19 its `Thread`. So its first switch "returns" into the start code, which calls
// `keel_thread_entry(thread)` and never comes back.
//
// The offsets (0 to 96 in steps of 16, SP at 96) are `Context`'s layout, which the `@assert`s pin.
asm
    [aarch64]
        ".globl keel_switch"
        "keel_switch:"
        "mov x9, sp"
        "stp x19, x20, [x0, #0]"
        "stp x21, x22, [x0, #16]"
        "stp x23, x24, [x0, #32]"
        "stp x25, x26, [x0, #48]"
        "stp x27, x28, [x0, #64]"
        "stp x29, x30, [x0, #80]"
        "str x9, [x0, #96]"
        "ldp x19, x20, [x1, #0]"
        "ldp x21, x22, [x1, #16]"
        "ldp x23, x24, [x1, #32]"
        "ldp x25, x26, [x1, #48]"
        "ldp x27, x28, [x1, #64]"
        "ldp x29, x30, [x1, #80]"
        "ldr x9, [x1, #96]"
        "mov sp, x9"
        "ret"
        ".globl keel_thread_start"
        "keel_thread_start:"
        "mov x0, x19"
        "bl keel_thread_entry"
        "brk #1"
    [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

extern "keel_switch" switch_context(from: *Context, to: *Context)

// The first instruction a new thread runs. Only its address is taken.
extern keel_thread_start: u8

// What `keel_switch` keeps of a thread that is not running.
struct Context
    regs: [12]u64               // x19 .. x30
    sp: u64
    pad: u64                    // keeps the struct a multiple of 16 bytes

@assert(sizeof(Context) == 112, "keel_switch saves 13 words")
@assert(offsetof(Context, regs) == 0, "keel_switch saves x19 at the context's base")
@assert(offsetof(Context, sp) == 96, "keel_switch saves SP at 96")

// Where in `regs` the start code finds its argument (x19) and where the first switch returns to (x30).
private const ARG_REG: usize = 0
private const LINK_REG: usize = 11

// The FP/SIMD registers of the thread on this core, to and from memory: the only kernel code that
// touches them. q0-q31, FPSR and FPCR, laid out as keel.abi's `FpRegs` (16-aligned, so `stp`/`ldp` of
// q registers never straddle). Each clobbers x1 and nothing else a call does not already.
//
//   keel_fp_save(to)      store this core's FP/SIMD registers into *to
//   keel_fp_load(from)    load them from *from
asm
    [aarch64]
        ".arch_extension fp"
        ".arch_extension simd"
        ".globl keel_fp_save"
        "keel_fp_save:"
        "stp q0, q1, [x0, #0]"
        "stp q2, q3, [x0, #32]"
        "stp q4, q5, [x0, #64]"
        "stp q6, q7, [x0, #96]"
        "stp q8, q9, [x0, #128]"
        "stp q10, q11, [x0, #160]"
        "stp q12, q13, [x0, #192]"
        "stp q14, q15, [x0, #224]"
        "stp q16, q17, [x0, #256]"
        "stp q18, q19, [x0, #288]"
        "stp q20, q21, [x0, #320]"
        "stp q22, q23, [x0, #352]"
        "stp q24, q25, [x0, #384]"
        "stp q26, q27, [x0, #416]"
        "stp q28, q29, [x0, #448]"
        "stp q30, q31, [x0, #480]"
        "mrs x1, fpsr"
        "str w1, [x0, #512]"
        "mrs x1, fpcr"
        "str w1, [x0, #516]"
        "ret"
        ".globl keel_fp_load"
        "keel_fp_load:"
        "ldp q0, q1, [x0, #0]"
        "ldp q2, q3, [x0, #32]"
        "ldp q4, q5, [x0, #64]"
        "ldp q6, q7, [x0, #96]"
        "ldp q8, q9, [x0, #128]"
        "ldp q10, q11, [x0, #160]"
        "ldp q12, q13, [x0, #192]"
        "ldp q14, q15, [x0, #224]"
        "ldp q16, q17, [x0, #256]"
        "ldp q18, q19, [x0, #288]"
        "ldp q20, q21, [x0, #320]"
        "ldp q22, q23, [x0, #352]"
        "ldp q24, q25, [x0, #384]"
        "ldp q26, q27, [x0, #416]"
        "ldp q28, q29, [x0, #448]"
        "ldp q30, q31, [x0, #480]"
        "ldr w1, [x0, #512]"
        "msr fpsr, x1"
        "ldr w1, [x0, #516]"
        "msr fpcr, x1"
        "ret"
    [x86_64, thumb, riscv64, riscv32, craft, wasm32] unavailable "keel runs on aarch64 only"

@assert(sizeof(FpRegs) == 528, "keel_fp_save stores 32 q registers from 0 and FPSR, FPCR at 512, 516")
@assert(offsetof(FpRegs, fpcr) == 516, "keel_fp_save stores FPCR at 516")
@assert(alignof(FpRegs) == 16, "keel_fp_save's q stores want 16-byte alignment")

extern "keel_fp_save" save_fp(to: *FpRegs)
extern "keel_fp_load" load_fp(from: *FpRegs)

// The calling thread's FP/SIMD registers as they are now (it is a user thread in a system call: they
// are its user mode's).
current_fp() -> FpRegs
    var f = no_fp()
    save_fp(&f)
    f

// A context whose first switch enters `keel_thread_start` on `stack_top` with `arg` in x19.
private[sched] fresh_context(stack_top: u64, arg: u64) -> Context
    var c = Context([0; 12], stack_top, 0)
    c.regs[ARG_REG] = arg
    c.regs[LINK_REG] = u64(usize(&keel_thread_start))
    c
