module keel.dtb

// Just enough of the flattened device tree to find RAM: the blob's size, and the `reg` property of the
// `/memory` node. QEMU hands the boot processor the blob's physical address in x0, as Linux's arm64
// boot protocol does, and also puts it at the start of RAM for a bare-metal image.
//
// The format (devicetree.org specification, chapter 5): a 40-byte header of big-endian u32s, then a
// structure block of 4-byte tokens. BEGIN_NODE is followed by the node's name, NUL-terminated and
// padded to 4 bytes; PROP by its length, the offset of its name in the strings block, and its value,
// padded to 4. A `reg` is (#address-cells + #size-cells) big-endian u32s per range, with the cell
// counts taken from the parent node -- the root, for `/memory`.

import sysl.encoding.get_u32_be

private const MAGIC: u32 = 0xd00d_feed

private const BEGIN_NODE: u32 = 1
private const END_NODE: u32 = 2
private const PROP: u32 = 3
private const NOP: u32 = 4
private const END: u32 = 9

// What keel takes from the tree.
struct Ram
    base: u64
    size: u64

// The blob's total size in bytes, or None if there is no device tree at `blob`.
total_size(blob: *u8) -> Option[u64]
    val head: []const u8 = blob[0..<40]
    if u32_at(head, 0) != MAGIC then return None
    Some(u64(u32_at(head, 4)))

// The first range of the `/memory` node, or None if the blob has none (or is not a device tree).
ram(blob: *u8) -> Option[Ram]
    val size = total_size(blob) match
        Some(n) -> n
        None -> return None
    val b: []const u8 = blob[0..<usize(size)]
    val strings = usize(u32_at(b, 12))

    var at = usize(u32_at(b, 8))
    var depth = 0
    var in_memory = false
    var address_cells: u32 = 2
    var size_cells: u32 = 1

    loop
        val token = u32_at(b, at)
        at += 4
        if token == BEGIN_NODE
            depth += 1
            in_memory = depth == 2 && (name_is(b, at, "memory") || prefix_is(b, at, "memory@"))
            at = align4(at + c_len(b, at) + 1)
        else if token == END_NODE
            depth -= 1
            in_memory = false
        else if token == PROP
            val len = usize(u32_at(b, at))
            val name = strings + usize(u32_at(b, at + 4))
            at += 8
            if depth == 1 && name_is(b, name, "#address-cells") then address_cells = u32_at(b, at)
            if depth == 1 && name_is(b, name, "#size-cells") then size_cells = u32_at(b, at)
            if in_memory && name_is(b, name, "reg")
                val base = cells(b, at, address_cells)
                val bytes = cells(b, at + 4 * usize(address_cells), size_cells)
                return Some(Ram(base, bytes))
            at = align4(at + len)
        else if token == NOP
            ()
        else
            return None   // END, or something this reader does not know

// A number written as one or two big-endian cells.
private cells(b: []const u8, at: usize, n: u32) -> u64 =
    if n == 2 then u64(u32_at(b, at)) << 32 | u64(u32_at(b, at + 4)) else u64(u32_at(b, at))

private u32_at(b: []const u8, at: usize) -> u32 = get_u32_be(b[at..<at + 4]).unwrap()

private align4(n: usize) -> usize = (n + 3) & ~usize(3)

// The length of the NUL-terminated string at `at`.
private c_len(b: []const u8, at: usize) -> usize
    var n: usize = 0
    while b[at + n] != 0
        n += 1
    n

// Whether the NUL-terminated string at `at` is exactly `s`, or begins with it.
private name_is(b: []const u8, at: usize, s: string) -> bool = prefix_is(b, at, s) && b[at + s.len] == 0

private prefix_is(b: []const u8, at: usize, s: string) -> bool
    for i in 0..<s.len
        if b[at + i] != s.bytes[i] then return false
    true
