module keel.selftest

// What milestone 8 is for: a filesystem on the virtio disk, built on the host by tools/mkfs, used by
// programs through system calls, and still there on the next boot. scripts/boot-test.sh boots twice on
// one image; the `files` program prints its own lines, and says on the second boot that it found what
// the first one wrote.

import keel.fs
import keel.proc
import keel.sched
import keel.sched.Process
import sysl.buf.{Buf, buf}

// The filesystem is mounted before any process runs: every program is read from its /bin. Answers
// whether it was.
mount() -> bool
    val blocks = fs.mount() match
        Ok(n) -> n
        Err(e) ->
            print("keel: no filesystem on the disk, errno", i64(e))
            return false
    print("keel: fs mounted,", blocks, "blocks")
    true

files()
    fs_smp()
    proc.start("/bin/files") match
        Ok(p) ->
            proc.wait(p)
            if !proc.exited(p) || proc.exit_code(p) != 0 then print("keel: files", outcome(p))
        Err(_) -> print("keel: files did not load")
    utilities()

// Milestone 9: programs written with the standard library's `sysl.fs`, which keel.fsys answers with
// the system calls. `cp` copies a small file and a multi-block one (scripts/boot-test.sh also compares
// the big copy with its source on the host); `cmp` checks each copy; a missing source makes `cp` say
// sysl.fs's error and exit 1; `ls` and `cat` print what the script expects; `fscheck` goes through the
// rest of sysl.fs.
private utilities()
    if copied("/hello.txt", "/m9/copy.txt") then print("keel: cp ok")
    if copied("/m9/big.bin", "/m9/big.copy") then print("keel: cp big ok")
    val refused = exit_of(["cp", "/missing.txt", "/m9/nowhere.txt"])
    if refused == 1 && exit_of(["cmp", "/missing.txt", "/m9/nowhere.txt"]) == 2
        print("keel: cp missing ok")
    if exit_of(["ls", "/"]) == 0 then print("keel: ls ok")
    if exit_of(["cat", "/dir/inner.txt"]) == 0 then print("keel: cat ok")
    val _ = exit_of(["fscheck"])

// `cp from to`, then `cmp from to`: both exited 0.
private copied(from: string, to: string) -> bool =
    exit_of(["cp", from, to]) == 0 && exit_of(["cmp", from, to]) == 0

// Run /bin/<args[0]> with `args` and wait for it: its exit code, or -1 (said) if it did not exit by
// itself.
private exit_of(args: []const string) -> i64
    proc.start_with(s"/bin/${args[0]}", args) match
        Ok(p) ->
            proc.wait(p)
            if proc.exited(p) then return proc.exit_code(p)
            print(s"keel: ${args[0]}", outcome(p))
            -1
        Err(_) ->
            print(s"keel: ${args[0]} did not load")
            -1

// The write-back kmain asks for before it powers off: every block still dirty in the cache goes to the
// disk, which is all that makes what the programs wrote survive the reboot.
fs_shutdown()
    val (_, before) = fs.stats()
    fs.sync() match
        Ok(_) ->
            val (_, after) = fs.stats()
            print("keel: fs synced at shutdown,", after - before, "blocks written")
        Err(e) -> print("keel: fs sync failed, errno", i64(e))

// One `fsload` per core, all at once: each writes, reads back, removes a file of its own and syncs.
// The filesystem's one lock is what keeps them apart.
private fs_smp()
    val loads: Buf[&sync Process] = buf()
    for _ in 0..<sched.cores_up()
        proc.start("/bin/fsload") match
            Ok(p) -> loads.push(p)
            Err(_) -> print("keel: fsload did not load")
    var good: u64 = 0
    for p in loads
        proc.wait(p)
        if proc.exited(p) && proc.exit_code(p) == 0 then good += 1 else print("keel: fsload", outcome(p))
    val (reads, writes) = fs.stats()
    if good == u64(loads.len()) && good >= 2
        print("keel: fs smp ok:", good, "processes; disk blocks read", reads, "written", writes)
    else
        print("keel: fs smp wrong:", good, "of", loads.len(), "processes passed")

private outcome(p: &sync Process) -> string =
    if proc.exited(p) then s"process ${proc.pid(p)} exited ${proc.exit_code(p)}"
    else s"process ${proc.pid(p)} killed: ${proc.why(p)}"
