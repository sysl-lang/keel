module keel.selftest

// What milestone 11 is for: the virtio network card the boot test attaches to QEMU's user-mode network
// (slirp), with host UDP port KEEL_UDP_PORT forwarded to keel's port 7. keel pings the gateway (slirp
// answers ICMP echo for 10.0.2.2; a ping from the host cannot reach the guest through slirp), then
// serves UDP echo on port 7 while the script's client, on the host, sends datagrams to the forwarded
// port and checks each comes back. The client ends by sending "bye", which is what this waits for.

import keel.net
import keel.proc

private const PING_TIMEOUT_MS: u64 = 3000
private const ECHO_TIMEOUT_MS: u64 = 10000

// Bring the network up and run the kernel's half of the test. Answers whether the network is up, for
// the user-mode half that follows.
network() -> bool
    val mac = net.up() match
        Some(m) -> m
        None ->
            print("keel: no virtio-net card")
            return false
    print("keel: virtio-net found, mac", net.mac_text(mac))

    net.ping(net.gateway(), PING_TIMEOUT_MS) match
        Some(_) -> print("keel: ping gateway ok")
        None -> print("keel: ping gateway failed")

    val (bye, echoed) = net.echo_wait(ECHO_TIMEOUT_MS)
    if bye
        print("keel: udp echo served", echoed)
    else
        print("keel: udp echo saw no bye; echoed", echoed)

    // The same service from EL0: /bin/udpecho on USER_ECHO_PORT through the socket calls, which the
    // client reaches through the second forwarded port.
    proc.start_with("/bin/udpecho", ["udpecho", USER_ECHO_PORT, USER_ECHO_SECONDS]) match
        Ok(p) ->
            proc.wait(p)
            if proc.exited(p)
                print("keel: udpecho exited", proc.exit_code(p))
            else
                print("keel: udpecho", proc.why(p))
        Err(_) -> print("keel: udpecho did not load")

    // TCP's fast retransmit resends no more than was sent (keel.net's `tcp_resend_check`).
    val (carried, sent) = net.tcp_resend_check()
    if carried == sent && sent > 0
        print("keel: tcp fast retransmit resent", carried, "bytes, only what was sent")
    else
        print("keel: tcp fast retransmit resent", carried, "bytes where", sent, "were sent")
    true

private const USER_ECHO_PORT: string = "8007"
private const USER_ECHO_SECONDS: string = "10"

// After the session: stop the stack's thread, drop what TCP still holds (connections in TIME_WAIT, say),
// and report what it saw. Every process has ended by now, so no descriptor stands for any socket.
network_down()
    val s = net.stats()
    val streams = net.tcp_sockets_held()
    net.down()
    if net.sockets_open() == 0 && streams == 0
        print("keel: network down, sockets closed")
    else
        print("keel: network down,", net.sockets_open(), "datagram and", streams, "stream sockets left open")
    val t = net.tcp_table()
    if t.live == 0 && t.time_wait == 0 && t.frames == 0
        print("keel: tcp table empty, every ring's frames back")
    else
        print("keel: tcp table not empty:", t.live, "live", t.time_wait, "in TIME_WAIT", t.frames, "frames")
    if s.bad_ip_checksums != 0 || s.bad_udp_checksums != 0
        print("keel: bad checksums received: ip", s.bad_ip_checksums, "udp", s.bad_udp_checksums)
