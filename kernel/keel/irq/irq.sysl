module keel.irq

// What an IRQ does once the vector code has saved the interrupted registers: ask the GIC which
// interrupt it is, handle it, and tell the GIC it is done.

import keel.console
import keel.gic
import keel.net
import keel.sched
import keel.timer
import keel.virtio
import keel.pl011.{put_hex, put_str}
import sysl.sync.{Atomic, Ordering}

// Timer interrupts taken since boot, on every core (each core's timer ticks every 10 ms, so with four
// cores up this counts 400 a second). Every core's IRQ handler adds to it and threads read it, so it
// is an atomic: every load is a real load, and no two adds lose one. An exclusive load/store pair needs Normal memory, which is why
// this waited for the MMU (FINDINGS.md 6).
var ticks: Atomic[u64] = Atomic(0)

dispatch()
    val id = gic.acknowledge()
    if id == gic.SPURIOUS then return

    if id == timer.IRQ
        timer.rearm()
        ticks.add(1, Ordering.Relaxed)
        net.net_tick()
        sched.tick()
    else if id == gic.RESCHEDULE
        sched.reschedule_requested()
    else if id == virtio.irq()
        virtio.interrupt()
    else if id == net.nic_irq()
        net.nic_interrupt()
    else if id == console.irq()
        console.interrupt()
    else
        put_str("keel: unexpected interrupt ")
        put_hex(u64(id))
        put_str("\n")

    gic.complete(id)
